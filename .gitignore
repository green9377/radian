!.env.example
!.env.*.example

node_modules/
.next/
dist/
*.tsbuildinfo

# database backups — real customer data, and far too big for git
backups/
*.dump

# the .bat files' scratch output (_build.log, _api_log.txt, _migrate_out.txt …).
# এগুলো প্রতিবার চালালেই নতুন করে লেখা হয় — git-এ রাখলে প্রতিটা commit-এ
# অর্থহীন পরিবর্তন দেখাবে, আর log-এ কখনো connection string ছাপা হলে সেটাও
# চিরকালের জন্য history-তে থেকে যেত।
_*.log
_*.txt

