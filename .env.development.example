# ======================================================================
#  DEVELOPMENT - the system we build and break things on
# ======================================================================
#
#  Lives at /root/apps/radian on the VPS, branch `main`.
#  This file replaces the old `.env.production`, which was named for a shop
#  that did not exist yet and had become the most confusing name here.
#
#    docker compose -f docker-compose.stack.yml --env-file .env.development up -d --build
#
#  ⛔ .env.development never goes into git.
#
#  ⚠️ Not a demo. Real orders are placed here and real books are kept; only
#     the gateway key is sandbox (CLAUDE.md §4 rule 10).
# ======================================================================


# ----------------------------------------------------------------------
#  Which stack this is
# ----------------------------------------------------------------------
STACK=dev
ENV_FILE=.env.development

# ⚠️ THE EXISTING DATABASE. Check the real name before switching:
#      docker volume ls | grep pg
#  Anything else here starts an EMPTY database that looks exactly like
#  losing everything.
PG_VOLUME=radian_radian_pg_prod

# Two of the box's four cores. This is what stops a rebuild or a load test
# here from starving a customer's checkout on the live shop.
CPU_LIMIT=2


# ----------------------------------------------------------------------
#  Database - keep the values the running stack already uses
# ----------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://<user>:<password>@postgres:5432/<db>
DIRECT_URL=postgresql://<user>:<password>@postgres:5432/<db>


# ----------------------------------------------------------------------
#  API
# ----------------------------------------------------------------------
NODE_ENV=production
JWT_SECRET=
JWT_REFRESH_EXPIRY_DAYS=30
API_INTERNAL_URL=http://api:4000
ANTHROPIC_API_KEY=


# ----------------------------------------------------------------------
#  Domains
# ----------------------------------------------------------------------
WEB_DOMAIN=development.radianbd.com
ADMIN_DOMAIN=admin.development.radianbd.com
API_DOMAIN=api.development.radianbd.com
MEDIA_DOMAIN=media.development.radianbd.com

PUBLIC_WEB_URL=https://development.radianbd.com
PUBLIC_ADMIN_URL=https://admin.development.radianbd.com
PUBLIC_API_URL=https://api.development.radianbd.com


# ----------------------------------------------------------------------
#  Images
# ----------------------------------------------------------------------
MEDIA_DIR=/media
NEXT_PUBLIC_IMAGE_BASE=https://media.development.radianbd.com


# ----------------------------------------------------------------------
#  Payment - sandbox here, always
# ----------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_LIVE=false


# ----------------------------------------------------------------------
#  WhatsApp / Email
# ----------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=
META_APP_ID=
META_ES_CONFIG_ID=

# ----------------------------------------------------------------------
#  Outbound guard - who a DEVELOPMENT build may actually message
#
#  Development is not a sandbox here: it holds the real SMS gateway, real
#  WhatsApp credentials and real customers' phone numbers. The guard does not
#  switch messaging off - it says WHO it may reach, so a test can send a real
#  SMS to a real handset without a stray loop reaching thirty customers.
#
#  Checked at the three doors themselves (common/outbound-guard.ts):
#  WhatsApp Cloud, Messenger + Instagram, and SMS + email.
# ----------------------------------------------------------------------

# Everything stops at once. No deploy needed - there is a button in the admin
# too (POST /administration/outbound/stop).
OUTBOUND_DISABLED=false

# Comma separated. ONLY these are reachable from this stack. Numbers may be
# written 01712345678, 8801712345678 or +8801712345678 - all the same person.
#
# ⚠️ LEAVING THIS EMPTY BLOCKS EVERYTHING on this stack, on purpose. Only a
# stack that says STACK=live treats an empty list as "everyone". A forgotten
# variable must fail towards silence, never towards thirty real customers.
OUTBOUND_ALLOWLIST=

# A runaway loop cannot cost more than this many messages an hour. 0 or unset
# means unlimited.
OUTBOUND_MAX_PER_HOUR=20

# Optional catch-all: send every SMS/WhatsApp to this one number instead of
# blocking it, with the real flow otherwise untouched. Leave empty to use the
# allowlist alone.
OUTBOUND_REDIRECT_TO=


# ----------------------------------------------------------------------
#  Order numbers carry the environment
#
#  Both stacks can use the SAME SSLCommerz merchant account, and the gateway's
#  transaction id is built from the order number. Without this, a settlement
#  report holds RAD-73412 from the live shop and RAD-73412 from development
#  and nobody can tell them apart. Unset means RAD.
# ----------------------------------------------------------------------
ORDER_NO_PREFIX=DEV

# ⛔ Do not set PORT.
