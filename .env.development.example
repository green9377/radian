# ======================================================================
#  DEVELOPMENT - the system we build and break things on
# ======================================================================
#
#  Lives at /root/apps/radian on the VPS, branch `main`.
#  This file replaces the old `.env.production`, which was named for a shop
#  that did not exist yet and had become the most confusing name here.
#
#    docker compose -f docker-compose.stack.yml --env-file .env.development up -d --build
#
#  ⛔ .env.development never goes into git.
#
#  ⚠️ Not a demo. Real orders are placed here and real books are kept; only
#     the gateway key is sandbox (CLAUDE.md §4 rule 10).
# ======================================================================


# ----------------------------------------------------------------------
#  Which stack this is
# ----------------------------------------------------------------------
STACK=dev
ENV_FILE=.env.development

# ⚠️ THE EXISTING DATABASE. Check the real name before switching:
#      docker volume ls | grep pg
#  Anything else here starts an EMPTY database that looks exactly like
#  losing everything.
PG_VOLUME=radian_radian_pg_prod

# Two of the box's four cores. This is what stops a rebuild or a load test
# here from starving a customer's checkout on the live shop.
CPU_LIMIT=2


# ----------------------------------------------------------------------
#  Database - keep the values the running stack already uses
# ----------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://<user>:<password>@postgres:5432/<db>
DIRECT_URL=postgresql://<user>:<password>@postgres:5432/<db>


# ----------------------------------------------------------------------
#  API
# ----------------------------------------------------------------------
NODE_ENV=production
JWT_SECRET=
JWT_REFRESH_EXPIRY_DAYS=30
API_INTERNAL_URL=http://api:4000
ANTHROPIC_API_KEY=


# ----------------------------------------------------------------------
#  Domains
# ----------------------------------------------------------------------
WEB_DOMAIN=development.radianbd.com
ADMIN_DOMAIN=admin.development.radianbd.com
API_DOMAIN=api.development.radianbd.com
MEDIA_DOMAIN=media.development.radianbd.com

PUBLIC_WEB_URL=https://development.radianbd.com
PUBLIC_ADMIN_URL=https://admin.development.radianbd.com
PUBLIC_API_URL=https://api.development.radianbd.com


# ----------------------------------------------------------------------
#  Images
# ----------------------------------------------------------------------
MEDIA_DIR=/media
NEXT_PUBLIC_IMAGE_BASE=https://media.development.radianbd.com


# ----------------------------------------------------------------------
#  Payment - sandbox here, always
# ----------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_LIVE=false


# ----------------------------------------------------------------------
#  WhatsApp / Email
# ----------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=
META_APP_ID=
META_ES_CONFIG_ID=

# ⛔ Do not set PORT.
