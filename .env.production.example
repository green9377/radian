# ======================================================================
#  REAL BUSINESS environment — একটা VPS, docker-compose.prod.yml
# ======================================================================
#
#  ব্যবহার:  cp .env.production.example .env.production   (VPS-এ)
#            তারপর মান বসিয়ে —
#            docker compose -f docker-compose.prod.yml \
#              --env-file .env.production up -d --build
#
#  ⛔ `.env.production` কখনো git-এ যাবে না (.gitignore-এ আটকানো আছে)।
#     এই `.example` ফাইলে শুধু placeholder থাকবে, কোনোদিন আসল মান নয়।
#
#  ⚠️ এটা demo-র থেকে **সম্পূর্ণ আলাদা জগৎ**। DB আলাদা, secret আলাদা,
#     payment key আলাদা। কোনো মান demo থেকে কপি করবেন না।
# ======================================================================


# ----------------------------------------------------------------------
#  ডেটাবেজ (compose নিজেই container বানায়)
# ----------------------------------------------------------------------
POSTGRES_USER=radian_prod
POSTGRES_PASSWORD=<.env.secrets.local → PROD_POSTGRES_PASSWORD>
POSTGRES_DB=radian_prod

# API container ভেতরের network দিয়ে DB-তে যায় — host-এর নাম `postgres`,
# port ৫৪৩২। এটা বাইরের ইন্টারনেট থেকে পৌঁছানো যায় না, এবং যাওয়া উচিতও নয়।
DATABASE_URL=postgresql://radian_prod:<একই পাসওয়ার্ড>@postgres:5432/radian_prod


# ----------------------------------------------------------------------
#  API
# ----------------------------------------------------------------------
NODE_ENV=production
# `.env.secrets.local` → PROD_JWT_SECRET। demo-রটা নয়।
JWT_SECRET=<.env.secrets.local দেখুন>
JWT_REFRESH_EXPIRY_DAYS=30

# web container server-side render করার সময় ভেতর দিয়ে API-তে যায়
API_INTERNAL_URL=http://api:4000


# ----------------------------------------------------------------------
#  ডোমেইন (Caddyfile এই তিনটে পড়ে, HTTPS নিজে এনে দেয়)
#  তিনটার A record-ই VPS-এর IP-তে থাকতে হবে, নইলে সার্টিফিকেট আসবে না।
# ----------------------------------------------------------------------
WEB_DOMAIN=radian.com.bd
ADMIN_DOMAIN=admin.radian.com.bd
API_DOMAIN=api.radian.com.bd

PUBLIC_WEB_URL=https://radian.com.bd
PUBLIC_ADMIN_URL=https://admin.radian.com.bd
PUBLIC_API_URL=https://api.radian.com.bd


# ----------------------------------------------------------------------
#  ছবি
# ----------------------------------------------------------------------
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGE_BASE=https://ik.imagekit.io/your_id


# ----------------------------------------------------------------------
#  পেমেন্ট — এখানেই আসল টাকা
# ----------------------------------------------------------------------
#  ⚠️ SSLCOMMERZ_IS_LIVE=true করার আগে STORE_ID আর PASSWORD দুটোই আসল
#     merchant account-এর হতে হবে। ফাঁকা রেখে true দিলে API চালু হতেই
#     অস্বীকার করবে — ইচ্ছাকৃত। একটা চালু দোকান চুপচাপ নকল টাকা নেওয়ার
#     চেয়ে টাকাই না নিতে পারা ভালো।
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false


# ----------------------------------------------------------------------
#  WhatsApp / Email
# ----------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=

# ⛔ PORT দেবেন না।
