# ==============================
# DATABASE
# ==============================
DATABASE_URL=postgresql://radian_user:radian_pass@postgres:5432/radian_db

# ==============================
# BACKEND (NestJS)
# ==============================
PORT=4000
JWT_SECRET=change_this_secret
JWT_REFRESH_EXPIRY_DAYS=30

# ==============================
# FRONTEND (Next.js)
# ==============================
NEXT_PUBLIC_API_URL=http://localhost:4000
# how the web CONTAINER reaches the API (server-rendered pages). Unset outside
# Docker — see the note in .env
API_INTERNAL_URL=http://api:4000

# ==============================
# WHATSAPP OTP (Meta Cloud API)
# ==============================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ==============================
# IMAGEKIT (Images)
# ==============================
# From the ImageKit dashboard → Settings → API keys.
# IMAGEKIT_PRIVATE_KEY is server-only — never give it a NEXT_PUBLIC_ prefix.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGE_BASE=https://ik.imagekit.io/your_id

# ==============================
# RESEND (Email)
# ==============================
RESEND_API_KEY=

# ==============================
# SSLCOMMERZ (Payment)
# ==============================
# Leave BLANK to run on SSLCommerz's public sandbox pair (testbox/qwerty) —
# real gateway, fake money, which is what "demo হিসাবে থাকুক" means. On the day
# the live merchant account arrives, fill these two in and flip IS_LIVE.
#
# ⚠️ SSLCOMMERZ_IS_LIVE=true with these blank is a hard refusal, not a silent
# fallback to sandbox: a live shop quietly taking play money is worse than a
# live shop that cannot take money at all.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Where SSLCommerz sends the customer BACK. These must be addresses SSLCommerz
# can reach from the internet — `localhost` works for the sandbox only because
# the redirect happens in the customer's own browser; the IPN (server-to-server)
# will NOT arrive on localhost. Use an ngrok/tunnel URL to test the IPN.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
