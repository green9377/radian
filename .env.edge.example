# ======================================================================
#  EDGE - Caddy's own settings. Domains and the two media folders.
# ======================================================================
#
#  Lives at /root/apps/radian/.env.edge on the VPS.
#
#    docker compose -f docker-compose.edge.yml --env-file .env.edge up -d
#
#  Every domain below needs an A record at the VPS, DNS-only (grey cloud).
#  A proxied record stops Let's Encrypt from issuing a certificate.
# ======================================================================

DEV_WEB_DOMAIN=development.radianbd.com
DEV_ADMIN_DOMAIN=admin.development.radianbd.com
DEV_API_DOMAIN=api.development.radianbd.com
DEV_MEDIA_DOMAIN=media.development.radianbd.com

LIVE_WEB_DOMAIN=live.radianbd.com
LIVE_ADMIN_DOMAIN=admin.live.radianbd.com
LIVE_API_DOMAIN=api.live.radianbd.com
LIVE_MEDIA_DOMAIN=media.live.radianbd.com

# Absolute paths - the two folders belong to two different clones, so a
# relative path would only ever find one of them.
DEV_MEDIA_DIR=/root/apps/radian/media
LIVE_MEDIA_DIR=/root/apps/radian-live/media
