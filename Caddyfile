# Radian — Caddy reverse proxy (docker-compose.prod.yml-এর সাথে)。
#
# Caddy কী করে: বাইরের সব request নেয়, HTTPS সার্টিফিকেট নিজে Let's Encrypt
# থেকে এনে নিজেই নবায়ন করে, তারপর ভেতরের সঠিক container-এ পাঠায়。
# Nginx + Certbot-এর কাজটা তিন লাইনে。
#
# ডোমেইনের নাম .env.production থেকে আসে (WEB_DOMAIN / ADMIN_DOMAIN / API_DOMAIN)。
# DNS-এ তিনটার A record-ই VPS-এর IP-তে থাকতে হবে, নইলে সার্টিফিকেট আসবে না。

{$WEB_DOMAIN} {
	encode gzip
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN} {
	encode gzip
	reverse_proxy admin:3001

	# admin-এ আসল login আছে (AuthGate + API-র global AuthGuard)。 তবু
	# search engine যেন ভুলেও ঢুকতে না পারে。
	header X-Robots-Tag "noindex, nofollow"
}

{$API_DOMAIN} {
	encode gzip
	reverse_proxy api:4000

	header X-Robots-Tag "noindex, nofollow"
}

# Images (29 Aug 2026) — served straight from disk, no container in the way.
# The folder is ./media on the VPS, written by the API (media.ts, MEDIA_DIR)
# and mounted here read-only. Filenames are unique per upload and never
# reused, so a one-year immutable cache header is safe and is what makes
# repeat visits fast. nosniff keeps uploaded SVGs inert (media.ts explains).
{$MEDIA_DOMAIN} {
	root * /srv/media
	file_server
	header Cache-Control "public, max-age=31536000, immutable"
	header X-Content-Type-Options "nosniff"
}
