// Radian Business OS — Prisma schema
// Stack (locked): PostgreSQL + Prisma 6.x
//
// Build order (locked build_sequence): Product → Customer → Sales।
// এই ফাইলে এখন Foundation + Product module। Customer/Sales পরের ধাপে যোগ হবে।
//
// প্রতিটি business model-এ constitution-বাধ্যতামূলক field:
//   id        String   @id @default(cuid())
//   createdAt DateTime @default(now())
//   updatedAt DateTime @updatedAt
//   deletedAt DateTime?          // soft-delete only — কখনো hard delete নয়
//
// DEC tag নোট: নিচের DEC-PRD-NNN আইডিগুলো provisional — code↔decision traceability-র
// জন্য বসানো। এগুলো architecture project-এর Decision Log-এ formally register করতে হবে
// (radian-development-context skill: "mandatory sync rule")। DEC-MOD-003 = আসল locked id.

generator client {
  provider      = "prisma-client-js"
  // native = Windows host dev; linux-musl-openssl-3.0.x = node:20-alpine container
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// FOUNDATION — cross-cutting (Product/Customer/Sales সবাই share করে)
// One Data One Owner-এর technical base। এই দুটো log append-only:
// soft-delete extension এদের বাদ দেয় (denylist), তাই deletedAt নেই।
// ============================================================

/// মেশিন-audit: কে, কখন, কোন field কী→কী বদলাল (field-level)।
/// polymorphic (entityType+entityId) — সব module এক table share করে।
model AuditLog {
  id         String      @id @default(cuid())
  entityType String // "Product" | "Customer" | "Order" ...
  entityId   String
  action     AuditAction
  actorId    String? // Employee.id (পরে); এখন staff-এর নাম actorName-এ
  actorName  String
  changes    Json? // { field: { from, to } }
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  /// দেখা হয়েছে, বদলানো হয়নি। ৬ আগস্ট ২০২৬ — Integrations-এ সংরক্ষিত চাবি
  /// পুরোটা দেখার সুযোগ দেওয়া হলো (মালিকের সিদ্ধান্ত)। কে কখন কোন চাবি
  /// দেখল সেটাও ইতিহাসে থাকা দরকার। UPDATE দিয়ে চালালে খাতায় "কী বদলাল"
  /// কলামটা চিরকাল ফাঁকা থাকত — তখন ওই সারিগুলোর মানে কেউ বুঝত না।
  READ
}

/// মানুষের পড়ার timeline/activity feed — orders.ts-এর `timeline` এখান থেকে আসবে।
/// Unified Timeline (core principle) — Product/Customer/Order প্রতিটার নিজস্ব feed।
model ActivityEvent {
  id         String       @id @default(cuid())
  entityType String
  entityId   String
  kind       ActivityKind
  label      String
  actorName  String
  note       String?
  createdAt  DateTime     @default(now())

  @@index([entityType, entityId])
}

enum ActivityKind {
  sales
  delivery
  payment
  system
  general
}

// ============================================================
// PRODUCT MODULE — master data + sellable Product
// Source: RADIAN_ADMIN_PROGRESS.md §2 (locked Product decisions)
// ============================================================

/// admin-configurable category, ২ স্তর — parent (flowers) → child (roses)।
/// "সবকিছু admin-configurable" — তাই enum নয়, table (DEC-PRD-001)।
model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  parentId  String? // null = top-level; সেট থাকলে sub-category
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  description     String?  @db.Text
  summary         String?
  imageUrl        String?
  iconUrl         String?
  bannerUrl       String?
  /// The big line on the category page — "Send a little get-well warmth".
  ///
  /// Added 31 Jul 2026, when the owner asked where that sentence is typed and
  /// the honest answer was "nowhere". The page was using `metaTitle`, which is
  /// the line written for Google, and falling back to `name`. Neither is right:
  /// the category is called "Fresh flowers" in every menu on the site, and the
  /// banner wants a sentence that sells. One is a label, the other is copy.
  ///
  /// Blank falls back to `name`, so nothing is ever empty.
  bannerHeading   String?
  metaTitle       String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?
  noIndex         Boolean  @default(false) // SEO-D01 — same escape hatch as Product
  showOnNavbar    Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  /// the heading above the size chooser on a product page — "Bouquet Size",
  /// "Weight", "Box Size". Category-level because it is a property of the KIND
  /// of thing being sold, not of one bouquet: every product under Cakes wants
  /// "Weight" and none of them wants a different word for it. Blank falls back
  /// to a plain "Size".
  sizeLabel String?

  /// এই category-র বানানো জিনিস কোন দলের সময় খায়। Product-এ আলাদা করে
  /// জিজ্ঞেস করা হয় না — সে শুধু দেখায় কোন দলে পড়ছে (মালিক, 1 Aug 2026)।
  capacityGroupId String?
  capacityGroup   CapacityGroup? @relation(fields: [capacityGroupId], references: [id])

  products  Product[]
  faqs      CategoryFaq[] // D-CAT-03 — this category's own questions
  bundles   Bundle[] // the "+ Chocolates" cards every product here offers
  craft     CraftPoint[] // the three "why us" cards, inherited by its products
  /// DEC-PRD-023 — এই category-র product page-এ যে trust badge আর
  /// "What's inside" সারি দেখাবে। একবার লেখা, সব product পায়।
  trustBadges CategoryTrustBadge[]
  specRows    CategorySpec[]
  offers    Offer[] // DEC-OFR — CATEGORY-shape offers reference (never own) this
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([parentId])
}

/// ═══════════════════════════════════════════════════════════════════════════
/// CATEGORY TRUST BADGE — product page-এর তিনটে প্রতিশ্রুতি, একবার লেখা
///
/// মালিক, ২ আগস্ট ২০২৬:
/// > *"trust badges, what's inside, faq আসতাছে — কিন্তু এগুলা admin panel-এর
/// >  কোথা থেকে আসতাছে? আমি তো কোথাও করি নাই, just product upload-এ আছে।
/// >  আমি চাই প্রতিটা admin panel-এ যেন create করে রাখা যায় আর এখানে যেন
/// >  just সে data আসে। trust badge-এ তো আমি কোন icon কিছুই custom করে
/// >  বানাতে পারছি না, তুমি নিজের মতো করে দিয়ে দিছ।"*
///
/// ⚠️ ঠিক ধরেছেন। এতদিন product page-এর badge আসত `ProductTrustBadge` থেকে,
/// আর সেই সারিগুলো তৈরি হতো product editor-এ **হাতে লেখা template** থেকে —
/// অর্থাৎ আমার বেছে দেওয়া icon আর শব্দ। মালিকের কোথাও কিছু বদলানোর পথ ছিল না।
///
/// ⚠️ Storefront → Trust-এর `TrustBadge` টেবিলটা **আলাদা জিনিস** — ওটা
/// homepage-এর strip, গোটা সাইটের। এটা product page-এর, category ধরে।
///
/// নিয়ম bundle আর craft-এর মতোই: category-তে লেখা = সবাই পায়; product-এ
/// নিজের কিছু থাকলে সেটাই **বদলে** বসে, যোগ হয় না।
/// ═══════════════════════════════════════════════════════════════════════════
model CategoryTrustBadge {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// ⚠️ হয় built-in নামের একটা icon, নয় নিজের আপলোড করা ছবি — দুটো একসাথে নয়।
  /// `TrustBadge`-এর হুবহু একই নকশা, একই কারণে: সারিটা দেখেই বোঝা যায় কোনটা।
  icon    String?
  iconUrl String? @db.Text

  label String
  sub   String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
}

/// "What's inside" — category-র সাধারণ তালিকা, DEC-PRD-023।
///
/// ⚠️ বেশিরভাগ product-এ এটা নিজের ("24 sticks"), তাই category-রটা কেবল
/// শুরু করার জায়গা — product-এ কিছু লেখা থাকলে সেটাই চলে।
model CategorySpec {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  item String
  qty  String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
}

/// The five or six questions under a category page — "How long do roses last?",
/// "Can you deliver at midnight?".
///
/// D-CAT-03, owner, 31 Jul 2026: category-wise, not one global FAQ list with a
/// category tag on each row. The two readings look equivalent until the list is
/// eighty rows long and every edit means finding the six that belong to flowers.
///
/// ⚠️ NOT the same thing as `ProductFaq`. That one answers "this bouquet";
/// this one answers "flowers, generally", and it is the copy Google reads on a
/// category page — the page people actually search for.
model CategoryFaq {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  question String
  answer   String @db.Text

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// required by the soft-delete extension even where nothing is soft-deleted —
  /// a model without it makes every findMany throw (see SectionText's note)
  deletedAt DateTime?

  @@index([categoryId, sortOrder])
}

/// admin-configurable brand master — DEC-PRD-008 (provisional).
/// FLAT: no parent-child (unlike Category). Product ↔ Brand = SINGLE FK
/// (one product, one brand — not m2m like Tag). Mostly gifts (chocolate,
/// perfume, soft toys) carry a brand; flowers/cakes usually don't → brandId is optional.
/// `website` intentionally omitted — linking shoppers to the maker's own site is a
/// conversion leak (decided 20 Jul, sobuj). OG fields omitted — logo + meta* suffices.
model Brand {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  logoUrl         String?   @db.Text // brand logo (data URL interim; media/CDN later)
  description     String?   @db.Text
  metaTitle       String?
  metaDescription String?
  isFeatured      Boolean   @default(false) // homepage "Shop by Brand" strip
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  products        Product[]
  items           Item[] // optional FK from Item (DEC-ITM-001)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

/// Storefront banners — hero slider, promo strip, announcement bar.
/// Owner's decision, 30 Jul 2026, during the homepage audit.
///
/// ONE TABLE, THREE PLACEMENTS. The three were separate hard-coded components
/// with the same shape: a picture, some words, a link, a season. Splitting them
/// into three tables would mean writing the scheduling rule three times and
/// getting it subtly different by the third.
///
/// TEMPLATE FIXED, CONTENT FREE — the boundary the owner agreed to after asking
/// for "everything dynamic". He owns every word, image, colour, link, date and
/// position; he does not get to move elements around the canvas. Reasoning he
/// accepted: a free-form canvas breaks an approved design in front of customers,
/// and that failure is public.
///
/// ⚠️ Most columns are nullable because ANNOUNCEMENT uses three of them and HERO
/// uses all of them. The alternative — a Json blob — cannot be queried, cannot
/// be validated, and hides which fields exist from anyone reading this file.
model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement

  /// null = shows in every zone. Values are the zone CODES in use today
  /// ("DHAKA" / "NATIONWIDE"), deliberately a String and not an enum: zone is
  /// becoming an admin-managed table (owner's call, 30 Jul), and this column
  /// becomes a FK to it. An enum would have to be migrated twice.
  zone String?

  /// the small letter-spaced line above the headline
  eyebrow String?
  /// headline in two parts — the design colours only the second, so they cannot
  /// be one field. "Send love to" + "all 64 districts".
  titleMain   String?
  titleAccent String?
  lead        String? @db.Text

  cta1Label String?
  cta1Href  String?
  cta2Label String?
  cta2Href  String?

  /// the three short trust chips under the buttons
  proof String[]

  /// two cards floating over the picture — icon name + two lines each
  float1Icon  String?
  float1Title String?
  float1Sub   String?
  float2Icon  String?
  float2Title String?
  float2Sub   String?

  imageUrl String? @db.Text

  /// ⚠️ Scheduling is stored, and the STOREFRONT is what enforces it — a banner
  /// outside its window is simply not returned by the public API. Nothing here
  /// switches itself off, so nothing needs a job to run on time.
  liveFrom DateTime?
  liveTo   DateTime?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([placement, isActive])
}

enum BannerPlacement {
  HERO // the big rotating slider at the top of the homepage
  PROMO // the seasonal strip lower down
  ANNOUNCEMENT // the thin purple line above the header
}

/// Which sections a page shows, and in what order. Owner's request, 30 Jul 2026.
///
/// Rows are declared in code (`PAGE_SECTION_MANIFEST`) and upserted on boot,
/// like `SectionText` — a section added to the page appears here by itself.
/// This table holds only the owner's DECISIONS about them: on or off, and where.
///
/// ⚠️ Some sections are `locked` in the manifest, not here. The hero carries
/// the page's only H1, and a page without one is a page Google cannot read; the
/// footer is the bottom of every page by definition. Storing "locked" as data
/// would let it be switched off by an UPDATE nobody reviewed.
model PageSection {
  id String @id @default(cuid())

  page String
  /// matches the manifest for built-in sections; `custom_<cuid>` for added ones
  key  String

  /// null = one of the twelve built-in sections, rendered by its own component.
  /// Set = a section the owner added, rendered from one of the ready-made
  /// shapes below.
  blockType BlockType?
  /// the heading, for added sections only. Built-in sections take theirs from
  /// SectionText, which is where every other heading on the site lives.
  title     String?
  subtitle  String?
  /// the block's own settings — which rule, which collections, which banner.
  /// Json because each shape needs different things, and a column per shape
  /// would be a table of mostly-nulls that grows with every new shape.
  config    Json?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// null = every zone. A section can be shown only to Dhaka, or only
  /// nationwide — the delivery band means different things in each.
  zone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, key])
  @@index([page, sortOrder])
}

/// The ready-made shapes an added section can take.
///
/// A fixed list, not a free canvas — the boundary the owner accepted for
/// banners, for the same reason: an arbitrary layout breaks an approved design
/// in front of customers, and that failure is public.
enum BlockType {
  PRODUCT_ROW // a row of products chosen by a rule
  COLLECTION_ROW // cards linking to chosen collections
  BANNER_STRIP // one banner, full width
}

/// What customers say. Owner's decision, 30 Jul 2026: three sources, kept
/// deliberately redundant so that Google going quiet does not leave the
/// homepage wordless.
///
/// ⚠️ MODERATION IS ON, AND IT IS NOT OPTIONAL. A review arriving from the
/// storefront is stored PENDING and appears nowhere until the owner approves
/// it. Publishing straight through hands the shop's most valuable surface to
/// anyone with a browser.
///
/// ⚠️ `source` IS NOT COSMETIC. It is the difference between a customer's own
/// words and words the shop typed in. The owner was warned, on 30 Jul, that
/// fabricated testimonials breach Meta's and Google's advertising policies and
/// can cost an ad account — and that the safe version of the same thing is to
/// telephone real customers and type what they actually say. Keeping the two
/// apart is what makes that distinction survive a year of edits.
model Review {
  id String @id @default(cuid())

  source ReviewSource
  status ReviewStatus @default(PENDING)

  authorName String
  /// 1–5. Google's own scale, so nothing has to be converted when its reviews
  /// arrive alongside these.
  rating     Int
  body       String @db.Text

  /// "Anniversary · Midnight delivery" — the line under the name
  context  String?
  imageUrl String? @db.Text

  /// optional: which product it is about. Null for reviews about the shop.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  /// ⚠️ Set by the SERVER from the order history, never by a form. A badge a
  /// customer can award themselves is worth nothing.
  verifiedPurchase Boolean @default(false)
  orderId          String?

  /// on the homepage rail. Being published is not the same as being chosen.
  isFeatured Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, isFeatured, sortOrder])
  @@index([productId])
}

enum ReviewSource {
  CUSTOMER // written by a shopper on the site — always starts PENDING
  SHOP // typed in by the owner
  GOOGLE // pulled from the Google Business Profile
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// A column of links. Owner's request, 31 Jul 2026.
///
/// ONE TABLE FOR THE FOOTER AND THE "MORE" PANEL, because they are the same
/// thing seen twice — a titled list of places to go, and several of the links
/// appear in both. Two tables would mean editing "Refund Policy" in one place
/// and finding the other still points at the old address.
model LinkGroup {
  id String @id @default(cuid())

  placement LinkPlacement
  /// the column heading — "Shop", "Help", "Company". Editable: these are the
  /// shop's words, not structure.
  title     String

  links NavLink[]

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, sortOrder])
}

enum LinkPlacement {
  FOOTER // the columns at the bottom of every page
  MORE // the slide-out panel behind the ☰ in the header
}

model NavLink {
  id      String    @id @default(cuid())
  groupId String
  group   LinkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  label String
  /// a path on this site ("/faq") or a full address. Stored as typed — the
  /// storefront decides how to render it.
  href  String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@index([groupId, sortOrder])
}

/// Facebook, Instagram, WhatsApp, TikTok — whatever the shop is on.
model SocialLink {
  id String @id @default(cuid())

  /// a name from the built-in icon set. Uploads are not offered here: brand
  /// marks are recognised by shape, and a hand-drawn Facebook logo reads as a
  /// counterfeit shop.
  icon String
  /// shown to screen readers and on hover
  label String
  url   String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The "We accept" row — bKash, Nagad, VISA…
///
/// ⚠️ These are claims about what the shop can TAKE. Showing a badge for a
/// method that is not actually connected means a customer fills a cart, reaches
/// checkout, and finds it missing. The owner was warned; the badges stay under
/// his control rather than being derived from the Integrations table, because
/// he may legitimately want one live a day before the key lands.
model PaymentBadge {
  id String @id @default(cuid())

  label String
  /// the brand's own logo. `null` falls back to the pill with the label in it,
  /// which is what the site shows today.
  imageUrl String? @db.Text

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// When the shop is open, one row per weekday. Owner's request, 31 Jul 2026.
///
/// ⚠️ THIS IS NOT JUST A LINE OF TEXT. The card carries a live "Open now ·
/// till 10 PM" pill that changes with the clock, so the times have to be
/// comparable numbers. A single free-text field would leave that pill either
/// permanently lying or removed.
///
/// The readable line ("Open every day, 9 AM – 10 PM") is GENERATED from these
/// rows, so it can never drift from what the pill says.
model ShopHour {
  id String @id @default(cuid())

  /// 0 = Sunday … 6 = Saturday. Numbers, not names: they sort, and they do not
  /// have to be translated.
  weekday Int @unique

  isClosed Boolean @default(false)

  /// minutes since midnight — 9 AM is 540, 10 PM is 1320.
  /// Integers rather than DateTime or "09:00": no timezone to get wrong, no
  /// parsing, and "is it open now" is one comparison.
  openMin  Int?
  closeMin Int?

  updatedAt DateTime @updatedAt
}

/// A day the shop is shut regardless of the weekly pattern — Eid, a family
/// wedding, a strike.
///
/// ⚠️ The reason this exists at all: without it the website says "Open" on Eid
/// morning and someone drives to Dhanmondi to find the shutters down. That is a
/// customer lost to a detail nobody thought to store.
model ShopClosure {
  id     String   @id @default(cuid())
  /// the closed day itself. One row per day — a three-day Eid is three rows,
  /// which is easier to read and to cancel one day of than a range.
  date   DateTime @db.Date
  reason String?

  createdAt DateTime @default(now())

  @@unique([date])
}

/// A shelf of products the shop puts a name on — "Under ৳1,000", "Premium
/// Collection", "Valentine's". Owner's decision, 30 Jul 2026.
///
/// TWO KINDS IN ONE TABLE, because they are the same thing to a shopper: a
/// titled page of products reached from a card. Only how membership is decided
/// differs.
///
///   PRICE_RANGE — anything priced inside the window belongs, automatically.
///     The owner chose this for the budget cards: a new product must never be
///     missing from "Under ৳1,000" because someone forgot to tag it.
///
///   MANUAL — the owner picks. "Premium" and "Valentine's" are not price
///     windows; no rule can decide what is romantic.
///
/// ⚠️ LOCKED, 30 Jul: price windows compare the price the CUSTOMER PAYS, after
/// discount. A ৳1,100 bouquet at 10% off sits in "Under ৳1,000" because ৳990 is
/// what they are asked for. The consequence, accepted knowingly: when the
/// discount ends the product leaves that group on its own, silently.
model Collection {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// the small line above the name on the card — "Sweet & simple"
  kicker   String?
  /// the line under it — "Little gestures, big smiles"
  subtitle String?
  imageUrl String? @db.Text

  mode CollectionMode @default(MANUAL)

  /// inclusive, in paisa. Null on either side = open-ended, so "৳5,000 and up"
  /// needs no sentinel value.
  minPaisa Int?
  maxPaisa Int?

  /// MANUAL membership. Empty for PRICE_RANGE.
  products CollectionProduct[]

  /// the rose-gold treatment the design gives the top tier. A flag, not a
  /// colour picker — see the banner notes on why the palette is not editable.
  accent Boolean @default(false)

  /// on the homepage budget rail. A collection can exist without being there.
  isFeatured Boolean @default(false)

  /// null = every zone. Same convention as Banner and TrustBadge.
  zone String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// required by the soft-delete extension even where nothing is soft-deleted
  deletedAt DateTime?

  @@index([isActive, sortOrder])
}

enum CollectionMode {
  PRICE_RANGE // membership follows the price
  MANUAL // membership is a list the owner keeps
}

/// Hand-picked membership. Its own table rather than an implicit m2m so the
/// order the owner arranged them in can be stored.
model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
}

/// The heading above every storefront section — the small coloured line, the
/// big title, and the sentence under it. Owner's request, 30 Jul 2026, after
/// annotating five screenshots with the same arrow.
///
/// ONE STORE FOR ALL OF THEM, not three fields added to each section's own
/// table. The wrong reading of "make the headings editable" is thirteen
/// separate builds on the homepage alone and a fresh one every time a section
/// is added — which guarantees one gets forgotten.
///
/// Rows are **declared in code and upserted on boot** (`SECTION_MANIFEST`),
/// the same pattern `RegistryService` uses for access nodes. A new section
/// names its key and appears in the admin list by itself; nobody has to
/// remember to seed it.
///
/// ⚠️ The seeded text is the CURRENT wording of the live site, not lorem. The
/// screen must open showing what the visitor sees, or the first save silently
/// rewrites a page nobody meant to touch.
model SectionText {
  id String @id @default(cuid())

  /// stable identifier, e.g. "home.categories" — code refers to this, never
  /// to the id, so a row can be deleted and recreated without breaking a page
  key String

  /// "" = the default, used by every zone with no override of its own.
  /// A zone override exists so Dhaka can say "2 hours" where nationwide says
  /// "64 districts"; most headings will never need one.
  ///
  /// ⚠️ An empty string rather than NULL, deliberately. In Postgres two NULLs
  /// are never equal, so `@@unique([key, zone])` with a nullable column would
  /// permit ten "default" rows for the same key and the database would allow
  /// exactly the thing the constraint exists to forbid.
  zone String @default("")

  eyebrow  String?
  title    String?
  subtitle String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ REQUIRED even though headings are never soft-deleted. The soft-delete
  /// extension adds `deletedAt: null` to every `findMany`, so a model without
  /// the column makes Prisma throw "Unknown argument `deletedAt`" and the whole
  /// API refuses to boot. Cost me a restart to learn; leaving the note so the
  /// next new table does not.
  deletedAt DateTime?

  /// one row per key per zone — the override, or the default when zone is ""
  @@unique([key, zone])
}

/// The trust strip — "2-Hour Delivery", "Freshness Promise", "Secure Payment".
/// Owner's correction, 30 Jul 2026: I had marked this "leave as fixed text" in
/// the homepage audit and he overruled it. He was right — these are the shop's
/// largest claims, they differ by zone, and they change when a payment method
/// or a delivery promise changes. They cannot live in code.
model TrustBadge {
  /// EITHER a name from the built-in set OR an uploaded file — never both.
  /// Two columns rather than one polymorphic string, so it is impossible to
  /// look at a row and not know which kind it is.
  icon    String?
  iconUrl String? @db.Text

  id       String  @id @default(cuid())
  title    String
  subtitle String?

  /// null = every zone. Same convention as Banner, and it becomes a FK to the
  /// Zone table for the same reason.
  zone String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
}

/// Storefront-wide knobs that belong to no single row. Singleton, like
/// CompanySetting. Created 30 Jul 2026 with one field; section headings, hours
/// and the rest of the homepage settings land here as they are built, rather
/// than each inventing its own table.
model StorefrontSetting {
  id String @id @default("singleton")

  /// how long each hero slide holds before the next. Was 6s hard-coded; the
  /// owner asked for it because a seasonal banner sometimes needs longer to
  /// read than an evergreen one.
  heroRotateSeconds Int @default(6)

  /// the small card floating over the shop photograph — two lines, like the
  /// hero's floating cards. Was typed into the component ("Dhanmondi, Dhaka /
  /// Watch your gift arranged by hand") and therefore wrong for any shop that
  /// moves street.
  shopChipTitle String?
  shopChipSub   String?

  /// the paragraph under the logo in the footer
  footerTagline String? @db.Text
  /* ---- the Google summary card above the reviews ----
     Typed by hand until the Business Profile is verified and connected, then
     these are overwritten by the real figures on a schedule.

     ⚠️ Entered by hand means it can be wrong on purpose. The screen says, in
     as many words, to copy what the profile actually shows — an invented star
     rating is the same offence as an invented review, with a number on it. */
  googleRating      Float?
  googleReviewCount Int?
  googleProfileUrl  String? @db.Text

  /// the small line on the far right of the bottom bar. The year is NOT stored
  /// — it is added at render time, because a copyright that still says 2026 in
  /// 2028 is the classic sign of an abandoned website.
  footerLegal   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// admin-configurable unit master — DEC-PRD-009 (locked 21 Jul, sobuj).
///
/// SELF-REFERENCING CONVERSION (owner's final call, 21 Jul). A unit points at a smaller
/// unit and says how many of it make one:
///   Papri       — baseUnitId null                         ← a base; nothing is smaller
///   Lily Stick  — baseUnitId = Papri,      baseQty = 4
///   Lily Bunch  — baseUnitId = Lily Stick, baseQty = 10   ⇒ resolves to 40 Papri
///   Gram        — base ·  Kg — baseUnitId = Gram, baseQty = 1000
/// Chains are allowed and resolved to the base for all stock maths; the API returns the
/// resolved figure so nobody multiplies by hand.
///
/// ⚠ KNOWN TRADE-OFF, accepted knowingly by the owner (21 Jul):
/// this only stays correct if the NAME is specific — "Lily Stick", not a bare "Stick",
/// because a gypsy stick is 2 papri, not 4. That means: the list grows with the
/// catalogue; someone must REMEMBER to create "Gypsy Stick" when gypsy is added; and
/// nothing ties a unit to a flower, so staff can pick "Lily Stick" on a gypsy item and
/// no rule objects. The alternative (factor per item) was considered and rejected.
/// Mitigation: the admin screen offers "Duplicate" so making the next "… Stick" is one
/// click, and flags names that look generic.
///
/// The QUANTITY never goes in the NAME — "Bunch of 12" is forbidden; it goes in baseQty.
///
/// No slug / CMS / SEO / logo: unlike Brand there is no `/units/<slug>` landing page —
/// a unit only renders as a price suffix ("৳1,200 / stick") and as an admin dropdown.
/// Delete rule: BLOCKED while a Product, an Item, or a recipe line depends on it.
model Unit {
  id        String @id @default(cuid())
  name      String @unique // "Papri", "Lily Stick", "Kg"
  shortCode String @unique // "papri", "stick", "kg" — storefront suffix + packing slip

  /// null = this IS a base unit (nothing smaller). Otherwise: what it breaks down into.
  baseUnitId   String?
  baseUnit     Unit?   @relation("UnitBase", fields: [baseUnitId], references: [id])
  derivedUnits Unit[]  @relation("UnitBase")

  /// how many `baseUnit` make ONE of this. Whole number >= 1; always 1 for a base unit.
  /// ⚠ editing this re-values every existing stock figure counted in this unit — the
  /// service writes an explicit ⚠ audit entry when it changes.
  baseQty Int @default(1)

  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  products  Product[] // Product.unitId — display/selling unit
  items     Item[] // Item.unitId — REQUIRED there (DEC-ITM-006)
  itemLines ItemComponent[] // recipe line unit (DEC-ITM-003)
  purchaseLines PurchaseLine[] // PurchaseLine.unitId — factor snapshotted there (DEC-PUR-009)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  @@index([baseUnitId])
}


/// admin-configurable tag GROUP — Occasions & Recipients are seeded system groups
/// (isSystem, cannot be deleted; storefront occasion pages + Gift Finder depend on
/// them), but marketing can add their own groups (Bouquet Style, Theme & Colour…).
/// Supersedes the fixed TagType enum → dynamic groups + per-tag image (DEC-PRD-002 rev).
model TagGroup {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  isSystem     Boolean         @default(false) // Occasions / Recipients — seeded, undeletable
  displayStyle TagDisplayStyle @default(CHIP) // storefront render: chips vs image cards

  /// Is this one of the tabs on the homepage's "Every Occasion, Every Person"?
  ///
  /// Added 3 Aug 2026. The homepage used to pick its tabs by `displayStyle ==
  /// CARD`, which answers a different question — *how* a group is drawn, not
  /// *whether* it belongs on the front page. The owner could not remove a tab
  /// without changing how that group renders everywhere else.
  ///
  /// ⚠️ Defaults FALSE, and the migration backfills it from the old rule
  /// (`displayStyle == CARD`) so the homepage does not change the day this
  /// ships. A new group is usually a filter — "Colour", "Price band" — and a
  /// group that quietly promoted itself to a homepage tab on creation would be
  /// a surprise. Tick it on Storefront → Homepage → Contents.
  ///
  /// The tags INSIDE a featured group default true, which is the opposite and
  /// is right: adding "Eid" to the Occasions tab should put a card there.
  isFeatured   Boolean         @default(false)
  tags         Tag[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
}

enum TagDisplayStyle {
  CHIP
  CARD
}

/// occasion + recipient + custom tag master — many-to-many with Product.
/// Now grouped (groupId → TagGroup) and image-capable. slug is unique PER GROUP.
/// `type` kept nullable for back-compat only (legacy OCCASION/RECIPIENT) — replaced
/// by groupId; dropped in a later cleanup migration once all tags are grouped.
model Tag {
  id        String    @id @default(cuid())
  slug      String
  name      String
  type      TagType? // LEGACY — superseded by groupId
  groupId   String?
  group     TagGroup? @relation(fields: [groupId], references: [id])
  imageUrl  String?   @db.Text // uploaded image (data URL interim; media/CDN later)
  /// the line under the name on a storefront card — "Make their day
  /// unforgettable". Named to match Category.summary, which is the same idea in
  /// the same place. (31 Jul 2026)
  summary   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)

  /// Does this tag get a card on the homepage?
  ///
  /// `isActive` cannot answer this. Switching a tag off removes it from the
  /// filters, the menus and the product form as well — the owner who only
  /// wanted "Rakhi" off the front page in November would lose the tag itself.
  /// Two questions, two columns. (3 Aug 2026)
  isFeatured Boolean  @default(true)

  products  Product[] // implicit m2m → Prisma auto join table
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([groupId, slug])
  @@index([groupId])
}

enum TagType {
  OCCASION
  RECIPIENT
}

/// colour/flavour sibling group। Variant = আলাদা product (locked §2, DEC-PRD-003):
/// প্রতি রঙের নিজের ছবি+stock; সাদা গোলাপ শেষ হলে লালের বিক্রি থামে না।
model VariantGroup {
  id        String      @id @default(cuid())
  kind      VariantKind
  label     String // "Colour" | "Flavour"
  products  Product[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
}

enum VariantKind {
  COLOUR
  FLAVOUR
}

/// sellable catalog entity। "assembled, not manufactured" — আলাদা কাঁচামাল-Item/BOM
/// table নেই (core principle); what's-inside = নিজের ProductSpec রো।
model Product {
  id         String   @id @default(cuid())
  slug       String   @unique
  sku        String?  @unique // staff-facing short code — "ROSE-78" (phone orders, packing slip)
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  tags       Tag[] // occasion + recipient (m2m)
  brandId    String? // optional single FK — mostly gifts carry a brand (DEC-PRD-008)
  brand      Brand?  @relation(fields: [brandId], references: [id])
  // DISPLAY/selling unit — what the headline price is quoted in ("৳1,200 / bunch").
  // Cosmetic and optional here; Item.unitId (DEC-ITM-006) is the required, meaningful
  // one. Once a Product is linked to an Item, this must be constrained to that Item's
  // unit family rather than the whole Unit master. (DEC-PRD-009)
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  // core classification — business logic এর উপর নির্ভর করে, তাই enum
  productType ProductType // READYMADE | CRAFTED — cancel/advance শাখা (locked §2)
  zone        ProductZone // DHAKA | NATIONWIDE  (mock "both" → NATIONWIDE)
  natureType  NatureType // FRESH | ARTIFICIAL
  natureLabel String? // "100% Fresh Flowers" ইত্যাদি

  // PDP story — Product owns (locked §2)
  shortDesc     String? // title-এর নিচের লাইন
  typeText      String? // free-text "type"
  videoId       String? // YouTube id
  nationwideMsg String? // NATIONWIDE-তে না পাওয়া গেলে message

  // pricing — সব paisa integer (locked: টাকা=paisa, DEC-PRD-004)
  costPaisa         Int
  sellingPricePaisa Int
  discountType      DiscountType @default(NONE)
  discountValue     Int          @default(0) // FLAT=paisa; PERCENT=basis points (1000 = 10%) — float নয়

  /// ── DEC-PRD-028 · ছাড়টা কবে থেকে কবে পর্যন্ত ───────────────────────────
  /// মালিক, ৩ আগস্ট ২০২৬:
  /// > *"আমরা যদি নির্দিষ্ট product-এ কোনো offer চালাই like discount, তার
  /// >  timing দেওয়ার জায়গা নেই — start date আর end date। যা frontend আর
  /// >  admin panel একই সাথে দেখাবে আর কাজ করবে।"*
  ///
  /// দুটোই ঐচ্ছিক, আর প্রতিটার নিজের অর্থ আছে:
  ///   দুটোই খালি  → ছাড় এখনই চলছে, শেষ হওয়ার তারিখ নেই (আগের আচরণ)
  ///   শুধু শুরু    → ওই দিন থেকে চলবে, তার আগে দাম পুরোটাই
  ///   শুধু শেষ     → এখনই চলছে, ওই দিনের পরে নিজে থেকে বন্ধ
  ///
  /// ⚠️ সময় ফুরালে ছাড়ের **সংখ্যাটা মুছে যায় না** — শুধু বসে না। মালিক
  /// তারিখ বাড়ালেই আবার চলবে, আর পুরনো ছাড় কত ছিল সেটাও দেখা যাবে।
  ///
  /// ⚠️ এটা Offers module-এর জায়গা নেয় না। ওখানে campaign — coupon, শর্ত,
  /// অনুমোদন, অনেক product একসাথে। এটা একটা product-এর নিজের দাম, আর
  /// দোকানকে "তিন দিনের জন্য ১০% কমাও" করতে ওই পুরো যন্ত্র চালাতে বলা
  /// মানে সে কখনো করবেই না।
  discountStartsAt DateTime?
  discountEndsAt   DateTime?

  // payment override (Product-level) — locked §2 (DEC-PRD-005)
  advanceRequired    Boolean      @default(false)
  advanceType        AdvanceType? // FULL | PARTIAL
  advancePercent     Int? // PARTIAL হলে %
  advanceAmountPaisa Int? // অথবা fixed paisa upfront

  // stock — এখন MANUAL, Product-owned; আসল stock পরে Inventory module (locked §2)
  stockMode StockMode @default(MANUAL)
  stockQty  Int       @default(0)
  showStock Boolean   @default(false) // storefront-এ দেখানো হবে কিনা

  /// ── শূন্য হলে কী হবে (মালিকের সিদ্ধান্ত, 1 Aug 2026) ────────────────────
  /// "stock 0 হলে order দেওয়া যাবে না। হয় stock out আসবে, বা pre-order আসবে।"
  ///
  /// এটা প্রতি product-এ মালিক নিজে ঠিক করেন — product type থেকে আন্দাজ করা
  /// হয় না। তাজা ফুল কখনোই pre-order নয়, কিন্তু একই READYMADE ঘরে বসা mug
  /// বা hamper হতে পারে। আন্দাজ করলে ব্যতিক্রমের জায়গা থাকত না।
  ///
  /// Default `STOCK_OUT` — কারণ ভুল করে বিক্রি বন্ধ হওয়া সারানো যায়, আর ভুল
  /// করে এমন জিনিসের প্রতিশ্রুতি দেওয়া যেটা আসবেই না, সেটা যায় না।
  soldOutMode SoldOutMode @default(STOCK_OUT)

  /// PRE_ORDER হলে মালিক নিজে যে তারিখ লিখে দেন — "Expected back on"।
  /// lead time থেকে হিসাব করা হয় না; মালিক তারিখ লিখে দেওয়াই বেছেছেন।
  /// ⚠️ তারিখ পার হয়ে গেলে page মিথ্যা বলবে, তাই পার হওয়া তারিখ website-এ
  /// পাঠানো হয় না — তখন শুধু "Pre-order" লেখা যায়, তারিখ ছাড়া।
  preorderDate DateTime?

  /// ── কে সরবরাহ করে (owner's ruling, 1 Aug 2026) ─────────────────────────
  /// Vendor-এর product: আমাদের গুদামে কিছুই থাকে না, Item-ও লাগে না। Vendor
  /// অর্ডার পেলে বানায়, আমরা খবর পাঠাই, আর টাকা consignment হিসেবে ভাগ হয়।
  ///
  /// ⚠️ এটা `Item.supplierId` (DEC-SUP-004) নয়, আর দুটো গুলিয়ে ফেলা সহজ:
  ///   · `Item.supplierId`    — এই কাঁচামাল কার কাছ থেকে কিনি (stock আমাদের)
  ///   · `Product.supplierId` — এই listing কে বানিয়ে দেয় (কিছুই আমাদের নয়)
  /// দুটো আলাদা প্রশ্ন, তাই দুটো আলাদা column।
  supplierId String?
  supplier   Supplier? @relation("VendorProducts", fields: [supplierId], references: [id])

  /// ── website-এ কোন সংখ্যা দেখাবে ────────────────────────────────────────
  /// null = আসল সংখ্যাই দেখাবে। সংখ্যা বসালে **সেটাই** দেখায়, আর অর্ডার এলে
  /// সেটাই কমে — আসল মজুদ অপরিবর্তিত থাকে delivery পর্যন্ত।
  ///
  /// মালিকের সিদ্ধান্ত, 1 Aug: গুদামের গভীরতা ফাঁস না করে তাড়া তৈরি করা।
  /// ⚠️ ঝুঁকিটা তাঁকে জানানো হয়েছে (৫০০০ থাকা অবস্থায় "২০ বাকি" সত্য নয়)
  /// এবং তিনি জেনেই সিদ্ধান্ত নিয়েছেন। শূন্যে নামলে admin-এ notification
  /// যাবে — নাহলে যে জিনিস প্রচুর আছে সেটাই চুপচাপ বিক্রি বন্ধ হয়ে যেত।
  displayQty Int?

  /// এটা বানাতে কত মিনিট লাগে। null = বানাতে হয় না, তাই দিনের সময়ও খায় না।
  ///
  /// ⚠️ ভাগে ফেলা হয়নি ("২০-৩০ মিনিট") ইচ্ছাকৃত — ৪০ মিনিটের কাজকে কোন ভাগে
  /// ফেলব সেই আন্দাজটাই ভুলের উৎস। যা লাগে তাই লেখা হয়।
  makeMinutes Int?

  /// ⚠️ `isHandmade` আর `stockDisplay` এখানে ছিল, ১ আগস্টেই সরানো হয়েছে।
  /// "হাতে বানানো" Basics-এ `productType = CRAFTED` দিয়ে আগেই ঠিক হয়। একই
  /// তথ্যের দ্বিতীয় ঘর মানে একদিন দুই উত্তর। দিনের সক্ষমতা `productType` +
  /// `categoryId` পড়ে নেবে, আর সেটা নিজের module-এর জিনিস — একটা product-এর নয়।

  /// DEC-DLV-008 — কোন কোন delivery-তে এই product যেতে পারে।
  /// `supportsExpress/SameDay/Midnight` তিনটা boolean-এর উত্তরসূরি।
  deliveryTypes ProductDeliveryType[]

  /// DEC-PRD-012 — এই product-এর রঙ / ফ্লেভার / মাপগুলো, প্রতিটার নিজের
  /// ছবি আর মজুদ নিয়ে। খালি = এই product-এর কোনো variant নেই, আর তখন
  /// product page-এ ওই অংশটাই দেখা যায় না।
  variants ProductVariant[]

  // sales counter — Sales module "delivered" event-এ +1 করবে (locked §4, DEC-MOD-003 পরিবারভুক্ত)
  salesCount Int @default(0)

  /// ── DEC-PRD-025 · বিক্রির সংখ্যা কীভাবে দেখাবে ─────────────────────────
  /// মালিক, ২ আগস্ট ২০২৬:
  /// > *"আমরা এখানে প্রথমে একটা fake sale account বসাব — like 50, 100, 1000।
  /// >  সে সংখ্যা যাই হোক, তারপর real sell হলে সেই সংখ্যার সাথে add হবে —
  /// >  50 বসালাম, একটা sell হলো, auto 51 হয়ে যাবে। আমাদের stock-এর মতো,
  /// >  এটা তুমি ভুলে গেছ। আর আমাদের এখানে just last month আছে, এটা
  /// >  customize-এর option নেই — today sell, week sell, month and all time।"*
  ///
  /// ⚠️ কেন নতুন কলাম, `salesCount` থাকতে। `salesCount` হলো **চলমান মোট** —
  /// order delivered হলে সেটায় যোগ হয়। তাই ওটাকে একই সাথে "শুরুর সংখ্যা"
  /// ধরলে সপ্তাহের হিসাবে পুরনো বিক্রি দুবার গোনা হতো। `salesSeed` কখনো
  /// বদলায় না — মালিক যা লিখেছেন, ঠিক তাই।
  ///
  /// ⚠️ **চারটে আলাদা ঘর** — মালিকের বাছাই, ২ আগস্ট ২০২৬। প্রশ্নটা ছিল:
  /// *"ধরো আমি দিলাম today sale ১০টা, সেভাবে week আর month-এ দিলাম। তাহলে
  /// today, week আর month শেষ হলে সে সংখ্যার কী হবে?"*
  ///
  /// একটাই ঘর রাখলে "আজ ১০" আর "এ মাসে ২০০" একসাথে বলা যেত না — মাসের
  /// সংখ্যাটা আজকের দিনেও বসে যেত। এখন যে সময়টা বাছা, তার নিজের সংখ্যাটাই
  /// চলে।
  ///
  /// দেখানো সংখ্যা = ওই সময়ের seed + ওই সময়ের ভেতরের **সত্যিকারের** order।
  /// সময় ফুরালে (রাত ১২টা, সপ্তাহ, মাস) সত্যিকারের অংশটা শূন্য থেকে আবার
  /// শুরু হয়; seed-টা বসে থাকে — ওটা মালিকের বেছে নেওয়া মেঝে।
  salesSeedToday Int @default(0)
  salesSeedWeek  Int @default(0)
  salesSeedMonth Int @default(0)
  salesSeedAll   Int @default(0)

  /// ⚠️ কখন সংখ্যাগুলো বসানো হয়েছিল — আর এটাই "প্রতিদিন নতুন করে শুরু"
  /// হওয়ার চাবি। মালিক, ২ আগস্ট ২০২৬:
  /// > *"today, week and month-এ ০ হোক, আমি এটাই চাই। all time তো carry
  /// >  করবে, সমস্যা নেই। কিন্তু always যদি মানুষ দেখে today 10 sale, তাহলে
  /// >  Google আর মানুষের কাছে এটা fake হয়ে যাবে। daily এটা restart হওয়াই
  /// >  ভালো। আবার আমাদের যদি দরকার হয়, product-এ ঢুকে আবার সংখ্যা add করব।"*
  ///
  /// তাই TODAY-র সংখ্যা কেবল **সেই দিনটাতেই** চলে, WEEK ৭ দিন, MONTH ৩০ দিন।
  /// সময় পেরোলে সংখ্যাটা মুছে ফেলা হয় না — শুধু গোনা হয় না। মালিক আবার
  /// চাইলে ঢুকে save করলেই ঘড়িটা নতুন করে শুরু।
  ///
  /// ⚠️ কোনো background job নেই, আর সেটাই ইচ্ছাকৃত। রাত ১২টায় চলা একটা
  /// cron মানে একটা জিনিস যা চুপচাপ বন্ধ হয়ে যেতে পারে আর কেউ টের পায় না।
  /// পড়ার সময় তারিখ মিলিয়ে নেওয়া কখনো "চলতে ভুলে যায়" না।
  salesSeedAt DateTime?
  /// কোন ঘরটা এখন চলবে। `MONTH` = আগের আচরণ, তাই সেটাই default।
  salesWindow SalesWindow @default(MONTH)

  /// ── DEC-PRD-026 · গ্রাহক এই product-এ নিজের কিছু দিতে পারবে কি না ──────
  /// মালিক, ২ আগস্ট ২০২৬: *"আমাদের customize product-এ কোথাও image upload
  /// আর কোথাও text লেখার জায়গা product page-এ দিতে হয় — সেটার configure
  /// করার জায়গা পেলাম না।"*
  ///
  /// ⚠️ পেলেন না, কারণ ছিলই না। আরও খারাপ: storefront-এর seam-এ সোজা
  /// `perso: null` লেখা ছিল, তাই কোনো product-এ বাক্সটা **কখনো** আসেনি।
  /// Cart, checkout আর order আগে থেকেই `persoText`/`persoImage` বয়ে নিয়ে
  /// যেত — শুধু মাঝের অংশটা কেউ বানায়নি।
  ///
  /// দুটো আলাদা switch, কারণ mug-এ নাম লাগে আর photo-frame-এ ছবি — দুটো
  /// একসাথে দরকার হয় কদাচিৎ, কিন্তু হয়।
  persoTitle      String?
  /// নাম/বার্তা লেখার ঘর
  persoText       Boolean @default(false)
  persoTextLabel  String?
  /// সর্বোচ্চ কত অক্ষর। `null` = সীমা নেই।
  persoTextMax    Int?
  persoTextHint   String?
  /// ছবি দেওয়ার ঘর
  persoImage      Boolean @default(false)
  persoImageLabel String?
  persoImageHint  String?

  /// ── DEC-PRD-027 · "Want this customised?" সবুজ বাক্স ───────────────────
  /// মালিক: *"আমরা কোন কোন product-এ customize করতে দিব, যা দিলে পাশে
  /// WhatsApp show করবে — তা customize করার option... সেটাও কোথাও দেখতে
  /// পেলাম না।"*
  ///
  /// ⚠️ বাক্সটা এতদিন **সব** product-এ দেখাত, লেখা আসত category-র হাতে লেখা
  /// template থেকে, আর নম্বরটা ছিল `wa.me/8801000000000` — আমার বসানো একটা
  /// বানানো নম্বর। কেউ চাপলে কোথাও যেত না।
  ///
  /// এখন প্রতি product-এ switch, আর নম্বর আসে Company settings-এর
  /// `publicPhone` থেকে — দুই জায়গায় দুটো নম্বর রাখার মানে নেই।
  customiseOn    Boolean @default(false)
  customiseTitle String?
  customiseSub   String?

  // ---- Item link (DEC-ITM-002) --------------------------------------------------
  // Every Product resolves to exactly ONE Item — the physical thing behind the listing.
  // Nullable ONLY during rollout; becomes required after the DEC-ITM-009 generator has
  // backfilled every existing Product. Many Products may share one Item (the same
  // bouquet recipe backing a normal, a Valentine and a corporate listing).
  // ⚠️ `sku` above is DEPRECATED (DEC-ITM-010): its values are copied into Item.sku by
  // the generator, all reads move to product.item.sku, then the column is dropped.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id])

  // made-to-order lead time — CRAFTED পণ্যে "কত দিন লাগবে" (DEC-PRD-006)
  leadTimeDays Int? // null = same-day / readymade

  // upgrade link — এই product কি অন্য একটা product-এর বড় version?
  // Upgrade = নিজের full price/cost/discount সহ আলাদা product; base + extra নয়।
  // storefront-এ এটা option হিসেবে দেখায়, নিজের page-এ যায় না (locked)।
  upgradeOfProductId String?
  upgradeOf          Product?  @relation("ProductUpgrade", fields: [upgradeOfProductId], references: [id])
  upgrades           Product[] @relation("ProductUpgrade")
  upgradeSortOrder   Int       @default(0)

  // manually pinned add-on groups for THIS product (besides the automatic rules).
  // auto rules cover most; this is the "specially for this product" override.
  manualAddOnGroups AddOnGroup[] @relation("ProductManualAddOns")

  // variant link (colour/flavour sibling)
  variantGroupId String?
  variantGroup   VariantGroup? @relation(fields: [variantGroupId], references: [id])
  variantLabel   String? // ⚠️ DEPRECATED — see variantValueId below
  variantSwatch  String? // ⚠️ DEPRECATED — see variantValueId below

  // ---- Colour / option, from the master (D-CAT-01, owner 31 Jul 2026) -------
  // What this product IS, chosen from `VariantValue` — never typed here.
  //
  // WHY A FK AND NOT THE TWO STRINGS ABOVE. `variantLabel` held the word "Red"
  // and `variantSwatch` a copy of its hex. Two products could hold "Red" and
  // "red " and be two different colours to the database; renaming the master
  // changed neither. The category page's colour grid is a QUERY —"which
  // colours actually exist in Fresh Flowers, and which products are red" — and
  // a query cannot be run against free text that nothing keeps in step.
  //
  // NOT limited to variant siblings. A single white lily with no red twin still
  // has a colour; before this it had nowhere to put one and could never appear
  // under White. `variantGroupId` answers "what can I switch to on the product
  // page"; this answers "what is it". Different questions.
  //
  // ONE VALUE, NOT MANY — owner, 31 Jul. A multi-colour bouquet is given the
  // master's own "Mixed" value. So a red-and-white bouquet does NOT appear
  // under Red; it appears under Mixed, and that is the intended behaviour
  // ("Red মানে ঠিক Red"). Recorded because it will look like a bug later.
  //
  // The two strings above are read from this once every product is backfilled,
  // then dropped — the same retirement `sku` → `Item.sku` is going through.
  variantValueId String?
  variantValue   VariantValue? @relation(fields: [variantValueId], references: [id])

  // delivery-speed flags — ⚠️ পরে Delivery module derive করবে; এখন Product mirror (locked §2)
  supportsExpress  Boolean @default(false)
  supportsSameDay  Boolean @default(false)
  supportsMidnight Boolean @default(false)

  // ---- SEO (SEO-D01) ------------------------------------------------------
  // Category and Brand have carried these since the first build; Product never
  // did — and a product page is what somebody actually searches for ("red rose
  // bouquet dhaka"), not a category. Blank means the storefront falls back to
  // the name and short description, so nothing breaks while these fill in.
  metaTitle       String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String? @db.Text
  /// keep this page out of Google — for a one-off corporate listing or a
  /// product only reachable by a private link
  noIndex         Boolean @default(false)

  // merchandising flags
  isPublished  Boolean @default(false)
  isBestSeller Boolean @default(false)
  isNewArrival Boolean @default(false)

  // children — Product owns (One Data One Owner)
  images      ProductImage[]
  sizes       ProductSize[]
  specRows    ProductSpec[]
  faqs        ProductFaq[]
  trustBadges ProductTrustBadge[]
  /// this product's own bundle list, when it overrides its category's
  bundles     Bundle[]            @relation("BundleOnProduct")
  /// DEC-PRD-017 — যেসব bundle-এ এই product যোগ হয়
  bundleItems BundleItem[]        @relation("BundleItemProduct")
  /// DEC-PRD-016 — এই product-এর combo দামগুলো
  bundleCombos BundleCombo[]
  /// likewise for the craft cards
  craft       CraftPoint[]
  /// every bundle card that ADDS this product — the chocolate's view of it.
  /// Needed before deleting a product: it may be sitting on other pages.
  bundledInto Bundle[]            @relation("BundleAddsProduct")
  orderLines  OrderLine[] // Sales references (One Data One Owner)
  offers      Offer[]             @relation("OfferProducts") // DEC-OFR — PRODUCT-shape targeting
  collections CollectionProduct[] // hand-picked shelves this product sits on
  reviews     Review[] // what customers said about this one

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([variantGroupId])
  @@index([upgradeOfProductId])
  @@index([brandId])
  @@index([itemId])
  /// the colour grid asks "red things, in this category" — both columns, one index
  @@index([variantValueId, categoryId])
}

enum ProductType {
  READYMADE
  CRAFTED
}

enum ProductZone {
  DHAKA
  NATIONWIDE
}

enum NatureType {
  FRESH
  ARTIFICIAL
}

enum DiscountType {
  NONE
  FLAT
  PERCENT
}

enum AdvanceType {
  FULL
  PARTIAL
}

enum StockMode {
  MANUAL
  TRACKED
}

/// মজুদ শূন্য হলে listing কী করবে। DEC-PDP-09।
enum SoldOutMode {
  /// বিক্রি বন্ধ। "Out of stock", cart button নিষ্ক্রিয়।
  STOCK_OUT
  /// অর্ডার নেওয়া যাবে, তবে গ্রাহক জানে জিনিসটা এখন হাতে নেই।
  /// টাকার নিয়ম আলাদা কিছু নয় — product-এর নিজের `advanceRequired`ই চলে।
  PRE_ORDER
}

/// কত দিনের বিক্রি গোনা হবে — DEC-PRD-025।
///
/// ⚠️ এটা শুধু **দেখানোর** সিদ্ধান্ত। `salesCount` (sorting-এর জন্য) আর
/// order-এর হিসাব এতে বদলায় না।
enum SalesWindow {
  /// আজকের
  TODAY
  /// গত ৭ দিন
  WEEK
  /// গত ৩০ দিন — আগের আচরণ
  MONTH
  /// দোকান খোলার পর থেকে সব
  ALL
}

/// product gallery ছবি (Cloudinary url পরে)
model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  url       String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
}

/// SIZE — একই product, শুধু দাম বদলায় (locked §2 variant model)
model ProductSize {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  label      String // "Standard" | "24 Stems" | "2 lb"
  sub        String? // "+50% blooms"
  pricePaisa Int
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([productId])
}

/// what's-inside / spec row — Product owns (BOM নয়, শুধু structured display)
model ProductSpec {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  item      String // "Red Rose (fresh cut)"
  qty       String // "24 sticks"
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
}

/// product-specific FAQ — "Before You Order" section (template + common merge, locked §2)
model ProductFaq {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  question  String
  answer    String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
}

/// trust badge — category template default; product override (locked §2)
model ProductTrustBadge {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  icon      String // Icon.tsx নাম
  /// DEC-PRD-023 — নিজের আপলোড করা icon। `icon`-এর জায়গা নেয় যখন ভরা থাকে।
  /// category-র badge-এ যেটা পারা যায়, product-এর নিজেরটাতেও পারা উচিত —
  /// নাহলে override করতে গেলেই ছবিটা হারিয়ে যেত।
  iconUrl   String?   @db.Text
  label     String
  sub       String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
}

/// BUNDLE — "+ Chocolates ৳400" on a product page. Owner decision, 31 Jul 2026.
///
/// NOT AN ADD-ON, AND THE DIFFERENCE IS LOAD-BEARING. An `AddOn` is a small
/// thing that is never sold on its own (gift wrap, a card) and has no catalog
/// page. A bundle ADDS A REAL PRODUCT — a chocolate box that has its own page,
/// its own price and its own stock. Modelling it as an AddOn would put the
/// chocolate's price in two tables, and the day the owner raises it in one the
/// shop keeps selling at the old price in the other, silently, at a loss.
/// So there is no price column here at all: only a DISCOUNT off whatever the
/// added product currently costs. See `discountType` below.
///
/// Not an upgrade either. `Product.upgradeOf` is the SAME thing, larger, at its
/// own full price. A bundle is a SECOND thing arriving alongside the first.
///
/// WHERE IT SHOWS — the pattern the owner chose for craft cards on the same
/// day: write it once on the category, override on a product when that one
/// product needs something different. Exactly one of `categoryId` /
/// `productId` is set; the API prefers the product's own rows and falls back
/// to its category's. A row with both, or neither, is a bug — enforced in the
/// service, since a database CHECK on "exactly one of two nullables" is not
/// expressible in Prisma schema.
model Bundle {
  id String @id @default(cuid())

  /// category-level default — every product in it offers this bundle
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  /// product-level override — this product's own list, replacing the category's
  productId  String?
  product    Product?  @relation("BundleOnProduct", fields: [productId], references: [id])

  /// ⚠️ পুরনো — এক bundle = এক product-এর দিন থেকে। DEC-PRD-017-এ এক
  /// bundle-এ কয়েকটা product ঢুকেছে, আর সেগুলো `items`-এ। এই কলামটা এখনো
  /// আছে শুধু পুরনো সারি না ভাঙার জন্য; নতুন কিছু এটা পড়ে না।
  addsProductId String
  addsProduct   Product @relation("BundleAddsProduct", fields: [addsProductId], references: [id])

  /// DEC-PRD-017 — এই bundle-এ যে যে product যায়।
  ///
  /// মালিক, ২ আগস্ট ২০২৬:
  /// > *"আমি চাই ধরো main product-এর সাথে আরও ১, ২, ৩, ৪ যাই হোক যে পরিমাণ
  /// >  product add করি, করার পর তারপর নিচে একটা discount ঘর আসবে — সেখানে
  /// >  discount দিলে total সব product মিলিয়ে, main product সহ, discount
  /// >  count হবে।"*
  items BundleItem[]

  /// "+ Chocolates". Null → the added product's own name, which is usually too
  /// long for the card ("Handmade Truffle Box — 16 pieces").
  label String?

  /// ⚠️ A DISCOUNT, NOT A PRICE — the whole point of this table.
  ///
  /// The owner gives a discount for taking the bundle (his words, 31 Jul), so
  /// the card cannot simply show the catalog price. The tempting fix is a
  /// `pricePaisa` column holding ৳400. That column is correct on the day it is
  /// typed and wrong forever after: the chocolate goes to ৳600 and the bundle
  /// still sells it at ৳400, a ৳200 loss per order that nothing reports.
  ///
  /// Storing "৳50 off" instead can never go stale. FLAT = paisa,
  /// PERCENT = basis points (1000 = 10%) — the same convention as Product and
  /// AddOn, so there is one rule to remember, not three.
  discountType  DiscountType @default(NONE)
  discountValue Int          @default(0)

  sortOrder Int     @default(0)
  /// the rose-gold "Most loved" flag on one card. A merchandising nudge, and
  /// only one per list should carry it — the service takes the first.
  isBest    Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// ⚠️ DEC-PRD-016 (combo দাম) আর ব্যবহার হয় না — DEC-PRD-017-এ bundle
  /// নিজেই একটা set হয়ে গেছে, আর তার নিচেই ছাড়ের ঘর। টেবিল দুটো রয়ে গেছে
  /// (কিছু মোছা হয় না), কিন্তু কোনো পর্দা বা API আর সেগুলো পড়ে না।
  comboItems BundleComboItem[]

  @@index([categoryId])
  @@index([productId])
  @@index([addsProductId])
}

/// এক bundle-এর ভেতরের একটা product। DEC-PRD-017।
///
/// ⚠️ আলাদা টেবিল, কারণ সংখ্যাটা আগে থেকে জানা নেই — মালিক ১টাও দিতে পারেন,
/// ৪টাও। `Bundle`-এ চারটে nullable কলাম রাখলে পঞ্চমটার দিন schema বদলাতে হতো।
model BundleItem {
  id String @id @default(cuid())

  bundleId String
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  /// যে catalog product যোগ হচ্ছে। দাম **সবসময়** ওখান থেকেই পড়া হয় —
  /// এখানে কোনো দাম রাখা হয় না, নাহলে ওই product-এর দাম বাড়লে এই সারি
  /// পুরনো হয়ে বসে থাকত।
  addsProductId String
  addsProduct   Product @relation("BundleItemProduct", fields: [addsProductId], references: [id])

  sortOrder Int @default(0)

  @@unique([bundleId, addsProductId])
  @@index([addsProductId])
}

/// ═══════════════════════════════════════════════════════════════════════════
/// COMBO PRICE — কয়েকটা একসাথে নিলে একটা নির্দিষ্ট দাম
///
/// মালিক, ২ আগস্ট ২০২৬:
/// > *"main product + 1 product combo and combo discount price. main product
/// >  + extra 2, 3, 4 product যদি combo হয় তাহলে সেটার price বসবে — কতগুলা
/// >  product select করছে সে হিসাবে।"*
///
/// ⚠️ প্রতিটা combination লিখতে হয় না — মালিক শুধু যেগুলোতে আলাদা দাম চান
/// সেগুলোই লেখেন। গ্রাহক যা tick করল তা কোনো combo-র সাথে **হুবহু** মিললে
/// সেই দামটা বসে; না মিললে আগের হিসাব (প্রতিটার নিজের ছাড় যোগ) চলে।
/// ৫টা add-on মানে ৩১টা combination — সবগুলো লিখতে বলা মানে কেউ লিখবেই না।
///
/// ⚠️ এটা `Bundle.discountValue`-এর নিয়ম ভাঙে, আর জেনেই। ওখানে দাম নয় ছাড়
/// রাখা হয়েছে যাতে চকলেটের দাম বাড়লে bundle পুরনো না হয়। এখানে মালিক
/// **পুরো order-এর একটা দাম** চেয়েছেন (তাঁর নিজের বাছাই), তাই সংখ্যাটা
/// একদিন পুরনো হতে পারে। সেটা ঢাকা হয় না — admin-এ প্রতিটা combo-র পাশে
/// আজকের স্বাভাবিক দাম আর সাশ্রয় সবসময় হিসাব করে দেখানো হয়, তাই মূল দাম
/// বদলালে সাশ্রয়ের সংখ্যাটা চোখের সামনেই বদলে যায়।
/// ═══════════════════════════════════════════════════════════════════════════
model BundleCombo {
  id String @id @default(cuid())

  /// কোন product-এর page-এ এই combo
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// ঐচ্ছিক নাম — "Birthday pack"। খালি হলে জিনিসগুলোর নামই দেখানো হয়।
  label String?

  /// ⚠️ পুরো line-এর দাম — মূল product সহ, base অবস্থার।
  ///
  /// রঙ বা মাপে আলাদা দাম থাকলে সেই **পার্থক্যটুকু** এর উপরে যোগ হয়
  /// (মালিকের অনুমোদিত নিয়ম)। নাহলে ২ কেজি কেক নিলেও combo একই দাম
  /// দেখাত, আর দামি মাপটা কার্যত ফ্রি হয়ে যেত।
  pricePaisa Int

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items BundleComboItem[]

  @@index([productId])
}

/// combo-র ভেতরের একটা bundle। জোড়া `Bundle`-এর সাথে, `Product`-এর সাথে নয় —
/// গ্রাহক তো bundle card-ই tick করে, আর মেলানোটা ঠিক ওই tick-এর সাথেই হতে হবে।
model BundleComboItem {
  id String @id @default(cuid())

  comboId String
  combo   BundleCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  bundleId String
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([comboId, bundleId])
  @@index([bundleId])
}

/// CRAFT POINT — the three "why buy this from us" cards under the fold.
/// "Cut this morning, in her hands tonight" · "Arranged in our own studio".
///
/// Owner decision, 31 Jul 2026: WRITTEN ONCE ON THE CATEGORY. Seventy-one
/// products cannot each have three paragraphs written by hand — nobody does
/// that work, so in practice the section would be empty on every product added
/// after the first week. A product that deserves its own story overrides.
///
/// Same shape as `Bundle`, deliberately: exactly one of `categoryId` /
/// `productId`, the product's rows REPLACE its category's rather than adding
/// to them. Two ownership rules for two lists on the same page would be one
/// rule too many to remember.
///
/// ⚠️ NOT `ProductTrustBadge`. That is the row of three short promises beside
/// the price ("2-Hour Delivery"); this is three paragraphs about how the thing
/// is made. They read as similar and are not: one is a delivery claim, the
/// other is craft. Trust badges are still product-only and inherit nothing —
/// audit §3গ, still open.
model CraftPoint {
  id String @id @default(cuid())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])

  /// a name from the storefront's own icon set — sun, store, bolt, leaf.
  /// A name it does not know renders as a neutral tick, never a blank square.
  icon  String
  title String
  text  String @db.Text

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([productId])
}

/// দিনের সক্ষমতা — "আজ আর কতটা কাজ নেওয়া যাবে"। মালিকের সিদ্ধান্ত, 1 Aug 2026।
///
/// কেন সংখ্যা নয়, সময়: "আজ ৫০টা" ধরে নেয় প্রতিটা জিনিসে সমান শ্রম লাগে। কিন্তু
/// ১৫ মিনিটের তোড়া আর ৬ ঘণ্টার সাজানো এক নয় — ৫০ সংখ্যাটা জানেই না কোনটা ভারী।
/// সময়ে গুনলে মিশ্রণ যাই হোক হিসাব নিজে থেকে মেলে।
///
/// ⚠️ System কখনো ধরে নেয় না দিনে ২৪ ঘণ্টা। `workers × hoursEach` — মালিক যা
/// বলেন তাই। কাল ৩ জন এলে একটা সংখ্যা বদলালেই হয়; ভাগ-ভিত্তিক হিসাবে তিনটে
/// সংখ্যা বদলাতে হত আর প্রতিবার অনুপাত মেলাতে হত।
model CapacityGroup {
  id   String @id @default(cuid())
  name String @unique // "ফুলের কাজ" · "কেক" · "Custom মগ"

  /// আজ কজন কাজ করছে, আর প্রতিজন কত ঘণ্টা। দুটো আলাদা, কারণ লোক বদলায় —
  /// ঘণ্টা সাধারণত বদলায় না।
  workers   Int @default(1)
  hoursEach Int @default(8)

  /// ফুলের কারিগর কেক বানায় না — তাই প্রতিটা দলের নিজের হিসাব।
  categories Category[]
  bookings   CapacityBooking[]

  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// একটা অর্ডারের কাজ কোন দিনে কতটা সময় নিল।
///
/// "রোজ নিজে থেকে রিসেট" — এর জন্য কিছু মুছতে হয় না। প্রতিটা দিনের হিসাব
/// আলাদা সারিতে থাকে, তাই নতুন দিন এমনিতেই খালি। কোনো cron নেই, আর যে cron
/// একদিন চলে না সেটার ব্যর্থতাও নেই।
model CapacityBooking {
  id      String        @id @default(cuid())
  groupId String
  group   CapacityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// যেদিন কাজটা হবে — অর্ডারের দিন নয়। মালিকের সিদ্ধান্ত: scheduled অর্ডার
  /// আজকের হিসাব খায় না; ২ ঘণ্টা / same-day / আজ রাতে — সব আজকের।
  onDate  DateTime @db.Date
  minutes Int

  /// লম্বা কাজ কয়েক দিনে ভাগ হয়ে বসে — তাই এক অর্ডারের একাধিক সারি থাকতে পারে
  orderId   String?
  productId String?

  createdAt DateTime @default(now())

  @@index([groupId, onDate])
  @@index([orderId])
}

// ============================================================
// CUSTOMER MODULE — Customer + Recipient book + Segment master
// Source: RADIAN_ADMIN_PROGRESS.md §3 (locked Customer decisions)
// ============================================================

/// CRM segment master — admin-configurable, many-to-many (Tag-এর মতো) (DEC-CUS-001)
/// ছোট বাড়তি জিনিস — greeting card, gift wrap, vase।
/// Add-on কখনো website-এ product নয় এবং একা বিক্রি হয় না (locked, DEC-PRD-007)।
/// সবসময় যোগ হয়: ৳500 bouquet + ৳50 card = ৳550।
model AddOn {
  id                String       @id @default(cuid())
  name              String
  sku               String?      @unique
  imageUrl          String?
  pricePaisa        Int
  discountType      DiscountType @default(NONE)
  discountValue     Int          @default(0) // FLAT=paisa; PERCENT=basis points
  stockQty          Int? // null = unlimited (gift wrap-এর মতো service কখনো শেষ হয় না)
  isActive          Boolean      @default(true)
  groupLinks        AddOnGroupItem[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
}

/// নামের সেট — "Birthday add-ons"। একবার বানাও, rule দিয়ে বারবার বসাও।
model AddOnGroup {
  id             String           @id @default(cuid())
  name           String
  sortOrder      Int              @default(0)
  items          AddOnGroupItem[]
  rules          AddOnRule[]
  manualProducts Product[]        @relation("ProductManualAddOns")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
}

/// join — একটা add-on অনেক group-এ থাকতে পারে (locked: many-to-many)
model AddOnGroupItem {
  id        String     @id @default(cuid())
  groupId   String
  group     AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addOnId   String
  addOn     AddOn      @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  sortOrder Int        @default(0)

  @@unique([groupId, addOnId])
  @@index([addOnId])
}

/// product-এ হাতে না বসিয়ে নিয়ম লেখো: "occasion = birthday → Birthday add-ons"।
/// values = OR তালিকা। একটা product একাধিক rule-এ পড়লে সব group-ই বসে (union),
/// product page-এ আলাদা tab হয়, একই add-on দুইবার দেখায় না।
model AddOnRule {
  id        String        @id @default(cuid())
  field     AddOnRuleField
  values    String[] // Postgres text[] — যেকোনো একটা মিললেই হবে
  groupId   String
  group     AddOnGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([groupId])
}

enum AddOnRuleField {
  CATEGORY
  OCCASION
  ZONE
  PRODUCT_TYPE
}

/// variant template master — Colour / Flavour / Size / Weight।
/// product upload-এর সময় শুধু select করা হয়, প্রতিবার নতুন করে লেখা লাগে না।
model VariantAttribute {
  id          String         @id @default(cuid())
  name        String         @unique // "Colour" | "Flavour" | "Size"
  displayMode String         @default("SWATCH") // SWATCH | PHOTO | TEXT — কীভাবে দেখাবে
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  values    VariantValue[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
}

/// ── এক product, অনেক variant · DEC-PRD-012, মালিকের সিদ্ধান্ত ১ আগস্ট ২০২৬
///
/// > *"একটা product যদি কোনো variant না থাকে তখন সেখানে আমি কিছুই choose করব
/// > না। যখন তার multi variant থাকবে তখন তা show করাব — আর তা একটা product
/// > page-এ হবে। প্রতিটার আলাদা image আর stock থাকবে।"*
///
/// ⚠️ এটা আগের নকশা বদলে দেয়। আগে ছিল: **প্রতিটা রঙ = আলাদা product**, আর
/// `VariantGroup` দিয়ে তারা বাঁধা থাকত; product page-এ swatch চাপলে অন্য
/// page-এ চলে যেত। সেই নকশার কারণ ছিল ভালো (প্রতি রঙের নিজের stock, নিজের
/// Google page), কিন্তু **জোড়া লাগানোর কোনো পর্দা কখনো বানানো হয়নি** — তাই
/// swatch বাস্তবে কোনোদিন দেখাই যায়নি, আর মালিক ঠিক সেটাই ধরেছেন।
///
/// এখন এক page, তার ভেতরে সব রঙ। মালিক জেনেই বেছেছেন যে Google-এ তিনটার
/// বদলে একটা page যাবে।
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// কোন মান — Variants & options master থেকে (লাল / চকলেট / ২ কেজি)
  variantValueId String
  variantValue   VariantValue @relation(fields: [variantValueId], references: [id])

  /// এই variant-এর নিজের ছবি। খালি হলে product-এর মূল ছবিই থাকে।
  imageUrl String? @db.Text

  /// এই variant-এর নিজের মজুদ — মালিকের স্পষ্ট দাবি। সাদা শেষ হলে লাল
  /// বিক্রি চলতে থাকবে, একই page হলেও।
  ///
  /// ⚠️ এটা **হাতে গোনার** ঘর (Manual)। product-টা Inventory-র সাথে বাঁধা
  /// থাকলে (`Product.stockMode = TRACKED`) এই সংখ্যা পড়া হয় না — তখন
  /// নিচের `itemId` যেটা দেখায় সেই Item-এর গোনাই আসল।
  stockQty Int @default(0)

  /// ── DEC-PRD-015 · কোন Item এই রঙটার মজুদ রাখে ─────────────────────────
  /// মালিক, ২ আগস্ট ২০২৬: *"inventory থেকে যদি আনা লাগে তাহলে stock and
  /// lead time-এ আমরা যেভাবে inventory থেকে product ডেকেছি সেভাবে ডাকবে"*
  ///
  /// stockroom-এ লাল গোলাপ আর গোলাপি গোলাপ আলাদা জিনিস, আলাদা গোনা হয় —
  /// তাই প্রতিটা variant নিজের Item-এর দিকে দেখায়।
  ///
  /// ⚠️ id দিয়ে, SKU লেখা দিয়ে নয় — DEC-ITM-021। `null` = এই রঙের নিজের
  /// Item বাছা হয়নি, তখন product-এর নিজের Item-ই ধরা হয়, যাতে ফাঁক না থাকে।
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id])

  /// ── দাম, আর কেন এটা nullable · মালিকের কথা ─────────────────────────────
  /// > *"same product just color change হলে দাম same থাকবে, আবার kg change
  /// > হলে বা flavour change হলে আলাদা হবে — এটা depend করে product-wise।"*
  ///
  /// তাই দাম **ঐচ্ছিক**। `null` = product-এর মূল দামই চলবে। প্রতিটা রঙে
  /// একই সংখ্যা লিখে রাখলে একদিন একটা বদলাতে ভুলে যাওয়া হতো, আর দুটো দাম
  /// পাশাপাশি বসে থাকত।
  pricePaisa Int?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// Sales references (One Data One Owner) — কোন রঙ কত বিক্রি হলো এখান থেকেই
  orderLines OrderLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([productId, variantValueId])
  @@index([itemId])
  @@index([productId])
  @@index([variantValueId])
}

model VariantValue {
  id          String           @id @default(cuid())
  attributeId String
  attribute   VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  label       String // "Red" | "Chocolate Fudge" | "Large"
  swatch      String? // hex বা gradient (colour/flavour হলে)
  imageUrl    String? @db.Text // PHOTO displayMode — flavour/pattern-এর ছবি
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)

  /// D-CAT-01 — every product that IS this colour. See Product.variantValueId.
  products Product[]

  /// DEC-PRD-012 — এক product-এর ভেতরে এই মানটা যতবার ব্যবহার হয়েছে
  productVariants ProductVariant[]

  @@unique([attributeId, label])
}

model Segment {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  customers Customer[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
}

/// Customer — phone = identity key (WhatsApp OTP, no password), INTERNATIONAL (DEC-CUS-002)
model Customer {
  id               String         @id @default(cuid())
  name             String
  phone            String         @unique // +<country><number>; login identity
  email            String?
  whatsappVerified Boolean        @default(false)
  country          String         @default("Bangladesh") // residence; ≠ Bangladesh হলে NRB
  ownAddressLine   String?
  joinedAt         DateTime       @default(now())
  status           CustomerStatus @default(ACTIVE) // block ≠ delete (DEC-CUS-003)
  note             String?
  avatarBg         String?

  segments   Segment[]
  recipients Recipient[]
  orders     Order[] // Sales references (One Data One Owner)
  returns    SalesReturn[] // DEC-RTN-001 — post-delivery returns
  credits    CustomerCredit[] // DEC-RTN-013 — store-credit wallet ledger
  offerRedemptions OfferRedemption[] // DEC-OFR — per-customer limit counting
  outreaches       Outreach[] // MKT — Marketing owns these, Customer only references
  marketingOptOut  MarketingOptOut? // MKT-RULE-009
  points           LoyaltyPoint[] // MKT-D16 — the one points ledger
  broadcastTargets BroadcastTarget[] // MKT-D18
  referralCode     ReferralCode?
  referralsMade    Referral[] @relation("ReferralsMade")
  referredBy       Referral?  @relation("ReferralReceived")
  conversations    Conversation[] // INB-RULE-007 — Inbox references, never copies

  // ---- OWNED BY SALES (read-only mirror; Customer module কখনো লেখে না) (DEC-CUS-004) ----
  ordersCount  Int       @default(0)
  ltvPaisa     BigInt    @default(0) // cumulative lifetime value — BigInt (future-safe)
  lastOrderAt  DateTime?
  firstOrderAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

/// Recipient book — customer-owned sub-entity (আলাদা Customer নয়) (DEC-CUS-005)
model Recipient {
  id           String       @id @default(cuid())
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  name         String
  phone        String // any country — যাকে contact করা হবে
  relationship Relationship
  zone         DeliveryZone // delivery zone — speed drive করে
  addressLine  String
  note         String?
  isFavorite   Boolean      @default(false)

  occasions RecipientOccasion[]

  // read-only refs — Sales/Delivery owns
  deliveriesCount Int       @default(0)
  lastDeliveryAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
}

enum Relationship {
  mother
  father
  wife
  husband
  partner
  sibling
  friend
  colleague
  self
  other
}

// Dhaka vs rest-of-Bangladesh — delivery speed/matrix drive করে (Order-ও reuse করবে)
enum DeliveryZone {
  DHAKA
  BANGLADESH
  COUNTER // POS walk-in / take-away — no delivery (DEC-POS-001)
}

/// recurring occasion (MM-DD) → reminder। recipient-owned
model RecipientOccasion {
  id          String       @id @default(cuid())
  recipientId String
  recipient   Recipient    @relation(fields: [recipientId], references: [id])
  type        OccasionType
  date        String // "MM-DD" year-less recurring
  label       String? // custom হলে
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([recipientId])
}

enum OccasionType {
  BIRTHDAY
  ANNIVERSARY
  CUSTOM
}

// ============================================================
// SALES MODULE — Online Sales Order (POS = আলাদা module)
// Source: RADIAN_ADMIN_PROGRESS.md §4 (locked Sales decisions)
// ============================================================

/// online sub-channel master — admin-configurable (website/facebook/… + custom) (DEC-SAL-001)
model Channel {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// Online Sales Order। দুই status track (Sales-owned + Delivery-owned) — One Data One Owner।
model Order {
  id       String   @id @default(cuid())
  orderNo  String   @unique // "RAD-58217" — মানুষের রসিদ নম্বর
  placedAt DateTime @default(now())

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id])

  // FK → Customer; sender = frozen রসিদ snapshot (contract) (DEC-SAL-002)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  senderName  String
  senderPhone String
  senderEmail String?

  // fulfillment shape (DEC-POS-001): DELIVERY = online/courier order; COUNTER = POS walk-in.
  // Delivery-only fields (zone/address/method) carry placeholders for COUNTER sales.
  fulfillmentType FulfillmentType @default(DELIVERY)
  branchId        String? // which branch/store fulfilled (DEC-POS-005; soft ref until Branch module)
  posShiftId      String? // POS sale belongs to a cashier shift (DEC-POS-010)
  posShift        PosShift? @relation(fields: [posShiftId], references: [id])

  // self vs gift = order-level attribute (locked)
  isGift              Boolean @default(false)
  recipientName       String?
  recipientPhone      String?
  recipientCustomerId String? // soft link (recipient known customer হলে); snapshot-ই contract
  giftMessage         String?
  anonymousGift       Boolean @default(false)
  photoUpdates        Boolean @default(true)

  // দুই status track (DEC-SAL-003)
  salesStatus    SalesStatus    @default(placed) // Sales-owned
  deliveryStatus DeliveryStatus @default(unassigned) // Delivery-owned

  // delivery info (Delivery execute করে; Sales শুধু reference)
  zone          DeliveryZone
  address       String
  deliveryNotes String?
  methodLabel   String?
  date          String?
  slotLabel     String?
  etaLabel      String?

  /// DEC-INT-003 — when delivery was PROMISED, as a real point in time.
  /// Sales/Delivery own this; Intelligence only reads it.
  /// `date` and `slotLabel` above are text meant to be READ ("10:00–13:00"),
  /// not compared. Parsing them at read time would break silently the day a
  /// slot is renamed, so the promise is frozen here once, at order creation.
  /// On-time is then simply `deliveredAt <= promisedBy`.
  /// Null on every order created before this field existed — those are reported
  /// as UNMEASURABLE, never as late (INT-R09).
  promisedBy    DateTime?

  // DEC-DLV-002 — FK into the Delivery masters; the label/fee SNAPSHOTS above
  // stay the receipt (old orders untouched, method edits never rewrite history)
  deliveryMethodId String?
  deliveryMethod   DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id])
  deliverySlotId   String?
  deliverySlot     DeliverySlot?   @relation(fields: [deliverySlotId], references: [id])
  assignments      DeliveryAssignment[] // DEC-DLV-003 — Delivery owns these

  // courier hand-off — Delivery executes; Sales records the reference so staff
  // can track a parcel without leaving the order (nationwide courier orders)
  courierName        String?
  courierConsignment String? // courier-এর consignment / parcel id
  courierTrackingUrl String?
  courierAssignedAt  DateTime?

  // payment summary (transaction detail = PaymentTransaction) — enum (DEC-SAL-004)
  paymentMethod PaymentMethod @default(online)
  paymentStatus PaymentStatus @default(unpaid)
  paidPaisa     Int           @default(0)
  duePaisa      Int           @default(0)
  refundPaisa   Int           @default(0)

  // money — সব paisa
  subtotalPaisa       Int     @default(0)
  couponCode          String? // applied code snapshot; owner = Pricing module (পরে)
  discountPaisa       Int     @default(0)
  deliveryPaisa       Int     @default(0)
  deliveryWaivedPaisa Int     @default(0)
  adjustmentPaisa     Int     @default(0) // order-level adjustment (edit / POS round-off, audited — DEC-POS-015)
  vatPaisa            Int     @default(0) // POS VAT amount (DEC-POS-016); base = subtotal − discount ± adjustment
  taxRateBps          Int     @default(0) // VAT rate snapshot in basis points (750 = 7.5%) — no float
  totalPaisa          Int     @default(0)

  internalNote String?

  // Finance (DEC-FIN-024) — set once the revenue entry is posted; editing or
  // soft-deleting a stamped order MUST raise an adjusting entry (FIN-RULE-022).
  financePostedAt DateTime?
  /// buyer BIN for a Mushak 6.3 VAT challan (corporate gifting) — DEC-FIN-020
  buyerBin        String?

  // MKT-D02 — raw capture of HOW the order arrived. These are Sales facts, like
  // channelId. Marketing reads them and writes its verdict into OrderAttribution;
  // it never edits these. Empty until the new storefront forwards them.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  refCode     String? // affiliate code as typed/carried (snapshot)

  /// MKT-D21 — loyalty points spent on THIS order, and what they were worth.
  /// A Sales fact, like refCode above: Sales records what settled the bill,
  /// Marketing owns the points ledger behind it. Points are a TENDER, not a
  /// discount — the invoice keeps its full value and VAT is unaffected, which
  /// matters because VAT is the government's money either way.
  pointsUsed  Int @default(0)
  pointsPaisa Int @default(0)

  attribution  OrderAttribution? // MKT — Marketing owns that row, Order only references
  affiliateCommissions AffiliateCommission[]

  lines        OrderLine[]
  transactions PaymentTransaction[]
  photos       OrderPhoto[]
  returns      SalesReturn[] // DEC-RTN-001 — Returns module owns these, Order only references
  redemptions  OfferRedemption[] // DEC-OFR — Offers module owns these, Order only references
  paySessions  PaymentSession[] // storefront online payment attempts (gateway ↔ order)
  messages     OrderMessage[] // এই order নিয়ে গ্রাহককে কী কী পাঠানো হলো
  checkoutLeads CheckoutLead[] // যে অসমাপ্ত checkout থেকে এই order এসেছে

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([channelId])
  @@index([salesStatus])
  @@index([deliveryStatus])
}

/// এক order নিয়ে গ্রাহককে পাঠানো এক বার্তার হিসাব। DEC-WA-002…005।
///
/// ⚠️ কেন আলাদা টেবিল লাগল: আজ পর্যন্ত বার্তা পাঠানো হয় আর ভুলে যাওয়া হয় —
/// `whatsapp-cloud.ts` শুধু true/false ফেরত দেয়, কোথাও লেখা থাকে না। ফলে
/// "গ্রাহক confirmation পেয়েছিলেন কি না" প্রশ্নের উত্তর কারও কাছে নেই, আর
/// "২৪ ঘণ্টা পর আবার পাঠাও" বলার আগে "প্রথমটা গিয়েছিল কি" জানার উপায়ও নেই।
///
/// ⚠️ কেন Marketing-এর `Outreach` নয় (MKT-D07/D18): ওটা broadcast-এর খাতা —
/// opt-out, এক occasion-এ একবার, campaign report। এগুলো রসিদের বার্তা,
/// গ্রাহক নিজে এইমাত্র order দিয়েছেন। দুটো মিলিয়ে ফেললে একদিন opt-out করা
/// গ্রাহকের order confirmation আটকে যেত — অথবা উল্টোটা, তাঁর কাছে promo যেত।
/// একমাত্র ব্যতিক্রম `CHECKOUT_ABANDONED`: Meta ওটাকে Marketing ধরে, তাই
/// পাঠানোর আগে Marketing-এর opt-out তালিকা মানতেই হবে (DEC-WA-004)।
///
/// ⚠️ `@@unique([orderId, kind, attempt])` — এটাই একই বার্তা দুবার যাওয়া
/// ঠেকানোর একমাত্র ভরসা। scheduler একই সারি দুবার তুলতে পারে (deploy-এর
/// সময় দুটো instance, বা retry) — তখন ডেটাবেজ নিজেই না বলবে, কোড নয়।
model OrderMessage {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  kind    OrderMessageKind
  /// ১ = প্রথমবার, ২ = ২৪ ঘণ্টা পরের পুনরাবৃত্তি (DEC-WA-002)
  attempt Int              @default(1)
  /// ⚠️ `NotifyChannel` নয় — ওটায় `OFF` আছে, যেটা supplier-কে জানানোর
  /// সেটিং। পাঠানো বার্তার সারিতে "মাধ্যম = OFF" লেখার কোনো মানে হয় না।
  channel MessageChannel   @default(WHATSAPP)

  status OrderMessageStatus @default(QUEUED)
  /// Meta-র নিজের message id — support-এ "পাঠিয়েছিলাম" প্রমাণ করার একমাত্র সুতো
  providerMessageId String?
  /// ব্যর্থ হলে কেন — গ্রাহককে নয়, আমাদের দেখার জন্য
  error             String?
  /// কোন approved template-এ গেল — নাম বদলালে পুরনো সারির মানে যেন না বদলায়
  templateName      String?

  /// কখন পাঠানোর কথা (ভবিষ্যৎ হতে পারে — ২৪ ঘণ্টা পরেরটা)
  dueAt  DateTime  @default(now())
  sentAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([orderId, kind, attempt])
  @@index([status, dueAt])
  @@index([orderId])
}

enum OrderMessageKind {
  ORDER_CONFIRMATION
  ORDER_CONFIRMATION_COD
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  /// gateway ফেল/বাতিল বলেছে, অথবা গ্রাহক gateway-তে গিয়ে আর ফেরেননি।
  /// দুটোতেই order আছে, শুধু টাকা আসেনি।
  PAYMENT_FAILED
}

/// checkout-এ নাম-নম্বর দিয়েছেন, কিন্তু order **তৈরিই হয়নি**। DEC-WA-004।
///
/// ⚠️ কেন `OrderMessage`-এ নয়: ওখানে `orderId` বাধ্যতামূলক, আর এখানে order
/// বলে কিছু নেই — সেটাই তো ঘটনা। orderId-কে nullable করে দুই রকম সারি এক
/// টেবিলে রাখলে প্রতিটা query-তে "এটা কোন ধরনের সারি" ভাবতে হতো।
///
/// ⚠️ এই টেবিলে এমন মানুষের নম্বর জমা হয় যিনি কখনো কিছু কেনেননি। তাই:
/// (১) পাঠানোর আগে Marketing-এর opt-out তালিকা মানতেই হবে — Meta এটাকে
///     MARKETING template ধরে (DEC-WA-004);
/// (২) সারিগুলো চিরকাল রাখা হবে না — **৯০ দিন** পর নিজে থেকে মুছবে
///     (মালিকের সিদ্ধান্ত ৬ আগস্ট, DEC-WA-008; admin থেকে বদলানো যাবে)।
///     ওই ৯০ দিন এগুলো গ্রাহকে পরিণত করার চেষ্টা চলবে — বার্তা, আর
///     admin-এর তালিকা থেকে staff-এর ফোন।
/// (৩) storefront-এর privacy policy-তে এই সংগ্রহ ও মেয়াদের কথা লেখা থাকতে
///     হবে। কেউ প্রশ্ন করলে উত্তর থাকা দরকার।
///
/// ⚠️ order হয়ে গেলে `orderId` বসে যায় এবং বার্তা আর যায় না। এটাই
/// "১৫ মিনিটের মধ্যে order করে ফেললে বিরক্ত করব না" নিয়মের বাস্তব রূপ।
model CheckoutLead {
  id String @id @default(cuid())

  /// ব্রাউজারের নিজের পরিচয় — একই মানুষ বারবার এলে নতুন সারি যেন না হয়
  clientKey String @unique

  /// খোঁজার মতো ঘরগুলো আলাদা কলামে — staff ফোন নম্বর ধরে খুঁজবে
  name  String?
  phone String?
  email String?

  /*  ⚠️ বাকি সব `draft`-এ, আলাদা ১৫টা কলামে নয়। মালিকের চাওয়া: "customer
      যা-ই type করুক সেটা আমরা নিয়ে নেব"। checkout ফর্ম বদলায় — নতুন ঘর
      যোগ হয়, পুরনোটা যায়। প্রতিটার জন্য কলাম বানালে ফর্ম বদলানো মানেই
      migration, আর একদিন কেউ migration-এর ভয়ে ফর্মটাই ঠিক করবে না।

      ⚠️ যা এখানে কখনো ঢুকবে না: কার্ড নম্বর, CVV, OTP — পেমেন্টের কোনো
      তথ্যই আমাদের পাতায় আসে না, SSLCommerz-এর নিজের পাতায় যায়। এটা
      দুর্ঘটনাক্রমে ঠিক নয়, এভাবেই রাখতে হবে।  */
  draft Json?

  /// কতদূর গিয়েছিলেন — staff-এর কাছে ফোন করার সময় এটাই সবচেয়ে কাজের তথ্য
  stage CheckoutStage @default(CART)

  /// cart-এর ছবি সেই মুহূর্তের — পরে দাম বদলালেও "কী রেখে গিয়েছিলেন" বদলায় না
  cart Json?
  itemCount Int @default(0)
  totalPaisa Int @default(0)

  /// শেষ কবে কিছু করেছেন। ১৫ মিনিট (DEC-WA-004) এখান থেকেই গোনা হয়।
  lastSeenAt DateTime @default(now())

  /// order হয়ে গেছে — তাহলে এটা আর "ছেড়ে যাওয়া" নয়
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  status CheckoutLeadStatus @default(OPEN)
  /// বার্তা পাঠানোর হিসাব। একটাই বার্তা যায়, তাই আলাদা টেবিল লাগে না।
  messageSentAt DateTime?
  messageError  String?
  /// কেন পাঠানো হলো না — opt-out, নম্বর নেই, দোকান বন্ধ। মানুষের পড়ার মতো।
  skipReason    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, lastSeenAt])
  @@index([phone])
  @@index([orderId])
}

/// checkout-এ কতদূর পৌঁছেছিলেন। staff যখন ফোন করবে, "উনি ঠিকানা পর্যন্ত
/// দিয়ে থেমে গেছেন" আর "শুধু cart-এ রেখেছেন" — দুটো সম্পূর্ণ আলাদা কথা।
enum CheckoutStage {
  CART
  DETAILS
  DELIVERY
  PAYMENT
}

enum CheckoutLeadStatus {
  /// এখনো checkout-এ আছেন বা সদ্য গেছেন — ১৫ মিনিট পার হয়নি
  OPEN
  /// order হয়ে গেছে — কিছু পাঠানোর দরকার নেই
  CONVERTED
  /// ১৫ মিনিট পেরিয়েছে, বার্তা পাঠানো হয়েছে
  MESSAGED
  /// পাঠানো হয়নি এবং হবেও না — opt-out, নম্বর নেই, ইত্যাদি
  SKIPPED
}

/// বার্তা কোন পথে গেল। Email এখনো ব্যবহার হয় না, কিন্তু রসিদ email-এ পাঠানো
/// দিনের কাজ — তখন enum বদলাতে migration লাগবে না।
enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum OrderMessageStatus {
  /// পাঠানোর কথা, এখনো পাঠানো হয়নি
  QUEUED
  SENT
  FAILED
  /// পাঠানোর দরকার ফুরিয়ে গেছে — যেমন ২৪ ঘণ্টা পার হওয়ার আগেই টাকা এসে গেছে,
  /// বা গ্রাহক opt-out করা। ব্যর্থতা নয়, তাই আলাদা।
  SKIPPED
}

enum SalesStatus {
  placed
  confirmed
  completed
  cancelled
}

enum DeliveryStatus {
  unassigned
  preparing
  out_for_delivery
  delivered
  failed
  stock_reverted
}

enum PaymentMethod {
  online
  cod
  // POS tenders (DEC-POS-009). `counter` = Order-level summary for a POS sale;
  // cash/bkash/nagad/card = the actual tender on each PaymentTransaction (split).
  counter
  cash
  bkash
  nagad
  card
  bank // DEC-RTN-008 — refund payout channel (bank transfer)
}

enum PaymentStatus {
  unpaid
  advance_paid
  paid
  cod_collected
  partially_refunded
  refunded
}

/// order line — productId FK (One Data One Owner) + frozen name/price snapshot।
/// productType per-line → cancel/refund শাখা (DEC-SAL-005)।
model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  name        String
  bg          String?
  sizeLabel   String?
  bundleLabel String?
  addonLabels String[] // Postgres text[]
  // এই line customer কোন page থেকে যোগ করল — add-on performance এখান থেকেই আসে
  addedFrom   AddedFrom @default(PRODUCT)
  persoText   String?

  /// DEC-PRD-012/014 — কোন রঙ/ফ্লেভার বিক্রি হলো। null = variant নেই।
  ///
  /// ⚠️ যোগ হয়েছে ৩ আগস্ট ২০২৬, একটা আসল গরমিল ধরা পড়ার পর: DEC-PRD-014 বলে
  /// variant থাকলে মজুদ variant-এর ঘরেই, আর সব পর্দা যোগফল দেখায়। কিন্তু
  /// OrderLine জানতই না কোন variant বিক্রি হলো, তাই Preparing-এর stock −qty
  /// product-এর ঘরে কাটত — আর দোকান বিক্রির পরেও পুরনো সংখ্যাই দেখত, চিরকাল।
  /// `variantLabel` snapshot — মালিক রঙটার নাম বদলালেও পুরনো রসিদ বদলায় না।
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  variantLabel String?

  /// কোন কোন AddOn এই line-এ (id-তালিকা) — মালিকের রায়, ৪ আগস্ট ২০২৬:
  /// *"add-এর বিনিময়ে যে টাকা আসবে তার জিনিসটা inventory-তে আছে কিনা দেখে
  /// তবেই sell/process।"* `addonLabels` রসিদের লেখা; এটা মজুদের চাবি —
  /// লেখা দিয়ে stock খোঁজা যায় না, মালিক নাম বদলালেই হারিয়ে যেত।
  addonIds String[] @default([])

  productType ProductType // per-line readymade/crafted (reuse enum)
  qty         Int
  unitPaisa   Int
  linePaisa   Int
  discountPaisa Int     @default(0) // per-line discount (edit, audited)
  refundPaisa Int? // cancel-এ per-line refund (readymade full, crafted advance forfeit)
  refundNote  String?

  returnLines SalesReturnLine[] // DEC-RTN-002 — post-delivery returns reference this line

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
  @@index([productId])
}

enum AddedFrom {
  PRODUCT
  CART
  CHECKOUT
}

/// টাকা collection/refund record (Radian রাখে); ledger = Finance-owned (পরে, completed event) (DEC-SAL-006)
model PaymentTransaction {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  kind        PaymentTxnKind // ADVANCE | PAYMENT | COD_COLLECTED | REFUND
  method      PaymentMethod
  amountPaisa Int
  reference   String?
  note        String?
  actorName   String
  financePostedAt DateTime? // DEC-FIN-024
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  @@index([orderId])
}

enum PaymentTxnKind {
  ADVANCE
  PAYMENT
  COD_COLLECTED
  REFUND
}

enum PaymentSessionStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

/// storefront-এর online payment attempt — gateway আর order-এর মাঝের সেতু।
///
/// ⚠️ কেন `PaymentTransaction`-ই যথেষ্ট নয়: ওটা **টাকা এসেছে** তার রেকর্ড,
/// আর সেটা লেখা হয় সব যাচাই শেষ হওয়ার পর। এই সারিটা তার আগের ধাপ — গ্রাহক
/// gateway-তে গেছেন, কিন্তু টাকা এসেছে কি না জানা নেই। দুটো এক টেবিলে
/// রাখলে অসফল চেষ্টাও আয় হিসেবে গোনা হতো।
///
/// ⚠️ `amountPaisa` এখানে জমা থাকে ইচ্ছাকৃতভাবে। gateway ফেরত এলে তার বলা
/// টাকার সাথে **এই** সংখ্যাটা মেলানো হয়, order-এর চলতি total-এর সাথে নয় —
/// নইলে গ্রাহক gateway-তে থাকা অবস্থায় admin order edit করলে কম টাকায়
/// order paid হয়ে যেত।
model PaymentSession {
  id       String @id @default(cuid())
  /// gateway-কে পাঠানো tran_id — আমাদের দিক থেকে unique, তাই replay ধরা পড়ে
  tranId   String @unique
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id])

  provider    String               @default("SSLCOMMERZ")
  amountPaisa Int
  status      PaymentSessionStatus @default(INITIATED)

  /// gateway-এর নিজের রেফারেন্স — মিলিয়ে দেখার সময় support এটাই খোঁজে
  valId       String?
  bankTranId  String?
  cardType    String?
  /// callback/IPN-এর কাঁচা payload — dispute হলে এটাই একমাত্র প্রমাণ
  raw         Json?
  settledAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
  @@index([status])
}

/// proof photo — Delivery-owned (kitchen prep + rider handover); Sales শুধু দেখায় (DEC-SAL-007)
model OrderPhoto {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id])
  kind       OrderPhotoKind // PREP | DELIVERY
  url        String? // Cloudinary পরে
  bg         String? // gradient stand-in
  caption    String?
  capturedBy String?
  capturedAt DateTime       @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
}

enum OrderPhotoKind {
  PREP
  DELIVERY
}

// ============================================================================
//  RETURNS & REFUNDS  —  Commerce
//  Full reasoning: RADIAN_RETURNS_MODULE_ARCHITECTURE.md (locked 23 Jul 2026, sobuj)
//  DEC-RTN-005…015. Post-delivery grievance → resolution. Owns Return/Refund
//  entities (DEC-RTN-001..004, supersedes Sales SM-RULE-007). NEVER mutates
//  Order.salesStatus (One Data One Owner). Refund payout ≤ collected (Sales
//  review principle #1). Stock restock ONLY via InventoryService SALE_RETURN
//  (INV-RULE-001) — "Stock Reverted" (Delivery) is a distinct concept, not merged.
// ============================================================================

enum ReturnStatus {
  draft // being built, nothing executed
  pending_approval // needs staff/manager approval (perishable/crafted or over threshold)
  approved // cleared, ready to complete
  completed // refund/credit/restock executed
  rejected // approval denied
  cancelled // voided before completion
}

/// DEC-RTN-006 — what the customer gets. Exchange deferred (redeliver + new order covers it).
enum ReturnResolution {
  REFUND // money back
  REPLACEMENT // redeliver same goods (money untouched)
  PARTIAL_COMPENSATION // customer keeps goods, gets partial money/credit back
  STORE_CREDIT // credit to CustomerCredit wallet instead of cash
}

/// DEC-RTN-007 — per line: does the physical item come back to sellable stock?
enum ReturnRestockAction {
  RESTOCK // +stock via SALE_RETURN movement
  WRITE_OFF // goods discarded / perishable — no stock change (default for perishable)
}

/// DEC-RTN-008 — admin-configurable per reason. ORIGINAL = same channel it came in on.
enum ReturnRefundMethod {
  CASH
  BKASH
  NAGAD
  CARD
  BANK
  ORIGINAL
  STORE_CREDIT
}

enum CustomerCreditKind {
  ISSUED // + credit granted (from a return)
  CONSUMED // − credit spent on a future order
  ADJUSTMENT // manual correction (audited)
}

/// DEC-RTN-009 — reason master. requiresApproval + defaultRefundMethod per reason
/// (locked: refund method admin-configurable per return reason).
model ReturnReason {
  id                  String             @id @default(cuid())
  code                String             @unique // RSN-DAMAGED, RSN-WRONG_ITEM …
  label               String
  requiresApproval    Boolean            @default(false)
  defaultRefundMethod ReturnRefundMethod @default(ORIGINAL)
  isActive            Boolean            @default(true)
  sortOrder           Int                @default(0)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  returns   SalesReturn[]
}

/// DEC-RTN-005 — the return document. Sequential returnNo (D8 lesson).
model SalesReturn {
  id       String @id @default(cuid())
  returnNo String @unique // RTN-000001 (DEC-RTN-010)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  reasonId   String?
  reason     ReturnReason? @relation(fields: [reasonId], references: [id])
  reasonNote String?

  resolution ReturnResolution @default(REFUND)
  status     ReturnStatus     @default(draft)

  // approval (DEC-RTN-012) — any staff for now; role-gating wired when Roles module lands
  approvedBy String?
  approvedAt DateTime?

  // money — all paisa
  returnValuePaisa  Int @default(0) // Σ line values (goods value being returned)
  refundPaisa       Int @default(0) // actual cash paid back (≤ collected)
  storeCreditPaisa  Int @default(0) // credit issued instead of cash
  compensationPaisa Int @default(0) // partial compensation payout (goods kept)

  refundMethod    ReturnRefundMethod @default(ORIGINAL)
  refundReference String? // bKash txn / bank ref

  actorName String
  note      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lines SalesReturnLine[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model SalesReturnLine {
  id       String      @id @default(cuid())
  returnId String
  return   SalesReturn @relation(fields: [returnId], references: [id])

  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])

  productId String // snapshot ref (Product owner unchanged)
  name      String // frozen snapshot
  qty       Int
  unitPaisa Int
  valuePaisa Int

  restockAction ReturnRestockAction @default(WRITE_OFF)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([returnId])
  @@index([orderLineId])
}

/// DEC-RTN-013 — customer store-credit ledger, mirrors SupplierCredit shape.
/// Balance = Σ amountPaisa (ISSUED +, CONSUMED −). Consumed on a future order.
model CustomerCredit {
  id          String             @id @default(cuid())
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id])
  kind        CustomerCreditKind
  amountPaisa Int // + issued, − consumed
  refType     String? // 'RETURN' | 'ORDER'
  refId       String?
  note        String?
  actorName   String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([customerId])
}

/// DEC-RTN-014 — singleton settings. Return window + approval threshold.
model ReturnSetting {
  id                       String   @id @default("singleton")
  returnWindowDays         Int      @default(0) // 0 = off (staff discretion); past window = warn, never block
  approvalThresholdPaisa   Int      @default(0) // 0 = off; refund value ≥ this ⇒ needs approval
  restockDefaultPerishable Boolean  @default(false) // perishable/crafted default = WRITE_OFF
  updatedAt                DateTime @updatedAt
}

// ============================================================================
//  ITEM MANAGEMENT  —  Master Data
//  Full reasoning: RADIAN_ITEM_MODULE_ARCHITECTURE.md (locked 21 Jul 2026, sobuj)
//
//  THE MODEL (owner's words): everything Radian handles is an Item. Several Items
//  together can also form ONE Item (a finished bouquet). A Product always points at
//  exactly one Item — so Product and Inventory never branch on readymade/crafted;
//  all assembly complexity is contained here.
//
//  BOUNDARY — this module does NOT own:
//    stock quantities / warehouses  → Inventory (not built yet, DEC-ITM-005)
//    selling price / PDP / SEO      → Product
//    supplier + purchase price      → Purchase
//    unit definitions               → Unit master
// ============================================================================

/// DEC-ITM-001 — SEMI_FINISHED deliberately absent: Radian assembles, it does not
/// manufacture (core_principles) and Manufacturing is not a locked module. Adding an
/// enum value later is a non-breaking migration.
enum ItemType {
  RAW // rose stem, lily, foliage — consumed to build something
  FINISHED // sold as-is (teddy) OR assembled from a recipe (bouquet)
  PACKAGING // box, ribbon, wrapping paper
  CONSUMABLE // glue, tape, pins — used up, never sold
  SERVICE // gift wrapping, card writing — nothing physical to store
}

/// DEC-ITM-004 — Radian does BOTH patterns, so this is per-item, not global.
enum AssemblyMode {
  NONE // simple purchased item, no recipe
  MAKE_TO_ORDER // fresh bouquets: NO own stock. Availability = min(component stock / qty).
  //               On order "preparing", the COMPONENTS deduct.
  MAKE_TO_STOCK // pre-assembled gift boxes: HAS own stock. An assembly event consumes
  //               components and adds finished units; the FINISHED item deducts on order.
}

/// DEC-ITM-008
enum CostMode {
  AUTO // rolled up from the recipe — rose price rises, margin follows
  MANUAL // staff-entered (covers labour / wastage the recipe does not model)
}

/// DEC-ITM-007 (rev 21 Jul, sobuj) — the Item module's OWN category tree.
/// Deliberately NOT the storefront `Category` model: that one exists for eCommerce and
/// carries slug / metaTitle / OG tags / showOnNavbar / banner. This one is the
/// stockroom's own vocabulary ("Fresh Flowers -> Roses") and must never reach the site
/// navigation or the sitemap. Two trees, two owners, on purpose.
///
/// It is also the VARIANT FAMILY: Red Rose, Yellow Rose and White Rose are three
/// separate Items that all sit in the "Roses" category (DEC-ITM-016).
model ItemCategory {
  id        String         @id @default(cuid())
  name      String
  parentId  String?
  parent    ItemCategory?  @relation("ItemCategoryTree", fields: [parentId], references: [id])
  children  ItemCategory[] @relation("ItemCategoryTree")
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  items     Item[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  @@index([parentId])
}

/// DEC-ITM-015 (rev 21 Jul, sobuj) — the Item module's OWN attribute master.
///
/// WHY NOT REUSE `VariantAttribute`: that master is storefront-facing — it drives the
/// option pickers on a product page, it has a display mode (SWATCH / PHOTO / TEXT), and
/// marketing renames its values freely ("Red" -> "Passion Red") to sell better. The
/// warehouse cannot have its labels renamed by a marketing decision. Same word, two
/// different things, therefore two masters (owner's call, and the correct reading of
/// One Data One Owner: one ENTITY one owner, and these are two entities).
model ItemAttribute {
  id        String              @id @default(cuid())
  name      String              @unique // "Colour", "Size", "Grade"
  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)
  values    ItemAttributeValue[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?
}

model ItemAttributeValue {
  id          String        @id @default(cuid())
  attributeId String
  attribute   ItemAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  label       String // "Red", "Large", "A-grade"
  swatch      String? // hex — purely so the admin list is scannable
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  items       Item[]        @relation("ItemAttributeValues")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@unique([attributeId, label])
  @@index([attributeId])
}

/// The single master for every physical or service thing Radian handles.
model Item {
  id String @id @default(cuid())

  /// ⚠️ DEC-ITM-021 (21 Jul, owner's ruling) SUPERSEDES DEC-ITM-010's "one SKU
  /// everywhere". There are TWO codes on purpose:
  ///   · Item.sku    = the STOCKROOM code — Inventory, Purchase, packing slips
  ///   · Product.sku = the ECOMMERCE code — storefront, data layer, marketing feeds
  /// They are joined by Product.itemId (FK) and NEVER by matching SKU text.
  /// DEC-ITM-010 — THE one SKU in the system. Product, Sales, phone orders, packing
  /// slips, Purchase and Inventory all read this same value. `Product.sku` is
  /// deprecated and gets folded into this by the generator.
  sku  String @unique
  name String

  /// DEC-ITM-017 — TWO columns on purpose.
  /// `itemType` is the BEHAVIOUR backbone: every business rule in this module branches
  /// on it, so it stays a fixed enum and nobody can invent a sixth behaviour by typing.
  /// `itemTypeId` is the LABEL the owner sees and may create himself ("Dry Flower",
  /// "Imported Chocolate") — each custom label picks one of the five behaviours.
  itemType   ItemType // DEC-ITM-001
  itemTypeId String?
  typeRef    ItemTypeMaster? @relation(fields: [itemTypeId], references: [id])

  /// DEC-ITM-020 — which family this item was generated into, or null for a standalone.
  ///
  /// WHY IT HAD TO EXIST (bug found by the owner, 21 Jul): the list was calling anything
  /// with a Colour or Size label a "variant". That is wrong — a single Item is SUPPOSED
  /// to carry labels ("Red Rose" is one item whose colour is red, DEC-ITM-015). With no
  /// parent record (DEC-ITM-016, still correct) there was nothing in the data that said
  /// "these three were made together", so the screen guessed, and guessed wrong.
  ///
  /// This is a LABEL, not a parent: no row, no foreign key, nothing to keep in step.
  /// Only the variant generator writes it. Deleting one member does not touch the rest.
  familyKey String?

  itemCategoryId String?
  itemCategory   ItemCategory? @relation(fields: [itemCategoryId], references: [id])
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id])

  /// DEC-SUP-004 — primary/usual supplier of this item (nullable, additive).
  /// For fulfillment-vendor items this labels WHOSE product it is on the website;
  /// for stocked items it is the usual reorder source. Supplier module owns the
  /// Supplier table; this is a reference only (One Data One Owner).
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  /// DEC-ITM-006 — REQUIRED (unlike Product.unitId which is cosmetic). Without a unit
  /// both stock and cost are meaningless.
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  /// DEC-ITM-012 — ONE identification photo, so staff recognise a thing at a glance
  /// instead of reading "Artificial Gypsy" and guessing. Deliberately singular: the
  /// marketing GALLERY belongs to Product (One Data One Owner). This is the warehouse
  /// mugshot. Data URL interim (same as Brand.logoUrl), downscaled to 256px on upload;
  /// moves to Cloudinary/media library later.
  imageUrl String? @db.Text

  /// forced false for SERVICE (ITM-R04). Inventory will read this to decide what it tracks.
  isStockTracked Boolean      @default(true)
  assemblyMode   AssemblyMode @default(NONE) // DEC-ITM-004

  /// DEC-ITM-013 — behaviour flags, learned from the Biznify audit (21 Jul). These are
  /// NOT derivable from itemType: a rose stem is purchasable but never sold on its own;
  /// gift wrapping is sold but never purchased; fresh flowers can never come back.
  isSaleable    Boolean @default(true) // may appear on a Product / be sold directly
  isPurchasable Boolean @default(true) // we can raise a purchase order for it
  isReturnable  Boolean @default(true) // Returns module may accept it back

  /// DEC-ITM-014 — courier pricing in Bangladesh is by weight. Without this the
  /// Delivery module cannot quote a real shipping cost. Grams, integer (no floats).
  weightGram Int?

  // ---- cost (DEC-ITM-008) — a REFERENCE/standard cost only.
  // Real moving/FIFO valuation arrives with Inventory and supersedes this for accounting.
  costMode          CostMode @default(MANUAL)
  standardCostPaisa Int      @default(0) // manual entry — paisa, never float
  computedCostPaisa Int? // rolled up from the recipe; null when there is no recipe

  /// DEC-ITM-018 — Item owns the BUY side and the FLOOR. It does NOT own the selling
  /// price (owner's ruling, 21 Jul): one price in two places drifts. Product / POS set
  /// the real price and must not go under floor = purchase rate + minimum profit.
  /// Exactly one of the two margin columns is used; percent wins if both are set.
  minMarginBp    Int? // minimum profit as basis points (1500 = 15%)
  minMarginPaisa Int? // …or as a flat taka amount, in paisa

  /// DEC-ITM-019 — tax and discount DEFAULTS live with the thing being sold, because
  /// they are properties of the thing (a cake is not taxed like a bouquet). The Sales
  /// module reads these as the starting figure; the rate actually charged is stamped on
  /// the order line so a later rate change never rewrites history.
  vatRateBp     Int? // e.g. 750 = 7.5% VAT
  maxDiscountBp Int? // the most any seller may knock off, 0 = no discount allowed

  // ---- perishability: placeholders now; batch/lot/expiry belongs to Inventory
  isPerishable  Boolean @default(false)
  shelfLifeDays Int?

  /// DEC-INV-007 — flowers get NO expiry (weather/care dependent; rot = WASTAGE flow).
  /// Only items with a REAL printed expiry date (chocolate etc.) set this true:
  /// purchase receive then asks an expiry date → ItemExpiryLot, FEFO count-down,
  /// "expiring soon" report. Money stays AVCO — lots are counts, not valuation.
  trackExpiry Boolean @default(false)

  /// advisory only until Inventory exists — nothing enforces it yet
  reorderLevel Int?
  description  String? @db.Text

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete only (core_principles)

  components ItemComponent[] @relation("ItemRecipe") // what THIS item is made of
  usedIn     ItemComponent[] @relation("ItemUsedIn") // recipes THIS item appears in
  products   Product[] // DEC-ITM-002 — many Products may share one Item
  productVariants ProductVariant[] // DEC-PRD-015 — এক রঙ, এক Item
  purchaseLines PurchaseLine[] // DEC-PUR-009 — purchase history of this item

  // ---- Inventory module back-relations (DEC-INV-001…015). Item still owns NO quantity;
  // these exist only so Prisma can join. Stock's one owner is Inventory (DEC-ITM-005).
  stocks         InventoryStock[]
  movements      InventoryMovement[]
  transferLines  StockTransferLine[]
  issueLines     StockIssueLine[]
  stocktakeLines StocktakeLine[]
  expiryLots     ItemExpiryLot[]

  // ---- Assembly module v2 back-relations (DEC-ASM-011…016). Joins only.
  asmTemplateLines   AssemblyTemplateLine[]   @relation("AsmTemplateComponent")
  asmProductionLines AssemblyProductionLine[] @relation("AsmProductionComponent")
  asmProductions     AssemblyProduction[]     @relation("AsmProductionTarget")

  /// DEC-ITM-015 — the Item module's OWN Colour/Size labels (never the storefront ones).
  /// DEC-ITM-016: these say WHICH variant this item is. "Red Rose" and "White Rose"
  /// stay two separate Items (separate stock, separate cost, bought separately); the
  /// ItemCategory is the family and these labels tell them apart.
  attributeValues ItemAttributeValue[] @relation("ItemAttributeValues")

  // ⚠️ DEC-ITM-005: NO stock field here, on purpose. Warehouse/Branch and Inventory do
  // not exist yet; a quantity stored here would become a second owner the moment they
  // do — the exact mistake this module exists to fix. Product.stockQty and the live
  // DEC-MOD-003 deduction stay untouched until the Inventory phase.
  //
  // CONFIRMED BY OWNER 21 Jul: the Item SCREEN will show a stock figure, but it is
  // READ ONLY and PULLED from Inventory (`InventoryStock` per item per warehouse) —
  // Item never stores it. For a MAKE_TO_ORDER item there is no own stock at all; the
  // screen will show "how many we could build" = min(component stock ÷ qty).

  @@index([itemType])
  @@index([itemTypeId])
  @@index([familyKey])
  @@index([itemCategoryId])
  @@index([isActive])
  @@index([supplierId])
}

/// DEC-ITM-017 — the owner's own vocabulary for item types.
/// Five rows are seeded with isSystem = true and can never be deleted or have their
/// behaviour changed; they are what the business rules stand on. Everything the owner
/// adds on top is a label that borrows one of those five behaviours.
model ItemTypeMaster {
  id        String   @id @default(cuid())
  name      String   @unique // what the owner sees: "Raw material", "Dry Flower"
  behaviour ItemType // which of the five it acts like
  isSystem  Boolean  @default(false) // true = seeded, undeletable
  colour    String? // hex for the chip, so custom types look like the built-ins
  sortOrder Int      @default(0)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items Item[]

  @@index([behaviour])
  @@index([isActive])
}

/// One recipe line of a FINISHED item (DEC-ITM-003). Composition lives on Item, not on
/// Product, so one recipe can back several marketing Products (normal / Valentine /
/// corporate) and stay correct in all of them.
model ItemComponent {
  id              String @id @default(cuid())
  parentItemId    String
  parentItem      Item   @relation("ItemRecipe", fields: [parentItemId], references: [id])
  componentItemId String
  componentItem   Item   @relation("ItemUsedIn", fields: [componentItemId], references: [id])

  /// integer-safe quantity in THOUSANDTHS — 24 stems = 24000, 0.5 kg = 500.
  /// Same discipline as paisa: no floats anywhere in the money/quantity path.
  qtyMilli Int
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id])

  /// basis points — 500 = 5% wastage. Integer, never a float.
  wastageBp  Int     @default(0)
  isOptional Boolean @default(false)

  /// marketing override for the PDP "What's inside" line (DEC-ITM-011 phase 2).
  /// null → render from componentItem.name + qty + unit.
  displayText String?
  sortOrder   Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentItemId])
  @@index([componentItemId])
}

// ============================================================
// PURCHASE MODULE — RADIAN_PURCHASE_MODULE_ARCHITECTURE.md (locked 22 Jul 2026)
// DEC-PUR-001..009. Purchase NEVER writes stock (DEC-PUR-002).
// Supplier is free text until the Supplier module exists (DEC-PUR-003).
// ============================================================

/// DEC-PUR-001 — one entity, whole lifecycle. Quick market buys are created directly
/// in RECEIVED; paying an advance first creates ADVANCE_PAID. ORDERED exists for the
/// future Requisition/Order stage (trigger: first branch OR a second buying
/// decision-maker) — it has NO UI today, on purpose (0 POs in 1.5y of Biznify data).
enum PurchaseStatus {
  ORDERED // committed, nothing paid, nothing received — future stage, no UI yet
  ADVANCE_PAID // money went out before goods (Valentine bulk advances)
  RECEIVED // goods in hand — the normal terminal state
  CANCELLED // only from ORDERED/ADVANCE_PAID with zero receipts (PUR-R06)
}

/// DEC-PUR-004 — enum for now; becomes a Finance-owned master when Finance locks.
enum PayMethod {
  CASH
  BKASH
  NAGAD
  BANK
  CARD
  OTHER
}

model Purchase {
  id String @id @default(cuid())

  /// DEC-PUR-008 — sequential (PUR-000001), unlike Sales' random RAD-xxxxx (D8 lesson)
  purchaseNo String         @unique
  status     PurchaseStatus @default(RECEIVED)

  /// DEC-PUR-003 — free text ("Kamal Mama", "Shahbagh bazar"). Since the Supplier
  /// module (DEC-SUP-007), supplierId FK is the link and supplierName stays as the
  /// SNAPSHOT taken at entry time. Legacy rows link via the Settings link tool.
  supplierName  String
  supplierPhone String?
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  purchaseDate      DateTime
  receivedAt        DateTime?
  supplierReceiptNo String? // their invoice/chalan number
  attachmentUrl     String?   @db.Text // receipt photo — data URL interim, like Item.imageUrl
  notes             String?   @db.Text

  subTotalPaisa   Int @default(0)
  discountPaisa   Int @default(0)
  /// rounding / bargain adjustment, may be NEGATIVE (৳39,920 → ৳39,900) or positive
  /// (৳34,790 → ৳34,800). The owner's real bills adjust to a round figure constantly.
  adjustmentPaisa Int @default(0)
  grandTotalPaisa Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete only (core_principles)

  lines    PurchaseLine[]
  payments PurchasePayment[]
  returns  PurchaseReturn[]

  @@index([status])
  @@index([supplierName])
  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  /// DEC-PUR-009 — always the FK, never SKU text (DEC-ITM-021); item must be
  /// isPurchasable (DEC-ITM-013). Enforced in service (PUR-R02).
  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  /// DEC-PUR-009 — the unit's resolved rootFactor COPIED at entry time. If someone
  /// later edits Unit.baseQty, history must not silently re-interpret how much was
  /// bought (same discipline flagged for OrderLine in RADIAN_UOM_OWNERSHIP_RULING §5).
  factorSnapshot Int @default(1)

  qtyMilli         Int // thousandths — 24 stems = 24000
  receivedQtyMilli Int @default(0) // partial receive (80 of 100 teddies)
  unitPricePaisa   Int
  lineTotalPaisa   Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  returnLines PurchaseReturnLine[]

  @@index([purchaseId])
  @@index([itemId])
}

/// DEC-PUR-004 — one purchase, many payments (advance + receive-day + instalments).
/// paid/due are DERIVED (Σ payments vs grandTotal) — never stored twice.
model PurchasePayment {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  amountPaisa Int
  method      PayMethod
  paidAt      DateTime  @default(now())
  note        String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([purchaseId])
}

/// DEC-PUR-006 — goods back to the supplier. Money NEVER comes back as cash:
/// settlement cuts this purchase's remaining due first; any excess becomes a
/// SupplierCredit to adjust against a future purchase. Partial returns allowed.
model PurchaseReturn {
  id         String   @id @default(cuid())
  returnNo   String   @unique // PRT-000001
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  returnDate DateTime @default(now())
  reason     String?

  totalPaisa  Int @default(0)
  dueCutPaisa Int @default(0) // portion settled against this purchase's due
  creditPaisa Int @default(0) // excess → SupplierCredit row

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  lines PurchaseReturnLine[]

  @@index([purchaseId])
}

model PurchaseReturnLine {
  id       String         @id @default(cuid())
  returnId String
  return   PurchaseReturn @relation(fields: [returnId], references: [id])

  purchaseLineId String
  purchaseLine   PurchaseLine @relation(fields: [purchaseLineId], references: [id])

  qtyMilli   Int // ≤ received − already returned (PUR-R08)
  valuePaisa Int

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([returnId])
}

/// DEC-PUR-006 — credit we hold with a supplier after an over-paid return.
/// Keyed by supplierName until DEC-PUR-003's FK exists; consolidated when the
/// Supplier module lands.
model SupplierCredit {
  id           String @id @default(cuid())
  supplierName String
  /// DEC-SUP-007 — FK since the Supplier module; name kept as snapshot/legacy key.
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  amountPaisa  Int // positive = they owe us goods/adjustment

  sourceReturnId    String?
  appliedPurchaseId String? // set when consumed against a later purchase
  /// review fix (23 Jul) — credit consumed via the apply-credit flow (SUP-R11):
  /// a negative SupplierAdjustment settles the due; this stamps the consumption.
  appliedAt         DateTime?
  note              String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([supplierName])
  @@index([supplierId])
}

// ============================================================================
// SUPPLIER MODULE — RADIAN_SUPPLIER_MODULE_ARCHITECTURE.md (locked 23 Jul 2026)
// DEC-SUP-001..008. Master-data owner of every party Radian pays.
// Supplier module never writes stock (SUP-R09).
// ============================================================================

enum SupplierStatus {
  ACTIVE
  INACTIVE // hide from pickers, keep history — DEC-CUS-003 pattern
}

/// DEC-SUP-003 — how order notifications reach this vendor. WhatsApp works today
/// (wa.me links, manual); SMS waits for a gateway (Automation D7 / F11).
enum NotifyChannel {
  WHATSAPP
  SMS
  OFF
}

enum NotifyMode {
  MANUAL // one-click send from the supplier/order page — the only mode until a gateway exists
  AUTO // Automation D7 sends on order event (F11)
}

/// DEC-SUP-001 — admin-configurable master, NOT an enum.
/// Seeded: "Product Supplier" (buy → stock), "Fulfillment Vendor" (cake-type,
/// sourced per order, no stock held).
/// DEC-SUP-009 — label vs behaviour, same discipline as ItemTypeMaster
/// (DEC-ITM-017): `name` is the label the owner may invent; `isFulfillment`
/// is the BEHAVIOUR the UI branches on (vendor workspace vs supplier book).
model SupplierType {
  id            String  @id @default(cuid())
  name          String  @unique
  sortOrder     Int     @default(0)
  isSystem      Boolean @default(false) // seeded rows can't be deleted
  isFulfillment Boolean @default(false) // true → lives in the Vendors workspace

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  suppliers Supplier[]
}

model Supplier {
  id String @id @default(cuid())

  /// SUP-R08 — sequential, human-readable (SUP-000001)
  supplierNo String @unique

  name     String // required — the only mandatory field besides type (SUP-R01)
  nickname String? // "Kamal Mama" — searchable alias
  typeId   String
  type     SupplierType @relation(fields: [typeId], references: [id])

  /// duplicate-warn, never block (SUP-R01) — one phone can serve two market stalls
  phone         String?
  contactPerson String?
  market        String? // "Shahbagh flower market"
  address       String?
  photoUrl      String? @db.Text // data URL interim, same as Item.imageUrl

  /// informational only — owner: per-order pay AND monthly settle both happen
  paymentTerms String?
  /// bKash/Nagad/bank number — at hand when sending money
  payoutInfo   String?

  // ---- DEC-SUP-003 notification data hooks (sending flow = F11) ----
  notifyPhone   String?
  notifyChannel NotifyChannel @default(OFF)
  notifyMode    NotifyMode    @default(MANUAL)
  /// cake needs 4h notice — drives ready-by time in messages; later the
  /// website's "order X hours ahead"
  leadTimeHours Int?

  notes  String?        @db.Text
  status SupplierStatus @default(ACTIVE)

  // ---- DEC-SUP-005 opening due — one figure, immutable once set (SUP-R04);
  // corrections go through SupplierAdjustment rows
  openingDuePaisa Int       @default(0)
  openingAsOf     DateTime?
  openingNote     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete only (SUP-R02)

  purchases   Purchase[]
  credits     SupplierCredit[]
  payments    SupplierPayment[]
  adjustments SupplierAdjustment[]
  items       Item[] // DEC-SUP-004 — items this supplier supplies
  /// listings this vendor makes on order — nothing of ours is stocked for them
  /// (owner's ruling, 1 Aug 2026). Separate from `items` on purpose: that one
  /// is "we buy this from them", this one is "they make this for a customer".
  vendorProducts Product[] @relation("VendorProducts")

  @@index([status])
  @@index([typeId])
  @@index([name])
}

/// DEC-SUP-006 — "paid Kamal Mama 5000 today". Auto-allocated oldest-first
/// (opening due, then purchases by date), hand-adjustable at confirm. Each
/// purchase allocation materialises a real PurchasePayment row (SUP-R06), so
/// the per-bill book (DEC-PUR-004) stays the truth. Excess → SupplierCredit.
model SupplierPayment {
  id         String   @id @default(cuid())
  paymentNo  String   @unique // SPY-000001
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  amountPaisa Int
  method      PayMethod
  paidAt      DateTime  @default(now())
  note        String?

  financePostedAt DateTime? // DEC-FIN-024 (posting source of truth — DEC-FIN-022)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  allocations SupplierPaymentAllocation[]

  @@index([supplierId])
}

model SupplierPaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id])

  /// null = allocated against the opening due
  purchaseId        String?
  /// the PurchasePayment row this allocation created (traceability, SUP-R06)
  purchasePaymentId String?
  amountPaisa       Int

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([purchaseId])
}

/// DEC-SUP-005 — signed correction entries (opening-due fixes etc.).
/// Positive = due increases, negative = due decreases. Audit stays clean.
model SupplierAdjustment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  amountPaisa Int // signed
  note        String
  adjustedAt  DateTime @default(now())

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([supplierId])
}

// ============================================================================
// INVENTORY MODULE — RADIAN_INVENTORY_MODULE_ARCHITECTURE.md (locked 22 Jul 2026)
// DEC-INV-001 ledger + cached balance · DEC-INV-012 immutable ledger ·
// DEC-INV-013 one AVCO per item · DEC-PUR-002 Purchase never writes stock —
// Inventory consumes receive events. NO code path outside InventoryService may
// write InventoryStock (INV-RULE-001).
// ============================================================================

/// DEC-INV-002 — all reasons exist from day 1; SALE_RETURN is enum-only until
/// the Returns & Refunds module ships. GIFT is separate from ADJUSTMENT so the
/// monthly "কত টাকার মাল ফ্রি গেল" report exists.
/// DEC-ASM-007 — ASSEMBLY (build: components OUT + finished IN) and UNBUILD
/// (dismantle: finished OUT + components IN) added by the Assembly module.
/// Enum ADDITION is a non-breaking migration; flagged to the architecture project.
enum MovementReason {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  TRANSFER
  WASTAGE
  ADJUSTMENT
  GIFT
  ASSEMBLY
  UNBUILD
}

enum IssueKind {
  WASTAGE
  GIFT
}

/// DEC-INV-011 — ALLOW_WARN locked: deductions never block a live order.
enum NegativeStockPolicy {
  ALLOW_WARN
  BLOCK
}

/// DEC-INV-014 — minimal on purpose. The Warehouse module (Master Data) is the
/// rightful owner and adopts this table when designed — never create a second one.
/// Seeded: SHOP (Shop) · STORE (Storeroom). Future branch = just a new row.
model Warehouse {
  id       String  @id @default(cuid())
  code     String  @unique // SHOP · STORE
  name     String // English — UI rule: চ্যাটে বাংলা, UI/data English
  address  String?
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stocks    InventoryStock[]
  movements InventoryMovement[]
}

/// DEC-INV-001 — cached balance per item×warehouse, updated in the SAME
/// transaction as the ledger row. Read-optimised mirror of the ledger; the
/// ledger is the truth.
model InventoryStock {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  qtyMilli    Int       @default(0) // may go negative (DEC-INV-011 ALLOW_WARN)
  updatedAt   DateTime  @updatedAt

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
}

/// DEC-INV-012 — IMMUTABLE. No update/delete endpoint exists; corrections are
/// reversal rows (reversesId). No soft-delete either — an editable ledger is
/// not a ledger.
model InventoryMovement {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  reason        MovementReason
  qtyMilli      Int // signed: stock-in positive, stock-out negative
  unitCostPaisa Int @default(0) // AVCO at post time (PURCHASE: actual price)
  valuePaisa    Int @default(0) // qtyMilli × unitCostPaisa ÷ 1000, signed

  refType    String? // PURCHASE | ORDER | TRANSFER | ISSUE | STOCKTAKE | MOVEMENT
  refId      String?
  groupId    String? // joins transfer OUT+IN, stocktake batch (DEC-INV-004/009)
  reversesId String? @unique
  note       String?
  actor      String? // এখন সবাই সব পারবে — কে করল সেটাই যথেষ্ট (Q11 ruling)

  createdAt DateTime @default(now())

  @@index([itemId, warehouseId])
  @@index([reason])
  @@index([createdAt])
  @@index([refType, refId])
}

/// DEC-INV-004 — one-step: OUT+IN posted atomically, same groupId. No
/// in-transit state (both warehouses share one building; revisit at first branch).
model StockTransfer {
  id              String    @id @default(cuid())
  transferNo      String    @unique // TRF-000001
  fromWarehouseId String
  toWarehouseId   String
  note            String?
  status          String    @default("POSTED") // POSTED | REVERSED
  actor           String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  lines StockTransferLine[]
}

model StockTransferLine {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id])
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id])
  qtyMilli   Int

  @@index([transferId])
}

/// DEC-INV-005 — wastage & gift share one document shape: any time, multi-item,
/// valued at current AVCO. No forced day-end routine.
model StockIssue {
  id              String    @id @default(cuid())
  issueNo         String    @unique // WST-000001 / GFT-000001
  kind            IssueKind
  warehouseId     String
  reason          String? // পচা / ভাঙা / শুকিয়ে যাওয়া / marketing / সম্পর্ক …
  note            String?
  totalValuePaisa Int       @default(0)
  status          String    @default("POSTED") // POSTED | REVERSED
  actor           String?
  financePostedAt DateTime? // DEC-FIN-024
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  lines StockIssueLine[]
}

model StockIssueLine {
  id            String     @id @default(cuid())
  issueId       String
  issue         StockIssue @relation(fields: [issueId], references: [id])
  itemId        String
  item          Item       @relation(fields: [itemId], references: [id])
  qtyMilli      Int
  unitCostPaisa Int        @default(0)
  valuePaisa    Int        @default(0)

  @@index([issueId])
}

/// DEC-INV-009 — count session: ledger snapshot vs counted, গরমিল in qty + taka,
/// Apply posts one ADJUSTMENT per differing line. Immutable after Apply (INV-RULE-011).
model Stocktake {
  id          String    @id @default(cuid())
  stocktakeNo String    @unique // STK-000001
  warehouseId String
  note        String?
  status      String    @default("DRAFT") // DRAFT | APPLIED
  appliedAt   DateTime?
  actor       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  lines StocktakeLine[]
}

model StocktakeLine {
  id              String    @id @default(cuid())
  stocktakeId     String
  stocktake       Stocktake @relation(fields: [stocktakeId], references: [id])
  itemId          String
  item            Item      @relation(fields: [itemId], references: [id])
  ledgerQtyMilli  Int // snapshot at count time
  countedQtyMilli Int
  diffValuePaisa  Int       @default(0) // (counted − ledger) × AVCO

  @@index([stocktakeId])
}

/// DEC-INV-007 — ONLY for Item.trackExpiry items (chocolate etc.). Counts, not
/// valuation: deductions consume lots earliest-expiry-first (FEFO); money stays AVCO.
model ItemExpiryLot {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  warehouseId String
  expiryDate  DateTime
  qtyMilli    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([itemId, warehouseId])
  @@index([expiryDate])
}

/// DEC-INV-003 / 011 — single row, admin-configurable (never hardcoded).
model InventorySetting {
  id                        String              @id @default("singleton")
  defaultSaleWarehouseId    String? // seeded → দোকান (SHOP)
  defaultReceiveWarehouseId String? // seeded → স্টোররুম (STORE)
  allowPerOrderWarehouse    Boolean             @default(false)
  negativeStockPolicy       NegativeStockPolicy @default(ALLOW_WARN)

  /// DEC-ASM-003 — Assembly's defaults. Null → fall back to defaultSaleWarehouseId,
  /// then the first active warehouse (day 1 that resolves to SHOP).
  /// component = where components are PICKED from; finished = where a transfer LANDS.
  defaultAssemblyComponentWarehouseId String?
  defaultAssemblyFinishedWarehouseId  String?
  /// DEC-ASM-012 — the WIP stage IS a warehouse ("Assembly floor", code ASSEMBLY);
  /// lazily created on first use if null. Stock board shows what sits in production.
  assemblyFloorWarehouseId String?

  updatedAt DateTime @updatedAt
}

// ============================================================
// ASSEMBLY MODULE v2 — RADIAN_ASSEMBLY_MODULE_ARCHITECTURE.md (redesigned with
// the owner 23 Jul 2026, DEC-ASM-011…016; supersedes the Build/Un-build models).
// Flow: Template (standalone, NO stock touch) → Production (pick components
// Shop→Assembly floor, who/when) → Finish (used+wasted, leftovers auto-return)
// → Finished Goods → Transfer (owner picks the finished Item, stock lands).
// All stock movement goes through InventoryService (INV-RULE-001).
// ============================================================

/// DEC-ASM-011 — standalone production template (owner's ruling, twice):
/// its own name + image + component list; NOT tied to an Item at creation and
/// never checks or moves stock. The finished Item is chosen at TRANSFER time.
/// ⚠ flagged to the architecture project: composition now lives here for
/// produced goods, while ItemComponent stays for MAKE_TO_ORDER recipes.
model AssemblyTemplate {
  id       String  @id @default(cuid())
  name     String  @unique // "Romantic Bouquet"
  imageUrl String? @db.Text // product photo, data-URL interim (same as Item mugshot)
  note     String?
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lines       AssemblyTemplateLine[]
  productions AssemblyProduction[]
}

model AssemblyTemplateLine {
  id         String           @id @default(cuid())
  templateId String
  template   AssemblyTemplate @relation(fields: [templateId], references: [id])

  componentItemId String
  componentItem   Item   @relation("AsmTemplateComponent", fields: [componentItemId], references: [id])

  /// per ONE finished piece, in the component item's OWN unit (milli)
  qtyMilli  Int
  sortOrder Int @default(0)

  @@index([templateId])
  @@index([componentItemId])
}

/// DEC-ASM-013 — production run states. CANCELLED returns picked stock.
enum ProductionStatus {
  IN_PROGRESS
  FINISHED
  TRANSFERRED
  CANCELLED
}

/// DEC-ASM-012/013 — one production run: template × qty, assigned to someone.
/// Start: components TRANSFER source→Assembly floor (stock check warns, never
/// blocks — DEC-INV-011). Finish: used consumed (ASSEMBLY), wasted auto-WASTAGE
/// (DEC-ASM-015), leftovers auto-return to source. Between FINISHED and
/// TRANSFERRED the finished value sits on THIS document (no item exists yet —
/// owner picks it at transfer, DEC-ASM-011); transfer posts finished IN.
model AssemblyProduction {
  id           String           @id @default(cuid())
  productionNo String           @unique // PRD-000001
  templateId   String
  template     AssemblyTemplate @relation(fields: [templateId], references: [id])
  templateName String // snapshot — survives template edits/deletes

  /// planned pieces (milli); actual completed may differ
  qtyMilli         Int
  finishedQtyMilli Int              @default(0)
  status           ProductionStatus @default(IN_PROGRESS)

  /// DEC-ASM-014 — who is building + how long (owner's reporting ask)
  assignedTo  String?
  actor       String? // who entered it
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMin Int? // manual override (quick build); else finished−started

  sourceWarehouseId String // components picked FROM (default Shop)
  floorWarehouseId  String // the Assembly floor row (DEC-ASM-012)

  totalUsedValuePaisa   Int @default(0) // = the finished goods' worth
  totalWastedValuePaisa Int @default(0)
  unitCostPaisa         Int @default(0) // usedValue ÷ finishedQty, per piece
  /// the WASTAGE StockIssue posted at finish (null = nothing wasted)
  issueId String?

  /// transfer (owner picks the finished Item here — DEC-ASM-011)
  targetItemId        String?
  targetItem          Item?     @relation("AsmProductionTarget", fields: [targetItemId], references: [id])
  transferWarehouseId String?
  transferredAt       DateTime?

  note      String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  lines AssemblyProductionLine[]

  @@index([status])
  @@index([templateId])
  @@index([startedAt])
}

model AssemblyProductionLine {
  id           String             @id @default(cuid())
  productionId String
  production   AssemblyProduction @relation(fields: [productionId], references: [id])

  componentItemId String
  componentItem   Item   @relation("AsmProductionComponent", fields: [componentItemId], references: [id])

  /// template × planned qty, SNAPSHOT at start (template edits never rewrite history)
  plannedQtyMilli Int
  /// what physically moved to the Assembly floor at start
  pickedQtyMilli  Int
  usedQtyMilli    Int @default(0)
  wastedQtyMilli  Int @default(0)
  /// component AVCO at pick time — finish is valued at this same cost
  unitCostPaisa    Int @default(0)
  usedValuePaisa   Int @default(0)
  wastedValuePaisa Int @default(0)

  @@index([productionId])
  @@index([componentItemId])
}

// ============================================================
// DELIVERY MANAGEMENT — RADIAN_DELIVERY_MODULE_ARCHITECTURE.md
// (locked 23 Jul 2026, DEC-DLV-001…006). Order.deliveryStatus was always
// Delivery-owned (DEC-SAL-003) — these are that owner's masters + trail.
// Transitions still go THROUGH OrdersService (DEC-DLV-006, no rule duplication).
// ============================================================

enum DeliveryMethodKind {
  RIDER // own delivery staff (Dhaka)
  COURIER // third-party parcel (nationwide)
}

/// ── এলাকা · DEC-DLV-007, মালিকের নির্দেশ ১ আগস্ট ২০২৬ ──────────────────────
///
/// > *"আমাদের delivery module-এ প্রতিটা জিনিসের জন্য আলাদা নিয়ম আছে, charge
/// > আছে। Product upload page-এ শুধু নামগুলা আসবে, আর কাজ করবে delivery
/// > module-এর নিয়ম অনুযায়ী।"*
///
/// দুই স্তরের গাছ, ঠিক যেমন admin-এর Zones · types · slots পর্দায় দেখা যায়:
///   parentId = null  → মূল zone  (Dhaka City, Nationwide)
///   parentId ≠ null  → তার ভেতরের এলাকা (Dhanmondi, Gulshan, Uttara)
///
/// ⚠️ পর্দাটা ছিল, টেবিলটা ছিল না। `ZonesAvailability` পুরোটাই browser-এর
/// ভেতরে `DEMO_ZONE_TREE` নিয়ে বসে ছিল — মালিক charge বদলে refresh দিলেই
/// সব মুছে যেত, আর database কখনো জানতই না। যে পর্দা save করে না, সেটা
/// পর্দা নয়, ছবি।
///
/// ⚠️ `DeliveryZone` enum-টা রয়ে গেছে, আর সেটাই ঠিক। ওটা বলে *কোন ধরনের*
/// জায়গা (ঢাকা / দেশজুড়ে / কাউন্টার) — order-এর snapshot-এ ওটাই লেখা থাকে।
/// এই টেবিল বলে *কোন* জায়গা। দুটো আলাদা প্রশ্ন।
model DeliveryArea {
  id       String         @id @default(cuid())
  name     String
  /// null = এটাই মূল zone। নাহলে যে zone-এর ভেতরে।
  parentId String?
  parent   DeliveryArea?  @relation("AreaTree", fields: [parentId], references: [id])
  children DeliveryArea[] @relation("AreaTree")

  /// মূল zone-এর ধরন। শিশু সারিও একই মান বহন করে, যাতে "ঢাকার সব এলাকা"
  /// জানতে গাছ বেয়ে উঠতে না হয়।
  zone      DeliveryZone
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)

  methods DeliveryMethod[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([zone])
}

/// ── delivery-র নাম · DEC-DLV-008, মালিকের নির্দেশ ১ আগস্ট ২০২৬ ─────────────
///
/// > *"delivery module-এ যা edit বা change করা হয়, তা যেন auto পুরা system-এ
/// > কাজ করে — frontend, product upload page, আর যেখানে দরকার সব জায়গায়।"*
///
/// "Same day", "2-hour express" — শুধু নামগুলো, দোকানজুড়ে একবার।
/// Product upload page এই টেবিলটাই দেখাবে, আর কিছু না।
///
/// ⚠️ কেন আলাদা টেবিল, `DeliveryMethod.label` দিয়ে কাজ চলত না কেন।
/// Dhanmondi-র "Same day" আর Gulshan-এর "Same day" দুটো আলাদা সারি, কারণ
/// দাম আলাদা। Product যদি লেখার সাথে মিলিয়ে যুক্ত হতো, তাহলে মালিক একদিন
/// "Same day" → "Same-day" করলেই **সব product-এর সংযোগ নীরবে ছিঁড়ে যেত**,
/// আর কোথাও কোনো error দেখা যেত না — শুধু গ্রাহক দ্রুত delivery-র ঘরটা আর
/// দেখতে পেত না। নাম বদলানো যায় এমন জিনিসের উপর ভিত্তি করে সংযোগ বানানো
/// হয় না; সংযোগ হয় id-র উপর, আর নাম তার একটা মাত্র ঘর।
///
/// ⚠️ `kind` এখানেও আছে আর `DeliveryMethod`-এও — ইচ্ছাকৃত নয়, ক্রমান্বয়ে
/// সরানো হচ্ছে। ধরনটা নামের সাথেই যায় (courier একটা courier, যে এলাকাতেই
/// হোক), তাই শেষ পর্যন্ত এটাই থাকবে।
/// একটা delivery **কীভাবে চলে** — DEC-DLV-010, মালিকের সিদ্ধান্ত ১ আগস্ট ২০২৬
///
/// ⚠️ কেন এটা নাম থেকে আন্দাজ করা যায় না। মালিকের প্রশ্ন ছিল: *"type-এ যখন
/// 2 hours লিখতাসি, system কীভাবে time-টা calculate করবে? নাম বদলে 3 hours
/// করলে?"* — উত্তর: করতে পারবে না, আর চেষ্টাও করা উচিত নয়। নাম পড়ে "2" বের
/// করলে "3 hours" ঘটনাক্রমে কাজ করত, কিন্তু "দ্রুত ডেলিভারি" লিখলেই চুপচাপ
/// ভেঙে পড়ত। সংখ্যা থাকে নিজের ঘরে, নাম থাকে নামের ঘরে।
enum DeliveryTiming {
  /// "২ ঘণ্টায়" — ঘড়ি **order confirm হওয়ার পর** থেকে চলে (মালিকের পুরনো
  /// নিয়ম, capacity module-ও ঠিক এভাবেই সময় কাটে)। `promiseMinutes` লাগে।
  /// তারিখ নেই, slot নেই।
  FROM_CONFIRM

  /// "আজকের মধ্যে, এই সময়টায়" — Same Day। slot লাগে, তারিখ নেই।
  TODAY_SLOT

  /// "যেদিন চান, যে সময়টায়" — Schedule It। তারিখ + slot দুটোই।
  PICK_DATE_SLOT

  /// "যেদিন চান, সময় আমাদের" — Midnight Surprise। তারিখ আছে, slot নেই।
  PICK_DATE_FIXED

  /// "১–৩ দিন" — Nationwide Courier। তারিখও নয়, slot-ও নয়, শুধু একটা কথা।
  LEAD_DAYS
}

model DeliveryType {
  id        String             @id @default(cuid())
  name      String
  zone      DeliveryZone
  kind      DeliveryMethodKind @default(RIDER)
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)

  /// এই delivery কোন ছাঁচের। checkout এটাই পড়ে ঠিক করতে — তারিখ চাইব?
  /// slot চাইব? নাকি শুধু ঘড়ি চালাব?
  timing DeliveryTiming @default(TODAY_SLOT)

  /// `FROM_CONFIRM` হলে কত মিনিটের প্রতিশ্রুতি। ২ ঘণ্টা = 120, ৩ ঘণ্টা = 180।
  /// নাম "3 Hours" করলে এটা **নিজে থেকে বদলায় না** — মালিক এখানে ১৮০ লেখেন।
  /// দুটোই তাঁর হাতে, আর কোনো আন্দাজ নেই।
  promiseMinutes Int?

  /// ── এই delivery দিনের কোন সময়টায় নেওয়া যাবে · মালিকের নির্দেশ ──────────
  ///
  /// > *"২ ঘণ্টার delivery দোকান off/on পর্যন্ত কাজ করবে, তারও একটা সীমা
  /// > থাকবে — like ১০টা থেকে ৯টা পর্যন্ত। এমন না হলে বিপদ হবে, কারণ দোকান
  /// > অনেক সময় ১২টা পর্যন্ত খোলা থাকবে, আবার সকাল ৬টায়ও খুলতে পারি।"*
  ///
  /// ⚠️ Shop hours-এর সাথে মেলানো হয়নি ইচ্ছাকৃতভাবে, আর কারণটা মালিকের
  /// কথাতেই আছে: **দোকান খোলা থাকা আর delivery চলা এক জিনিস নয়।** রাত
  /// ১১টায় দোকান খোলা থাকতে পারে, কিন্তু তখন "২ ঘণ্টায়" মানে রাত ১টা —
  /// যে প্রতিশ্রুতি কেউ রাখতে পারবে না। প্রতিটা delivery-র নিজের জানালা।
  ///
  /// দিনের শুরু থেকে মিনিট। ১০টা = 600, রাত ৯টা = 1260। null = সীমা নেই।
  openFromMin Int?
  openToMin   Int?

  rates    DeliveryMethod[]
  products ProductDeliveryType[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([zone])
  @@index([isActive])
}

/// কোন product কোন delivery-তে যেতে পারে। DEC-DLV-008।
///
/// ⚠️ এটা `Product.supportsExpress / supportsSameDay / supportsMidnight`
/// তিনটা boolean-এর জায়গা নেয়। ওই তিনটা ছিল hardcoded — মালিক নতুন একটা
/// ধরন বানালে (ধরুন "৪ ঘণ্টায়") product-এ সেটা দেখানোর কোনো উপায়ই ছিল না,
/// কারণ চতুর্থ কোনো column ছিল না। এখন যতগুলো ধরন, ততগুলো সারি।
model ProductDeliveryType {
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  typeId    String
  type      DeliveryType @relation(fields: [typeId], references: [id])

  createdAt DateTime @default(now())

  @@id([productId, typeId])
  @@index([typeId])
}

/// DEC-DLV-002 / P3 — zone × method × fee × cut-off master, admin-configurable.
/// Order keeps label/fee SNAPSHOTS; this is the menu, not the receipt.
///
/// ⚠️ DEC-DLV-008-এর পর এই টেবিলের মানে বদলেছে: এটা এখন **দাম**, নাম নয়।
/// একটা সারি = "এই ধরনের delivery, এই এলাকায়, এত টাকায়, এই slot-গুলো নিয়ে"।
/// নামটা `type`-এ। `label` এখনো আছে পুরনো order আর পুরনো পর্দার জন্য।
model DeliveryMethod {
  id         String             @id @default(cuid())
  label      String // "2-Hour Express", "Same Day", "Midnight", "Nationwide Courier"
  zone       DeliveryZone // DHAKA | BANGLADESH (COUNTER never has a method)
  kind       DeliveryMethodKind @default(RIDER)
  feePaisa   Int                @default(0)
  cutoffTime String? // "20:00" — last order time for this method (info/warn)
  etaLabel   String? // "within 2 hours"
  sortOrder  Int                @default(0)
  isActive   Boolean            @default(true)

  /// Does this delivery speed get a card in the homepage's "Need It Today"
  /// band?
  ///
  /// ⚠️ This is ADVERTISING, not availability. `isActive` decides whether a
  /// customer may choose this delivery at checkout; this decides whether it is
  /// boasted about on the front page. They were the same column until 3 Aug
  /// 2026, which meant the only way to take "Schedule It" off the homepage was
  /// to stop offering scheduled delivery altogether.
  ///
  /// Default `true` so today's four cards keep showing. See TagGroup for why
  /// this default differs from Category's.
  isFeatured Boolean            @default(true)

  /// ── কোন এলাকার দাম · DEC-DLV-007 ────────────────────────────────────────
  /// null = পুরো zone-এর জন্য একই নিয়ম। এলাকা বসালে সেই এলাকার নিজের দাম।
  ///
  /// এটাই locked decision যেটা চেয়েছিল: *"Delivery Type–Zone availability =
  /// fully admin-configurable matrix table (not a hardcoded Dhaka/non-Dhaka
  /// boolean)"*। প্রতিটা সারি ওই ছকের একটা ঘর — এই এলাকায় এই ধরনের delivery
  /// চলে কি না, আর চললে কত।
  ///
  /// ⚠️ null-ই ডিফল্ট, ইচ্ছাকৃতভাবে। দোকান যদি ঢাকার সব জায়গায় একই দাম নেয়
  /// — আর বেশিরভাগ দোকান তাই নেয় — তাহলে একটাই সারি, আর checkout-এ গ্রাহককে
  /// এলাকা জিজ্ঞেস করার দরকারই পড়ে না।
  areaId String?
  area   DeliveryArea? @relation(fields: [areaId], references: [id])

  /// ── কোন নামের দাম · DEC-DLV-008 ─────────────────────────────────────────
  /// null = পুরনো সারি, যেটা নিজের `label` নিয়ে একা দাঁড়িয়ে আছে। নতুন সব
  /// সারিতে এটা থাকবে, আর তখনই product-এর সাথে সংযোগ কাজ করে।
  typeId String?
  type   DeliveryType? @relation(fields: [typeId], references: [id])

  slots  DeliverySlot[]
  orders Order[] // FK reference (snapshot stays on the order — DEC-DLV-002)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([zone])
  @@index([isActive])
}

/// DLV-R05 — capacity WARNS, never blocks (owner may overbook a rush day).
model DeliverySlot {
  id             String         @id @default(cuid())
  methodId       String
  method         DeliveryMethod @relation(fields: [methodId], references: [id])
  label          String // "Morning"
  capacityPerDay Int? // null = unlimited
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)

  /// ── স্লটের নিজের সময় আর শেষ-অর্ডারের ঘড়ি · DEC-DLV-007 ───────────────
  /// দিনের শুরু থেকে মিনিট, ২৪ ঘণ্টার হিসাবে। 9am = 540, 12pm = 720।
  ///
  /// ⚠️ মিনিট, "9am - 12pm" লেখা নয়। লেখা দিয়ে হিসাব করা যায় না — আর
  /// checkout-কে হিসাব করতেই হবে: এখন কি এই স্লট ধরা যায়, নাকি সময় পেরিয়ে
  /// গেছে। লেখাটা মিনিট থেকে বানানো যায়, উল্টোটা যায় না।
  startMin Int?
  endMin   Int?

  /// এই স্লটের জন্য শেষ কখন order নেওয়া যাবে — "08:00"। null = স্লট শুরুর
  /// আগ পর্যন্ত।
  ///
  /// ⚠️ স্লটে, method-এ নয়। `DeliveryMethod.cutoffTime` পুরো ধরনের জন্য একটা
  /// সময় দেয়, কিন্তু মালিকের পর্দায় সকালের স্লট বন্ধ হয় ৮টায় আর সন্ধ্যারটা
  /// ৩টায় — একই দিনে, একই ধরনের delivery-তে। একটা সংখ্যা দিয়ে তিনটা ভিন্ন
  /// সত্য বলা যায় না।
  cutoffTime String?

  orders Order[] // FK reference; slotLabel snapshot stays on the order

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([methodId])
}

/// DEC-DLV-004 — own master now; Employee module ADOPTS this later
/// (Warehouse/DEC-INV-014 adopt pattern — never a second rider table).
model Rider {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  vehicle  String? // "bike", "cycle", "on foot"
  photoUrl String? @db.Text // data-URL interim (Item.imageUrl pattern)
  note     String?
  isActive Boolean @default(true)

  assignments DeliveryAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
}

/// P2 — courier master replaces the hardcoded COURIERS array.
/// trackingUrlTemplate uses {cn} for the consignment number.
model CourierService {
  id                  String  @id @default(cuid())
  name                String  @unique // "Steadfast", "Pathao", "RedX"
  phone               String?
  trackingUrlTemplate String? // "https://steadfast.com.bd/t/{cn}"
  note                String?
  sortOrder           Int     @default(0)
  isActive            Boolean @default(true)

  assignments DeliveryAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum AssignmentKind {
  RIDER
  COURIER
}

enum AssignmentStatus {
  ASSIGNED // parcel handed to rider / booked with courier
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED // keeps failReason; retry = NEW assignment (DLV-R04)
  CANCELLED // superseded by a re-assign (DLV-R01) or order cancelled
}

/// DEC-DLV-003 — who is carrying this order right now + full retry history.
/// ONE active per order (service-enforced, DLV-R01).
model DeliveryAssignment {
  id           String @id @default(cuid())
  assignmentNo String @unique // DLV-000001 (DEC-DLV-005)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  kind      AssignmentKind
  riderId   String?
  rider     Rider?          @relation(fields: [riderId], references: [id])
  courierId String?
  courier   CourierService? @relation(fields: [courierId], references: [id])

  consignmentNo String? // courier's parcel id (typed manually until P1 APIs)
  trackingUrl   String?

  status     AssignmentStatus @default(ASSIGNED)
  isActive   Boolean          @default(true) // false once superseded/terminal
  assignedAt DateTime         @default(now())
  outAt      DateTime?
  deliveredAt DateTime?
  failedAt   DateTime?
  failReason String?
  note       String?
  actorName  String?

  /// F12 / DEC-FIN-021 — what WE pay the courier/rider for this parcel.
  /// Delivery owns the number; Finance only consumes it (5200 Delivery Cost).
  costPaisa       Int       @default(0)
  codHandedOver   Boolean   @default(false) // cash reached us (CarrierRemittance)
  financePostedAt DateTime?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([orderId])
  @@index([riderId])
  @@index([courierId])
  @@index([status])
  @@index([isActive])
}

// ============================================================
// POS MODULE — physical-store counter (RADIAN_POS_MODULE_ARCHITECTURE.md)
// POS sales live in the unified Order table (channel=POS, fulfillmentType=COUNTER,
// DEC-POS-001). These tables are the counter-specific peripherals POS owns.
// ============================================================

enum FulfillmentType {
  DELIVERY // online / courier order
  COUNTER  // POS walk-in / take-away
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

enum PosCashKind {
  SALE_CASH  // cash taken in a sale
  PAYOUT     // cash paid out of the drawer
  DROP       // cash removed to safe/bank
  ADJUSTMENT // manual correction
}

/// A counter/till. Multi-counter + future multi-branch (DEC-POS-005).
model PosRegister {
  id        String   @id @default(cuid())
  code      String   @unique // "COUNTER-1"
  name      String
  branchId  String? // soft ref until Branch module
  isActive  Boolean  @default(true)
  shifts    PosShift[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

/// One cashier session on a register — owns opening float + cash lifecycle (DEC-POS-010).
model PosShift {
  id                String         @id @default(cuid())
  shiftNo           String         @unique // "SHF-000001"
  registerId        String?
  register          PosRegister?   @relation(fields: [registerId], references: [id])
  cashierName       String
  status            PosShiftStatus @default(OPEN)
  openingFloatPaisa Int            @default(0)
  openedAt          DateTime       @default(now())
  closedAt          DateTime?
  expectedCashPaisa Int? // computed at close = float + cash sales − payouts
  countedCashPaisa  Int? // what the cashier counted
  overShortPaisa    Int? // counted − expected (flagged, never blocks)
  closeNote         String?
  cashMovements     PosCashMovement[]
  orders            Order[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  @@index([status])
  @@index([registerId])
}

/// Cash in/out inside a shift — feeds day-close expected cash (DEC-POS-010).
model PosCashMovement {
  id          String      @id @default(cuid())
  shiftId     String
  shift       PosShift    @relation(fields: [shiftId], references: [id])
  kind        PosCashKind
  amountPaisa Int // signed
  note        String?
  actorName   String
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?

  @@index([shiftId])
}

/// A parked cart — not an Order until completed (DEC-POS-011). Snapshot stored as JSON.
model PosHeldCart {
  id         String   @id @default(cuid())
  label      String
  registerId String?
  payload    Json // { lines, customer, gift, discount, adjustment, tax, payMode }
  createdAt  DateTime @default(now())
  deletedAt  DateTime?
}

/// Category/product discount cap + approval gate (DEC-POS-006). POS-owned for now;
/// ownership moves to Pricing & Offers later. Soft refs (no FK) to avoid touching
/// Category/Product back-relations this cycle.
model PosDiscountRule {
  id               String   @id @default(cuid())
  categoryId       String? // one of category / product
  productId        String?
  maxPercent       Int      @default(0) // 100 = free negotiation
  requiresApproval Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  @@index([categoryId])
  @@index([productId])
}

// ============================================================
// PRICING & OFFERS MODULE — RADIAN_OFFERS_MODULE_ARCHITECTURE.md
// (locked 23 Jul 2026, DEC-OFR-001…009). One owner for every discount promise.
// Order keeps only the applied snapshot (couponCode + discountPaisa) — rules
// live HERE. POS excluded (negotiable price, locked §5খ).
// ============================================================

/// DEC-OFR-001 — v1 Core 6. Bundle/Tiered/Free-gift/BOGO/Corporate deferred;
/// enum ADDITION is a non-breaking migration when the owner asks.
enum OfferShape {
  SITEWIDE
  CATEGORY
  PRODUCT
  FIRST_ORDER
  PAYMENT
  FREE_DELIVERY
}

enum OfferMechanism {
  AUTOMATIC // applies by itself when eligible
  COUPON // needs the code typed/applied
}

/// DEC-OFR-006 — stored status; live-ness (scheduled/active/expired) is DERIVED
/// from startsAt/endsAt at read time (liveState in the API), no cron.
enum OfferStatus {
  draft
  pending_approval // DEC-OFR-004 gate tripped, awaiting sign-off
  approved // cleared; dates decide scheduled/active/expired
  paused
  archived // soft retirement (history stays)
}

enum OfferDiscountType {
  PERCENT // discountValue = basis points (1200 = 12%)
  FLAT // discountValue = paisa
  FREE_DELIVERY // no value; zeroes the delivery charge via deliveryWaivedPaisa
}

/// DEC-OFR — the one entity. A coupon IS an offer with mechanism=COUPON
/// (mock's ruling kept — no separate Coupon table to drift).
model Offer {
  id      String @id @default(cuid())
  offerNo String @unique // OFR-000001 (DEC-OFR-005, D8 lesson)

  name         String // internal name
  internalNote String?
  publicTitle  String? // storefront-facing (W3 swap reads these)
  benefitLine  String?
  description  String? @db.Text

  mechanism OfferMechanism @default(AUTOMATIC)
  shape     OfferShape     @default(SITEWIDE)
  status    OfferStatus    @default(draft)

  /// COUPON only — stored UPPERCASE, unique across live offers (DEC-OFR-005)
  code String? @unique

  discountType  OfferDiscountType @default(PERCENT)
  discountValue Int               @default(0) // PERCENT=bp · FLAT=paisa (DEC-OFR-009)

  // limits — all optional, all admin-set (paisa / counts)
  maxDiscountPaisa Int?
  minSpendPaisa    Int?
  perCustomerLimit Int? // null = unlimited; 1 = once per customer
  totalLimit       Int? // null = unlimited

  // targeting (shape-specific; references only — One Data One Owner)
  categoryId    String? // shape=CATEGORY
  category      Category?      @relation(fields: [categoryId], references: [id])
  products      Product[]      @relation("OfferProducts") // shape=PRODUCT (m2m)
  paymentMethod PaymentMethod? // shape=PAYMENT

  // stacking + presentation (DEC-OFR-002/007)
  combinable    Boolean  @default(false)
  priority      Int      @default(0) // higher wins ties between automatics
  scarcity      Boolean  @default(false) // cosmetic counter — NEVER real stock (locked §5খ)
  bonusLines    String[] // Hormozi bonus stack — plain text v1
  guaranteeText String?

  // schedule — live-ness derived at read (DEC-OFR-006)
  startsAt DateTime?
  endsAt   DateTime?

  // approval gate (DEC-OFR-004; Returns DEC-RTN-012 pattern — any staff for now)
  belowCostFlag Boolean   @default(false) // OFR-R09 detection result, shown in queue
  approvedBy    String?
  approvedAt    DateTime?

  actorName String? // who created/last edited (audit detail in AuditLog)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  redemptions OfferRedemption[]

  @@index([status])
  @@index([mechanism])
  @@index([categoryId])
  @@index([endsAt])
}

/// One applied offer on one order (a stacked order has 2 rows — auto + coupon).
/// Soft-deleted when the order is cancelled so limits give the slot back
/// (DEC-OFR-008). Order.discountPaisa stays the frozen receipt snapshot.
model OfferRedemption {
  id         String   @id @default(cuid())
  offerId    String
  offer      Offer    @relation(fields: [offerId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  code          String? // coupon code as typed (snapshot)
  discountPaisa Int // what THIS offer took off this order
  freeDelivery  Boolean @default(false)

  createdAt DateTime  @default(now())
  deletedAt DateTime? // released on order cancel (DEC-OFR-008)

  @@index([offerId])
  @@index([orderId])
  @@index([customerId])
}

/// DEC-OFR-004 — singleton ("singleton" id pattern, NOT PosSetting's cuid slip).
model OfferSetting {
  id                  String   @id @default("singleton")
  approvalThresholdBp Int      @default(2500) // ≥ this % ⇒ approval (0 = off)
  defaultCombinable   Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

/// Singleton POS settings (DEC-POS: everything admin-configurable).
model PosSetting {
  id                     String   @id @default(cuid())
  openingFloatDefaultPaisa Int    @default(0)
  defaultTaxRateBps      Int      @default(0)
  giftReceiptHidePrice   Boolean  @default(true)
  defaultCreditLimitPaisa Int     @default(0)
  receiptHeader          String?
  receiptFooter          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// ============================================================================
//  FINANCE MODULE  —  ledger (RADIAN_FINANCE_MODULE_ARCHITECTURE.md v1.1)
//  DEC-FIN-001..028 · FIN-RULE-001..024 · review: RADIAN_FINANCE_REVIEW.md
//
//  CONSTITUTION: Finance consumes COMPLETED business events. It never creates
//  operational data. Owns only: Account · JournalEntry/Line · Expense · Income ·
//  Transfer · Partner · FixedAsset · Prepaid · Loan · Reconciliation.
//
//  DEC-FIN-001 — full double-entry INSIDE, simple forms OUTSIDE (no Dr/Cr in UI).
//  DEC-FIN-008 — money accounts are a master, mapped to PayMethod/PaymentMethod.
//  DEC-FIN-013 — expense "category" IS the EXPENSE account (no separate master).
//  DEC-FIN-014 — ledger immutable; correction = reversal entry.
// ============================================================================

enum FinAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// DEC-FIN-006 — break-even needs every EXPENSE account tagged fixed/variable.
enum CostBehavior {
  FIXED
  VARIABLE
}

/// Where a ledger entry came from — FIN-RULE-001 (no entry without an event).
enum FinSourceType {
  ORDER
  PAYMENT
  RETURN
  POS_SHIFT
  INVENTORY
  PURCHASE
  SUPPLIER_PAYMENT
  DELIVERY
  REMITTANCE
  EXPENSE
  INCOME
  TRANSFER
  PARTNER
  ASSET
  PREPAID
  LOAN
  RECONCILE
  PROFIT_DIST
  VAT
  OPENING
  MANUAL
  /// MKT-D10 — affiliate commission accrual and payout
  AFFILIATE
}

enum PartnerKind {
  CAPITAL // money partner
  LABOUR // sweat partner
  BOTH
}

/// DEC-FIN-004 — SALARY is an expense, DRAWING/CAPITAL_RETURN is equity. Never mixed.
enum PartnerTxnKind {
  CAPITAL_IN
  CAPITAL_RETURN
  DRAWING
  SALARY
  PROFIT_SHARE
  BONUS
}

/// DEC-FIN-009 / DEC-FIN-026 — threshold approval on every big money-out path.
enum FinApprovalState {
  AUTO
  PENDING
  APPROVED
  DECLINED
}

/// DEC-FIN-010 — fail-soft posting never blocks the operational flow.
enum PostingState {
  FAILED
  REPLAYED
  IGNORED
}

/// DEC-FIN-021 — COD cash sits with a rider or a courier until it reaches us.
enum CarrierType {
  RIDER
  COURIER
}

enum LoanKind {
  BANK
  FAMILY
  OTHER
}

/// Chart of Accounts. isSystem rows are referenced by the posting engine —
/// renameable, never deletable. costBehavior is required for EXPENSE (break-even).
model FinanceAccount {
  id   String         @id @default(cuid())
  code String         @unique // "1000"
  name String
  type FinAccountType

  /// Type → Group → Account, so the P&L shows sub-totals people can read
  /// (gap G3 from the Biznify comparison). Free text, admin-editable.
  groupName      String?
  isMoneyAccount Boolean       @default(false) // cash/bKash/bank/… (DEC-FIN-008)
  payMethod      String? // PayMethod|PaymentMethod value this account maps to
  costBehavior   CostBehavior? // EXPENSE only (FIN-RULE-016)
  isSystem       Boolean       @default(false)
  isActive       Boolean       @default(true)

  openingBalancePaisa Int    @default(0) // go-live snapshot (DEC-FIN-007)
  note                String?
  sortOrder           Int    @default(0)

  lines           JournalLine[]
  expenseCategory Expense[]               @relation("ExpenseCategory")
  expensePaidFrom Expense[]               @relation("ExpensePaidFrom")
  incomeCategory  Income[]                @relation("IncomeCategory")
  incomeInto      Income[]                @relation("IncomeInto")
  transfersFrom   Transfer[]              @relation("TransferFrom")
  transfersTo     Transfer[]              @relation("TransferTo")
  reconciliations AccountReconciliation[]
  remittances     CarrierRemittance[]
  loanPayments    LoanPayment[]
  prepaidItems    PrepaidItem[]
  fixedAssets     FixedAsset[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // never for isSystem

  @@index([type])
  @@index([isMoneyAccount])
}

/// Immutable double-entry document (DEC-FIN-014). Correction = reversal entry.
model JournalEntry {
  id        String   @id @default(cuid())
  entryNo   String   @unique // JV-000001
  entryDate DateTime // business date, NOT posting time (period lock uses this)

  sourceType FinSourceType
  sourceId   String? // polymorphic soft-ref into the owning module
  /// DEC-FIN-023 — "{sourceType}:{sourceId}:{kind}" — one event, one entry.
  sourceKey  String?       @unique

  narration String
  branchId  String? // DEC-FIN-015
  carrierId String? // DEC-FIN-021 — 1110 subledger (rider/courier)

  reversesId String? @unique // this entry reverses that one
  isManual   Boolean @default(false)
  actorName  String?

  lines JournalLine[]

  createdAt DateTime @default(now())

  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@index([carrierId])
}

/// FIN-RULE-002 — Σ debit must equal Σ credit on every entry.
model JournalLine {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String
  account   FinanceAccount @relation(fields: [accountId], references: [id])

  debitPaisa  Int @default(0)
  creditPaisa Int @default(0)

  // dimensions — partner subledger (DEC-FIN-017) + profitability reports
  /// staff advance / salary is tracked per person as a DIMENSION, never as an
  /// account per employee (gap G2 lesson — that pollutes the chart of accounts)
  ///
  /// HR-D06 — employeeName STAYS, for ever. It is what the entry said on the day
  /// it was posted, and a posted entry is never rewritten (FIN-RULE-003). What is
  /// new is employeeId beside it: from now on the server fills BOTH from a real
  /// Employee row, because Finance no longer accepts a typed name. Rows written
  /// before this module have the name only, and that is correct history.
  employeeName String?
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id])
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  orderId   String?
  itemId    String?
  occasion  String? // festival P&L (OccasionType value, soft ref)
  zone      String?
  channelId String?

  note String?

  @@index([entryId])
  @@index([accountId])
  @@index([partnerId])
  @@index([orderId])
  @@index([employeeId])
}

/// Finance-owned manual spend. EXP-000001. Journal is written only once APPROVED
/// (FIN-RULE-009) — until then it is editable/soft-deletable.
model Expense {
  id        String   @id @default(cuid())
  expenseNo String   @unique // EXP-000001
  spentAt   DateTime @default(now())

  accountId String // EXPENSE account = category (DEC-FIN-013)
  account   FinanceAccount @relation("ExpenseCategory", fields: [accountId], references: [id])

  paidFromId String
  paidFrom   FinanceAccount @relation("ExpensePaidFrom", fields: [paidFromId], references: [id])

  amountPaisa   Int
  payeeName     String?
  note          String?
  attachmentUrl String? // receipt photo (data-URL interim, like DLV-R08)

  approval   FinApprovalState @default(AUTO)
  approvedBy String?
  approvedAt DateTime?

  journalEntryId String?
  branchId       String?
  partnerId      String? // partner salary/expense link (audit trail)
  /// MKT-D05 — optional Marketing tag. Finance owns this row; Marketing only
  /// reads it. Money never lives in two places.
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id])
  actorName      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // only while PENDING/DECLINED (FIN-RULE-003)

  @@index([spentAt])
  @@index([accountId])
  @@index([approval])
}

/// Finance-owned manual money-in that is NOT a sale. INC-000001.
model Income {
  id       String   @id @default(cuid())
  incomeNo String   @unique // INC-000001
  earnedAt DateTime @default(now())

  accountId String // INCOME account = category
  account   FinanceAccount @relation("IncomeCategory", fields: [accountId], references: [id])

  receivedInId String
  receivedIn   FinanceAccount @relation("IncomeInto", fields: [receivedInId], references: [id])

  amountPaisa Int
  payerName   String?
  note        String?

  journalEntryId String?
  branchId       String?
  actorName      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([earnedAt])
}

/// Money moving between our own accounts (cash → bank, bKash → cash). TRN-000001.
model Transfer {
  id         String   @id @default(cuid())
  transferNo String   @unique // TRN-000001
  movedAt    DateTime @default(now())

  fromId String
  from   FinanceAccount @relation("TransferFrom", fields: [fromId], references: [id])
  toId   String
  to     FinanceAccount @relation("TransferTo", fields: [toId], references: [id])

  amountPaisa Int
  feePaisa    Int     @default(0) // cash-out charge etc → expense
  note        String?

  journalEntryId String?
  actorName      String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([movedAt])
}

/// DEC-FIN-004/005 — partnership. Salary is an expense; capital/drawings are equity.
model Partner {
  id   String      @id @default(cuid())
  name String
  kind PartnerKind

  sharePercentBp     Int @default(0) // 5000 = 50.00%
  monthlySalaryPaisa Int @default(0) // 0 for a pure money partner

  phone    String?
  note     String?
  joinedAt DateTime @default(now())
  isActive Boolean  @default(true)

  transactions PartnerTransaction[]
  journalLines JournalLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model PartnerTransaction {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  kind        PartnerTxnKind
  amountPaisa Int
  happenedAt  DateTime       @default(now())

  fromAccountId  String? // money account the cash moved through
  journalEntryId String?
  note           String?
  actorName      String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([partnerId])
  @@index([kind])
}

/// FIN-RULE-013 — fridge/van/computer: asset + monthly depreciation, not one-off cost.
model FixedAsset {
  id      String   @id @default(cuid())
  assetNo String   @unique // AST-000001
  name    String
  category String?

  purchasedAt      DateTime
  costPaisa        Int
  usefulLifeMonths Int     @default(48)
  salvagePaisa     Int     @default(0)

  paidFromId String?
  paidFrom   FinanceAccount? @relation(fields: [paidFromId], references: [id])

  lastDepreciatedOn  DateTime?
  accumDepPaisa      Int       @default(0) // running total (report speed; ledger is truth)
  disposedAt         DateTime?
  disposalValuePaisa Int?

  note      String?
  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// FIN-RULE-014 — advance rent spreads monthly; a refundable deposit does not.
model PrepaidItem {
  id       String   @id @default(cuid())
  prepaidNo String  @unique // PRE-000001
  name     String

  totalPaisa Int
  startsOn   DateTime
  months     Int     @default(0) // 0 = deposit (no amortization)
  refundable Boolean @default(false)

  expenseAccountId String?
  expenseAccount   FinanceAccount? @relation(fields: [expenseAccountId], references: [id])

  amortizedPaisa  Int       @default(0)
  lastAmortizedOn DateTime?
  closedAt        DateTime?

  note      String?
  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// FIN-RULE-015 — repayment splits principal (liability) from interest (expense).
model Loan {
  id     String   @id @default(cuid())
  loanNo String   @unique // LON-000001

  lenderName     String
  kind           LoanKind @default(FAMILY)
  principalPaisa Int
  interestRateBp Int      @default(0) // annual, basis points
  startsOn       DateTime
  termMonths     Int?

  intoAccountId String? // where the borrowed money landed
  note          String?
  closedAt      DateTime?

  payments LoanPayment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model LoanPayment {
  id     String @id @default(cuid())
  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id])

  paidAt         DateTime @default(now())
  principalPaisa Int      @default(0)
  interestPaisa  Int      @default(0)

  fromAccountId String
  fromAccount   FinanceAccount @relation(fields: [fromAccountId], references: [id])

  journalEntryId String?
  note           String?
  actorName      String?

  createdAt DateTime @default(now())

  @@index([loanId])
}

/// DEC-FIN-021 — the rider handed the cash over / the courier remitted (minus its
/// charge). Until this row exists the money sits in 1110, not in our accounts.
model CarrierRemittance {
  id           String      @id @default(cuid())
  remittanceNo String      @unique // RMT-000001
  carrierType  CarrierType
  carrierId    String // Rider.id or CourierService.id (soft ref)
  carrierName  String // snapshot

  receivedAt  DateTime @default(now())
  grossPaisa  Int // COD held against this carrier
  chargePaisa Int      @default(0) // courier fee → 5200 Delivery Cost
  netPaisa    Int // what actually landed

  intoAccountId String
  intoAccount   FinanceAccount @relation(fields: [intoAccountId], references: [id])

  journalEntryId String?
  note           String?
  actorName      String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([carrierType, carrierId])
  @@index([receivedAt])
}

/// DEC-FIN-011 / FIN-RULE-012 — counted vs system; the gap becomes a real entry.
model AccountReconciliation {
  id        String   @id @default(cuid())
  reconNo   String   @unique // REC-000001
  accountId String
  account   FinanceAccount @relation(fields: [accountId], references: [id])

  asOfDate            DateTime
  systemBalancePaisa  Int
  countedBalancePaisa Int
  differencePaisa     Int

  journalEntryId String?
  note           String?
  actorName      String?

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([asOfDate])
}

/// DEC-FIN-010 — a posting that failed. The operational transaction still went
/// through; this row is the replay queue + the red badge on the Ledger screen.
model FinancePostingFailure {
  id         String        @id @default(cuid())
  sourceType FinSourceType
  sourceId   String
  sourceKey  String?
  payload    Json
  error      String
  state      PostingState  @default(FAILED)
  retryCount Int           @default(0)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([sourceType, sourceId])
}

/// Singleton ("singleton" id — OfferSetting pattern, not PosSetting's cuid slip).
model FinanceSetting {
  id String @id @default("singleton")

  goLiveDate           DateTime?
  fiscalYearStartMonth Int       @default(7) // July
  defaultCashAccountId String?

  // DEC-FIN-009 / 026 — four money-out approval gates
  expenseApprovalThresholdPaisa Int @default(5000000) // ৳50,000
  paymentApprovalThresholdPaisa Int @default(5000000)
  refundApprovalThresholdPaisa  Int @default(1000000)
  wastageApprovalThresholdPaisa Int @default(500000)

  labourBonusPercentBp Int    @default(0) // DEC-FIN-005 (0 = pure capital-first)
  assetThresholdPaisa  Int    @default(1000000) // FIN-RULE-013
  revenueRecognition   String @default("DELIVERED") // locked, explicit on purpose

  autoPostEnabled Boolean   @default(true)
  lastClosedDate  DateTime? // DEC-FIN-025 period lock
  /// W6 — once the OPENING entry is posted the per-account opening figures freeze
  openingPostedAt DateTime?

  // DEC-FIN-020 — VAT is a liability, never income
  vatEnabled          Boolean @default(false)
  vatRateBps          Int     @default(1500)
  vatInclusivePricing Boolean @default(false)

  /// Everything the Mushak 6.3 challan has to carry about US. The form is a
  /// government document, so nothing here may be invented — until the owner
  /// fills these in, the challan screen refuses to print rather than issue a
  /// document with a made-up BIN on it.
  businessBin         String? // our 13-digit BIN
  businessName        String? // registered name, as on the VAT certificate
  businessAddress     String?
  businessVatCircle   String? // circle / division / commissionerate line
  signatoryName       String?
  signatoryDesignation String?

  riderCashLimitPaisa Int @default(0) // 0 = off; warn above this in 1110

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// G1 — rent, internet, salary: the same expense every month. The system builds
/// the draft when it is due; the owner posts it. Never silent (FIN-RULE-007 spirit).
model RecurringExpense {
  id   String @id @default(cuid())
  name String

  accountId  String // EXPENSE account (the category)
  paidFromId String // money account it usually comes out of

  amountPaisa Int
  dayOfMonth  Int    @default(1) // 1–28
  startsOn    DateTime
  endsOn      DateTime?

  lastPostedFor DateTime? // first day of the month last posted — stops duplicates
  note      String?
  isActive  Boolean  @default(true)
  actorName String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
}

// ============================================================================
//  ACCESS  —  who is at the keyboard (DEC-FIN-028 closed)
//  Until now every action recorded a TYPED name, so "who did it" was a claim,
//  not a fact. Login answers who is in; the PIN re-confirms it at the moment
//  money moves, because in a shop one screen is shared all day.
//  Small on purpose: the full Roles & Permissions module will adopt these tables.
// ============================================================================

enum AppRole {
  OWNER // both partners — can do everything, incl. managing users
  MANAGER // trusted staff — money actions allowed, no user management
  STAFF // day-to-day only; money actions need an OWNER/MANAGER pin
}

model AppUser {
  id       String  @id @default(cuid())
  name     String
  username String  @unique
  role     AppRole @default(STAFF)

  /// ৩০ জুলাই ২০২৬ — মালিকের শর্ত: "সবাইকে যে email-এ access দেব তারা যেন login
  /// করতে গেলে password লাগে, নিজের মতো করে password করে নিতে পারে, ভুলে গেলেও
  /// email-এ forget দিয়ে ঠিক করতে পারে।"
  ///
  /// nullable কারণ আজকের ইউজারদের ইমেইল নেই — migration তাদের ভাঙবে না, তারা
  /// username দিয়েই ঢুকতে থাকবে। ইমেইল বসানো হলে সেটাও কাজ করবে।
  /// লগইনে দুটোই চলবে; ইমেইল বসানোর পর ওটাই আসল পরিচয়।
  email String? @unique

  /// nullable কারণ ডাকা হয়েছে কিন্তু এখনো নিজের পাসওয়ার্ড বসায়নি এমন মানুষ থাকবে।
  /// নকল hash বসানোর চেয়ে খালি রাখা সৎ — খালি মানে "এখনো ঢুকতে পারবে না"।
  passwordHash String?
  pinHash      String? // 4-digit confirm for money actions

  /// ADM-D02 — enum-এর জায়গা নেবে। এক release দুটো পাশাপাশি চলবে, মিলছে কি না
  /// দেখা হবে, তারপর role বাদ। একবারে ফেলে দিলে ফেরার পথ থাকে না।
  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  overrides UserAccessOverride[]
  authTokens AuthToken[]
  sessions  AppSession[]
  // Inbox back-links (relation নামগুলোই সম্পর্ক বলে দেয়)
  assignedConversations Conversation[]    @relation("ConversationAssignee")
  inboxMessages         Message[]         @relation("MessageAuthor")
  escalationAcks        EscalationEvent[] @relation("EscalationAck")
  /// HR-D01 — an optional back-link. A login account is NOT a staff member:
  /// the cook is paid but never signs in, the accountant signs in but is not
  /// on payroll. Employee owns the link (Employee.appUserId); this side exists
  /// only so Prisma can name the relation.
  employee  Employee?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model AppSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      AppUser  @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
//  ADMINISTRATION  —  RADIAN_ADMINISTRATION_MODULE_ARCHITECTURE.md (30 Jul 2026)
//
//  কেন এটা আছে: আজ "কে কী পারে" প্রশ্নের উত্তর তিন জায়গায় ছড়ানো — controller-এর
//  @Roles (৭৩টা), হাতে লেখা if (১০টা), আর AdminSidebar.tsx-এর roles: array
//  (১৫৯টা পর্দার মধ্যে মাত্র ১১টায়)। তিনটে আলাদা তালিকা একই প্রশ্নের উত্তর দেয়,
//  আর কেউ মেলায় না। Intelligence বানানোর দিন সাইডবারে roles বসানোয় STAFF-এর কাছ
//  থেকে পুরো module লুকিয়ে গিয়েছিল — অথচ সিদ্ধান্ত ছিল উল্টো, আর API খোলাই ছিল।
//  কোনো error হয়নি। এই টেবিলগুলোর একমাত্র উদ্দেশ্য: তালিকা একটাই থাকবে।
//
//  মালিকের সাথে লক করা সিদ্ধান্ত:
//    ADM-D01  ভূমিকার নাম মালিক নিজে বানাবেন — গাঁথা তিনটে নাম নয়
//    ADM-D02  AppRole enum → Position টেবিল (enum এক release পাশাপাশি থাকবে)
//    ADM-D03  টিক module + ভেতরের পর্দা স্তরে
//    ADM-D04  পদ = ছাঁচ; ব্যক্তির উপরে ব্যতিক্রম দেওয়া যাবে
//    ADM-D05  registry কোড থেকে তৈরি হবে, হাতে লেখা নয়
//    ADM-D06  নতুন পর্দা ডিফল্ট বন্ধ, কিন্তু Access পর্দায় লাল চিহ্ন সহ
//    ADM-D07  permission matrix (প্রতিটা কাজের টিক) বানানো হবে না
// ============================================================================

enum NodeKind {
  MODULE // "Finance" — সাইডবারের উপরের স্তর
  SCREEN // "Finance → Profit & Loss" — ভেতরের পর্দা
}

/// সিস্টেমে কী কী আছে। ADM-D05 — এই সারিগুলো কোড থেকে sync হয় (সাইডবারের href
/// আর controller-এর route), হাতে লেখা হয় না। হাতে লিখলে ঠিক সেই drift ফিরে আসে
/// যেটা এই module বন্ধ করতে এসেছে।
model AccessNode {
  key       String   @id // "finance.pnl" — স্থির। কখনো বদলাবে না, নইলে টিক হারাবে
  parentKey String? // "finance"
  kind      NodeKind
  label     String // পর্দায় যা দেখাবে
  domain    String // "Finance" — শুধু সাজানোর জন্য
  href      String? // সাইডবার এখান থেকে পড়বে
  routes    String[] // ["GET /finance/pnl"] — API পাহারা এখান থেকে পড়বে
  sortOrder Int      @default(0)

  /// ADM-D06 — লাল চিহ্নের ভিত্তি। নতুন node কেউ পায় না যতক্ষণ না মালিক দেখেন।
  firstSeenAt DateTime  @default(now())
  /// কোড থেকে পর্দাটা চলে গেলে সারিটা মোছা হয় না — পুরনো টিক ও Audit বাঁচাতে হয়
  retiredAt   DateTime?

  positionAccess PositionAccess[]
  userOverrides  UserAccessOverride[]

  @@index([parentKey])
  @@index([retiredAt])
}

/// পদ — নামটা মালিকের (ADM-D01)। "হিসাবরক্ষক", "ডেলিভারি", যা খুশি।
model Position {
  id   String  @id @default(cuid())
  name String  @unique
  note String?

  /// সব পায়, আর কাটা যায় না (ADM-RULE-004)। ঠিক একটা সারিতেই true থাকবে।
  isOwner  Boolean @default(false)
  /// শুরুর তিনটে পদ — নাম বদলানো যায়, কিন্তু মোছা যায় না
  isLocked Boolean @default(false)

  access PositionAccess[]
  users  AppUser[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// পদের ছাঁচ। শুধু ব্যতিক্রম লেখা থাকে — সারি না থাকা মানে "উপরের module যা
/// বলে তাই" (ADM-D04, §৫-এর ধাপ ৩ ও ৪)।
model PositionAccess {
  positionId String
  nodeKey    String
  allowed    Boolean

  position Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  node     AccessNode @relation(fields: [nodeKey], references: [key], onDelete: Cascade)

  @@id([positionId, nodeKey])
  @@index([nodeKey])
}

/// এক ব্যক্তির জন্য আলাদা নিয়ম, ছাঁচের উপরে (ADM-D04, §৫-এর ধাপ ২)।
/// "রফিক ডেলিভারির লোক, কিন্তু ওকে স্টকটাও দেখতে দাও" — এক সারি।
model UserAccessOverride {
  userId  String
  nodeKey String
  allowed Boolean

  user AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  node AccessNode @relation(fields: [nodeKey], references: [key], onDelete: Cascade)

  @@id([userId, nodeKey])
  @@index([nodeKey])
}

/// কোম্পানি নিজে কে। ADM-D08 (৩০ জুলাই ২০২৬)।
///
/// কেন এটা আলাদা টেবিল: পরিচয়ের ছ'টা ঘর আজ `FinanceSetting`-এ বসে আছে, কারণ
/// Mushak ৬.৩-এর জন্য ওগুলো দরকার হয়েছিল আর তখন সেটাই সহজ ছিল। কিন্তু
/// **কোম্পানির নাম-ঠিকানা Finance-এর সম্পত্তি নয়** — ওটা কোম্পানির। ট্রেড
/// লাইসেন্স, লোগো বা যোগাযোগের ফোন Finance-এ রাখার কোনো যুক্তি নেই, আর ওখানে
/// রাখলে পরের যে module-ই এগুলো চায় তাকে Finance-এর ভেতরে হাত দিতে হয়।
/// One Data One Owner: এই সারিটাই এখন উৎস।
///
/// ⚠️ পুরনো ঘরগুলো FinanceSetting-এ **রেখে দেওয়া হয়েছে**, এক release-এর জন্য।
/// Mushak ৬.৩ সম্পূর্ণ ও পরীক্ষিত, আর একটা সরকারি কাগজ ছাপার কোড এক দিনে দুই
/// জায়গা বদলানো ঠিক নয়। Mushak এখন আগে এখানে দেখে, খালি পেলে Finance-এ ফিরে
/// যায় (finance-mushak.service.ts)। দুটো মিলে যাওয়ার পর পুরনোগুলো যাবে।
model CompanySetting {
  id String @id @default("singleton")

  /* ---- নাম ---- */
  /// VAT সার্টিফিকেটে যেভাবে লেখা — Mushak ৬.৩-এ এটাই ছাপা হয়
  legalName String?
  /// গ্রাহক যে নামে চেনে ("Radian")। কাগজে নয়, পর্দায়।
  tradeName String?

  /* ---- সরকারি নম্বর ---- */
  bin                String? // ১৩ সংখ্যার BIN — Mushak ৬.৩ এটার জন্যই আটকে ছিল
  tin                String?
  tradeLicenceNo     String?
  /// মেয়াদ শেষের তারিখ। একটা মেয়াদোত্তীর্ণ লাইসেন্স নিয়ে ব্যবসা চলে না, আর
  /// তারিখটা কোথাও লেখা না থাকলে কেউ মনে রাখে না।
  tradeLicenceExpiry DateTime?
  vatCircle          String? // circle / division / commissionerate লাইন

  /* ---- ঠিকানা ---- */
  /// VAT-এ নিবন্ধিত ঠিকানা — Mushak ৬.৩-এ এটাই যায়
  registeredAddress String?
  /// দোকান যেখানে, যদি আলাদা হয়। খালি থাকলে নিবন্ধিত ঠিকানাই ধরা হবে।
  operatingAddress  String?
  city              String?
  postcode          String?
  country           String  @default("Bangladesh")

  /* ---- যোগাযোগ ---- */
  /// কাগজে ও রসিদে যেটা ছাপা হবে — ব্যক্তিগত নম্বর নয়
  publicPhone String?
  publicEmail String?
  website     String?
  logoUrl     String?

  /* ---- যিনি সই করেন ---- */
  signatoryName        String?
  signatoryDesignation String?

  /* ---- দোকানের সামনের চেহারা (31 Jul 2026) ----
     Added for the storefront's "Visit the shop" card. They sit here rather than
     in StorefrontSetting because they are facts about the company — the same
     kind as publicPhone and logoUrl directly above — not presentation choices. */
  /// the Google Maps link the "Get directions" button opens
  mapUrl        String? @db.Text
  /// often the same number as publicPhone, sometimes not — the card offers both
  whatsappPhone String?
  /// photograph of the shop front
  shopImageUrl  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// বাইরের সেবার চাবি। ADM-D09 (৩০ জুলাই ২০২৬)।
///
/// **ভাগ করা হয়েছে ধরন অনুযায়ী** (মালিকের নির্দেশ, ৩০ জুলাই): টাকা নেওয়ার
/// gateway এক জায়গায়, courier আরেক জায়গায়। একটা লম্বা তালিকায় সব চাবি জড়ো
/// করলে কোনটা টাকার আর কোনটা পার্সেলের সেটা আলাদা করা যায় না।
///
/// **মালিকের সিদ্ধান্ত, ৩০ জুলাই: বাইরের সব সেবা এখানেই।** Facebook, WhatsApp,
/// Google, Meta — সব।
///
/// ⚠️ তাহলে One Data One Owner রক্ষা পায় কীভাবে? **একটা লাইন টেনে**, আর লাইনটা
/// এই:
///
///   **সংযোগ এখানে** — চাবি, token, account নম্বর, pixel ID, চালু/বন্ধ,
///   sandbox নাকি live। "আমরা কার সাথে যুক্ত।"
///
///   **বিষয়বস্তু যার যার module-এ** — WhatsApp-এর বার্তার লেখা (Marketing),
///   SEO-র title (SEO), loyalty-র হার (Marketing)। "ওই সংযোগ দিয়ে কী পাঠাব।"
///
/// এর মানে একটা চাবি ঠিক **এক জায়গায়** থাকে, দুই জায়গায় নয়। পুরনো
/// `MessagingSetting.emailApiKey` আর `TrackingSetting.adsAccessToken`-এর মতো
/// ঘরগুলো এক release-এর জন্য থাকবে (migration সেগুলো এখানে কপি করে দেয়), তারপর
/// যাবে। যতক্ষণ দুটো আছে, পড়ার পথ একটাই — `IntegrationsService.credentials()`।
enum IntegrationKind {
  PAYMENT // টাকা নেওয়া — SSLCommerz · bKash · Nagad
  COURIER // পার্সেল পাঠানো — Pathao · Steadfast · RedX
  MESSAGING // গ্রাহককে পৌঁছানো — WhatsApp · Email · SMS
  SOCIAL // পাতা ও বিজ্ঞাপন — Facebook · Instagram · Meta Ads
  ANALYTICS // মাপা — Meta Pixel · GA4 · Google Ads · GTM · TikTok
}

/// একটা সেবার চাবি ও অবস্থা।
///
/// ঘরগুলো নাম ধরে রাখা হয়েছে (`clientId`, `apiKey`…), `secret1`/`secret2`
/// নয় — ছ'মাস পরে `secret2`-এ কী ছিল কেউ মনে রাখে না। কোন সেবা কোন ঘর ব্যবহার
/// করে সেটা কোডের manifest-এ লেখা, আর পর্দা সেখান থেকেই লেবেল নেয়।
///
/// ⚠️ চাবির মান **কখনো পুরো ফেরত পাঠানো হয় না** — পর্দায় শুধু শেষ চারটে অক্ষর
/// (`••••3f8a`)। response-এ চাবি মানে browser cache-এ, স্ক্রিনশটে আর log-এ চাবি।
model Integration {
  id       String          @id @default(cuid())
  kind     IntegrationKind
  /// "SSLCOMMERZ" · "BKASH" · "PATHAO" — manifest-এর চাবি, কখনো বদলাবে না
  provider String
  label    String

  /// বন্ধ থাকলে কোড এটা ব্যবহারই করবে না, চাবি বসানো থাকলেও
  isEnabled Boolean @default(false)
  /// ⚠️ false = sandbox (নকল টাকা), true = live (আসল টাকা)। আলাদা ঘর, কারণ
  /// sandbox-এর চাবি দিয়ে live-এ চালানো মানে গ্রাহকের টাকা হারিয়ে যাওয়া।
  isLive    Boolean @default(false)

  /* ---- চাবি ---- */
  clientId      String? @db.Text // SSLCommerz store id · bKash app key · pixel ID · ad account
  clientSecret  String? @db.Text // store password · app secret · client secret
  username      String? @db.Text
  password      String? @db.Text
  apiKey        String? @db.Text // Steadfast api key · RedX token · CAPI token · ads token
  baseUrl       String? @db.Text
  webhookSecret String? @db.Text

  /// একই সেবার ভেতরে কোন সরবরাহকারী — email-এ BREVO নাকি RESEND, SMS-এ কোনটা,
  /// Meta Ads-এ কোন মুদ্রা। manifest বলে দেয় কোন সেবায় এটা লাগে।
  variant String?

  /// COURIER-এর জন্য — Delivery-র `CourierService` সারির সাথে নরম যোগ।
  /// নাম ও tracking URL ওখানেই থাকে; এখানে শুধু চাবি। দুটো আলাদা জিনিস:
  /// courier-টা আমরা ব্যবহার করি (Delivery), আর তার API-তে ঢোকার চাবি (এটা)।
  courierId String?

  note String?

  /* ---- শেষ কবে পরীক্ষা করা হয়েছে ---- */
  /// একটা চাবি বসানো আছে মানে সেটা কাজ করে না। এই দুটো ঘর ছাড়া "চালু" আর
  /// "চালু বলে ধরে নেওয়া" এক দেখায়।
  lastCheckedAt DateTime?
  lastCheckOk   Boolean?
  lastCheckNote String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// এক সেবার দুটো সারি থাকতে পারবে না — নইলে কোনটা আসল সেই প্রশ্ন ফিরে আসে
  @@unique([kind, provider])
  @@index([kind])
}

enum AuthTokenKind {
  INVITE // মালিক ইমেইল দিয়ে ডাকলেন — মানুষটা নিজে পাসওয়ার্ড বসাবে
  RESET // "পাসওয়ার্ড ভুলে গেছি"
}

/// ইমেইলে পাঠানো এককালীন লিংক।
///
/// তিনটে জিনিস ইচ্ছে করে এভাবে:
///   ১. tokenHash — আসল token কখনো ডেটাবেসে বসে না। ব্যাকআপ ফাঁস হলেও
///      কারও অ্যাকাউন্ট খোলা যাবে না।
///   ২. usedAt — একবারই চলে। ইমেইল ফরওয়ার্ড হলে দ্বিতীয়বার কাজ করবে না।
///   ৩. expiresAt — INVITE ৭ দিন, RESET ১ ঘণ্টা।
///
/// ⚠️ PIN এই পথে রিসেট হয় না। ইমেইল হাতে পেলেই টাকার কাজের ক্ষমতা পাওয়া
/// যাবে — সেটা হতে দেওয়া যায় না। PIN রিসেট শুধু OWNER, পর্দা থেকে (ADM-RULE-006)।
model AuthToken {
  id        String        @id @default(cuid())
  kind      AuthTokenKind
  userId    String
  user      AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
}

// ============================================================================
//  EMPLOYEE / HR  —  RADIAN_HR_MODULE_ARCHITECTURE.md (28 Jul 2026)
//
//  Why this module exists: Finance has been paying salary (5420) and handing
//  out advances (1210) against a TYPED NAME. "Rakib", "rakib" and "Rakib Hasan"
//  were three different people to the system, so nobody could say what anyone
//  actually owed. This module turns that string into a real person.
//
//  Six decisions locked with the owner before a line of this was written:
//    HR-D01  Employee ≠ AppUser. Separate tables, optional link.
//    HR-D02  Rider stays in Delivery, untouched, unlinked. A hired rider is
//            just an ordinary Employee.
//    HR-D03  Three pay types: MONTHLY, DAILY, HOURLY. One rate each.
//    HR-D04  Daily attendance for everyone; the sheet defaults to present.
//    HR-D05  Bonus/allowance = a free amount on the payslip. Leave is marked,
//            never counted into an entitlement balance. No PF, no gratuity.
//    HR-D06  No salary and no advance without picking a real Employee. The
//            free-text name field in Finance is gone, so the duplicate-name
//            problem cannot be created any more.
// ============================================================================

enum PayType {
  MONTHLY // a fixed figure every month, whatever the days (HR-D03)
  DAILY // festival helpers — days worked x rate
  HOURLY // part-timers — minutes worked x rate
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE // left / resigned — hidden from pickers, history kept (HR-R02)
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  LEAVE // paid or unpaid — see isPaidLeave (HR-D05: marked, never counted)
  ABSENT
}

enum PayrollStatus {
  DRAFT // freely editable, nothing in the ledger yet
  APPROVED // posted to Finance — frozen from here (HR-R08)
  CANCELLED // abandoned draft; an approved run is reversed in Finance, not here
}

/// The person. Master Data — Sales/Finance/Delivery reference it, none of them
/// own it. Personal columns (nid, dateOfBirth, address, emergency*) are stripped
/// out of API responses for MANAGER; only OWNER sees them (HR-R10).
model Employee {
  id String @id @default(cuid())

  /// HR-R09 — sequential and human-readable, same shape as SUP-/EXP- (EMP-000001)
  employeeNo String @unique

  name          String // the only required field besides joinedOn
  phone         String?
  altPhone      String?
  nid           String? // OWNER-only
  dateOfBirth   DateTime? // OWNER-only
  address       String? // OWNER-only
  photoUrl      String? @db.Text // data URL interim, same as Item.imageUrl / Rider.photoUrl
  emergencyName String? // OWNER-only
  emergencyPhone String? // OWNER-only

  /// HR-D10 (28 Jul, owner: "where do I create a role from?") — free text was the
  /// wrong call. Roles are now a real admin-managed master, like SupplierType:
  /// you add "Florist" once and pick it everywhere after that.
  roleId String?
  role   EmployeeRole? @relation(fields: [roleId], references: [id])

  joinedOn DateTime
  leftOn   DateTime?
  status   EmployeeStatus @default(ACTIVE)

  payType PayType @default(MONTHLY)
  /// meaning follows payType: per month / per day / per hour. Paisa, like all money.
  ratePaisa Int     @default(0)

  /// HR-D12 (28 Jul, owner: "one person's duty is 8 hours, another's is 12 —
  /// how do I read 'half day' without a time?"). This is what a FULL day means
  /// for THIS person. Half day = half of it. Present, with nothing typed = this.
  /// It is the reference every hour on the day sheet is read against; without it
  /// "half day" is a word, not a quantity.
  dutyHoursPerDay Float @default(8)

  /// HR-D13 — their usual shift, "09:00" / "21:00". Optional: casual helpers
  /// have no fixed hours. When set, the day sheet arrives with these already in
  /// the in/out boxes, so a normal day still needs no typing. Kept as plain
  /// HH:MM text because that is exactly what an <input type="time"> speaks, and
  /// a shift has no timezone of its own.
  shiftStart String?
  shiftEnd   String?

  /// HR-D01 — optional. Most staff never sign in. Unique: one login belongs to
  /// at most one person.
  appUserId String?  @unique
  appUser   AppUser? @relation(fields: [appUserId], references: [id])

  note String? @db.Text

  attendance   Attendance[]
  payrollLines PayrollLine[]
  documents    EmployeeDocument[]
  /// HR-D06 — every salary/advance ledger line now points here
  journalLines JournalLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete only (HR-R02)

  @@index([status])
  @@index([name])
  @@index([payType])
  @@index([roleId])
}

/// HR-D10 — admin-managed job roles ("Florist", "Delivery boy", "Manager").
/// A master rather than free text because the owner asked to create them once
/// and pick them after, and because a typo-made second "Florist" quietly splits
/// every per-role report. Seeded with a few sensible rows on first read.
model EmployeeRole {
  id        String  @id @default(cuid())
  name      String  @unique
  note      String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  employees Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// HR-D11 (28 Jul, owner: "one employee can have many documents") — NID copy,
/// signed contract, certificates, photos of paperwork.
///
/// The file is kept as a data URL in a Text column, exactly like Item.imageUrl,
/// Supplier.photoUrl and Rider.photoUrl. That is the interim pattern across this
/// whole codebase; when a real object store arrives, every one of them moves at
/// once. Size is capped in the service so the database does not turn into a
/// filing cabinet.
model EmployeeDocument {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title    String // "NID", "Contract", "Certificate"
  fileName String?
  mimeType String?
  sizeBytes Int    @default(0)
  dataUrl  String  @db.Text

  note       String?
  uploadedBy String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — a removed contract is still a fact

  @@index([employeeId])
}

/// One row per person per day (HR-D04). Never deleted — a day is corrected by
/// changing its status, so this table carries no deletedAt and sits in
/// NO_SOFT_DELETE (same reasoning as InventoryStock: editable derived state).
/// @@unique makes the day sheet a safe upsert.
model Attendance {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  onDate DateTime         @db.Date
  status AttendanceStatus @default(PRESENT)

  /// only meaningful when status = LEAVE. Paid leave still earns a DAILY day.
  isPaidLeave Boolean @default(true)

  /// HR-D13 — when they actually came in and left, "09:05" / "18:30".
  /// Optional: on a quiet day the owner may just leave the row alone. When both
  /// are filled the hours below are worked out from them, so nobody has to do
  /// the subtraction. An out-time earlier than the in-time means the shift
  /// crossed midnight — which happens here, Radian delivers at midnight.
  inTime  String?
  outTime String?

  /// Hours actually worked, in whole minutes so no float ever reaches money.
  /// 7.5 hours = 450.
  ///
  /// HR-D12 — recorded for EVERYONE now, not only hourly staff. Without it the
  /// sheet could not say what "half day" meant, and a monthly person who worked
  /// twelve hours on Valentine's Day left no trace. It only drives money for
  /// HOURLY (minutes / 60 x rate); for the others it is the record.
  ///
  /// Where it comes from, in order: what was typed in the hours box → the gap
  /// between inTime and outTime → the person's own dutyHoursPerDay. It stays
  /// editable on top of the clock, because an hour of it may have been lunch.
  minutes Int @default(0)

  note      String?
  markedBy  String? // session name, written by the server (never a typed field)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, onDate])
  @@index([onDate])
}

/// A payroll RUN — one month, one screen, one approval. Not unique per period
/// on purpose: a festival batch of daily helpers is often settled separately
/// from the monthly staff. The approve step warns when the period already has
/// an approved run rather than blocking it (HR-R06).
model Payroll {
  id        String @id @default(cuid())
  payrollNo String @unique // PAY-000001

  period      String // "2026-07" — what the payslip says
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  status PayrollStatus @default(DRAFT)

  /// roll-ups of the lines, recomputed on every save (cheap, and it keeps the
  /// list screen free of N+1 aggregation)
  grossPaisa            Int @default(0) // base pay from days/hours/month
  extraPaisa            Int @default(0) // HR-D05 bonus / overtime / incentive
  deductionPaisa        Int @default(0) // fines, unpaid days already netted off
  advanceRecoveredPaisa Int @default(0) // taken back out of 1210
  netPaisa              Int @default(0) // what actually leaves the money account

  /// which money account pays it — resolved at approval, kept for the record
  paidFromId String?

  approvedAt DateTime?
  approvedBy String?
  /// HR-R08 — the ledger entry this run produced. Present = frozen.
  journalEntryId String?

  note String? @db.Text

  lines PayrollLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // only a DRAFT is ever soft-deleted

  @@index([period])
  @@index([status])
}

/// One payslip. Lives and dies with its Payroll (cascade), so no deletedAt —
/// same shape as AssemblyProductionLine, and it is in NO_SOFT_DELETE.
///
/// payType/ratePaisa are SNAPSHOTS (HR-R07): a rise next month must not silently
/// rewrite what last month's payslip said.
model PayrollLine {
  id String @id @default(cuid())

  payrollId String
  payroll   Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  payType   PayType
  ratePaisa Int

  /// pulled from Attendance when the draft is built, then hand-editable.
  /// Float because a half day is real: two half days must make one paid day,
  /// not be lost twice. It is a day count, never money — money stays integer paisa.
  daysWorked    Float @default(0)
  minutesWorked Int   @default(0)
  /// HR-D12 — the unpaid part of the month: absent days, unpaid leave, and the
  /// missing half of every half day. Carried onto the payslip so a MONTHLY
  /// deduction can be worked out in front of the owner instead of guessed at.
  absentDays    Float @default(0)

  basePaisa      Int     @default(0)
  extraPaisa     Int     @default(0)
  extraNote      String?
  deductionPaisa Int     @default(0)
  deductionNote  String?
  /// never automatic — the owner decides how much of the outstanding advance
  /// comes back this month (HR-R05)
  advanceRecoveredPaisa Int @default(0)
  netPaisa              Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollId, employeeId])
  @@index([employeeId])
}

// ============================================================
// MARKETING MODULE — RADIAN_MARKETING_MODULE_ARCHITECTURE.md (28 Jul 2026)
//
// Marketing owns SEVEN tables and no money, no customer, no order.
// It reads Order, Customer, Recipient, RecipientOccasion, Offer,
// OfferRedemption, Expense and the ledger. It writes none of them.
//
// MKT-D01  a Campaign is one occasion, not one advertisement
// MKT-D02  attribution is layered, and the layer is recorded
// MKT-D05  spend stays in Finance; Expense.campaignId is only a tag
// MKT-D08  the entity is Affiliate — "Partner" already means shareholder
// MKT-D10  commission accrues on delivery, is held, then paid
// ============================================================

/// MKT-D01 — one promotional push. "Valentine's Day 2027", not "Facebook ad #2".
/// The platform enum carries the distinction that is actually needed; adding one
/// later is a list entry, not a migration.
model Campaign {
  id         String   @id @default(cuid())
  campaignNo String   @unique // CMP-000001
  name       String
  platform   CampaignPlatform @default(FACEBOOK)
  status     CampaignStatus   @default(PLANNED)

  startDate DateTime
  endDate   DateTime

  /// what the owner INTENDED to spend. Actual spend is never stored here —
  /// it is summed from Expense.campaignId (MKT-RULE-006).
  budgetPaisa Int     @default(0)
  goalNote    String?
  note        String?

  /// COUPON attribution rung 2 — which offers belong to this campaign.
  /// Soft list of Offer ids; Offers module still owns the coupons themselves.
  offerIds String[] @default([])

  /// UTM attribution rung 3 — an order whose utmCampaign matches any of these
  /// belongs here. Stored lowercase.
  utmKeys String[] @default([])

  /// MKT-D20 — Meta's own campaign ids that belong to this one. A single
  /// Radian campaign usually covers several Meta campaigns (three ads for one
  /// occasion), which is exactly why MKT-D01 keeps this side coarse.
  metaCampaignIds String[] @default([])

  attributions OrderAttribution[]
  expenses     Expense[]

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([startDate])
}

enum CampaignPlatform {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  TIKTOK
  YOUTUBE
  INFLUENCER
  PRINT
  EVENT
  PARTNERSHIP
  OTHER
}

enum CampaignStatus {
  PLANNED
  RUNNING
  FINISHED
  ARCHIVED
}

/// MKT-D02 / D04 — Marketing's verdict on where ONE order came from.
/// One row per order at most. `source` records WHICH rung answered, so a report
/// can say how much of its own number it trusts.
model OrderAttribution {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  source AttributionSource @default(UNATTRIBUTED)
  /// what actually matched — the coupon code, the utm value, the ref code.
  /// Kept so a disputed number can be traced back to its evidence.
  evidence String?

  decidedAt DateTime @default(now())
  decidedBy String? // "system" or the staff member who overrode it

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([campaignId])
  @@index([affiliateId])
  @@index([source])
}

/// The five rungs of MKT-D02, in priority order.
enum AttributionSource {
  REF_CODE // 1 — an affiliate link/code was carried
  COUPON // 2 — a campaign coupon was used
  UTM // 3 — the storefront forwarded a utm_campaign
  MANUAL // 4 — a staff member set it by hand
  UNATTRIBUTED // 5 — nobody knows, and the report says so
}

/// MKT-D08 — an outside promoter. INDIVIDUAL = influencer with a link;
/// BUSINESS = wedding hall, hospital, restaurant, corporate account.
/// One table, because commission, hold, clawback and payout are identical —
/// and two tables would mean two paths for cash to leave the shop.
model Affiliate {
  id          String        @id @default(cuid())
  affiliateNo String        @unique // AFF-000001
  type        AffiliateType @default(INDIVIDUAL)
  status      AffiliateStatus @default(ACTIVE)

  name        String
  phone       String // MKT-RULE-015 — self-purchase is matched on this
  email       String?
  contactName String? // BUSINESS — the person to call
  address     String?
  note        String?

  /// MKT-RULE-020 — unique, uppercase. This is the link: /?ref=CODE
  code String @unique

  /// MKT-RULE-011 — basis points. 1000 = 10 %. Snapshotted onto every commission.
  commissionBp Int @default(1000)

  /// where the money goes when they withdraw
  payoutMethod String? // "bKash" / "Nagad" / "Bank"
  payoutNumber String?

  /// soft ref — if this affiliate also happens to be a customer
  customerId String?

  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]
  attributions OrderAttribution[]

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
}

enum AffiliateType {
  INDIVIDUAL
  BUSINESS
}

enum AffiliateStatus {
  ACTIVE
  PAUSED
}

/// MKT-D09 / D10 — what one order earned one affiliate, and where that money is.
/// Accrues on delivery, is held, becomes available, then is paid.
model AffiliateCommission {
  id           String    @id @default(cuid())
  affiliateId  String
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id])
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id])

  /// MKT-D09 — goods after discount. Delivery and VAT excluded.
  basePaisa   Int
  /// rate as it was on the day (FIN-RULE-003 — history is never rewritten)
  rateBp      Int
  amountPaisa Int

  state CommissionState @default(PENDING)
  /// when it stops being PENDING and becomes AVAILABLE
  availableAt DateTime

  payoutId String?
  payout   AffiliatePayout? @relation(fields: [payoutId], references: [id])

  /// MKT-RULE-014 — set when the order came back. If the money had already been
  /// paid the amount stays owed to Radian and nets off the next commission.
  reversedAt   DateTime?
  reversedNote String?
  /// set when an already-paid, later-reversed commission has been clawed back
  /// out of a subsequent payout. Soft ref to AffiliatePayout — outstanding
  /// recoverable = REVERSED + payoutId set + this still null.
  recoveredPayoutId String?

  /// the accrual entry — null means nothing reached the ledger (MKT-RULE-016)
  journalEntryId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([orderId, affiliateId])
  @@index([affiliateId, state])
  @@index([state])
}

enum CommissionState {
  PENDING // earned, still inside the hold window
  AVAILABLE // hold is over, withdrawable
  PAID // gone out through a payout
  REVERSED // the order came back
}

/// One withdrawal. OWNER + PIN, and it refuses unless a real journal entry
/// comes back from postEntry() (MKT-RULE-016 — the HR-R28 lesson).
model AffiliatePayout {
  id          String    @id @default(cuid())
  payoutNo    String    @unique // APO-000001
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  amountPaisa Int
  /// what was recovered from an earlier reversed-but-already-paid commission
  recoveredPaisa Int @default(0)
  netPaisa       Int

  paidFromId String // FinanceAccount id — bKash / Cash / Bank
  method     String?
  reference  String? // bKash txn id
  note       String?

  state PayoutState @default(PAID)

  journalEntryId String?
  commissions    AffiliateCommission[]

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([affiliateId])
}

enum PayoutState {
  PAID
  REVERSED
}

/// MKT-D07 — one contact attempt with one known customer.
/// The occasion list produces these; the WhatsApp button records one.
model Outreach {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// soft ref — whose occasion this was about. NEVER the person contacted
  /// (MKT-RULE-007: the message goes to the buyer, not the recipient).
  recipientId   String?
  occasionType  String? // BIRTHDAY / ANNIVERSARY / CUSTOM
  occasionDate  String? // "MM-DD" as stored on RecipientOccasion
  /// MKT-RULE-008 — one occasion, one contact per year. This is the key.
  occasionYear  Int?

  channel OutreachChannel @default(WHATSAPP)
  purpose OutreachPurpose @default(OCCASION)
  message String?
  note    String?

  /// did an order follow? Filled in when the outcome is checked.
  result        OutreachResult @default(SENT)
  resultOrderId String?

  campaignId String? // soft ref — an outreach may belong to a campaign

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([customerId, recipientId, occasionType, occasionYear])
  @@index([customerId])
  @@index([createdAt])
}

enum OutreachChannel {
  WHATSAPP
  PHONE
  SMS
  EMAIL
}

enum OutreachPurpose {
  OCCASION
  FOLLOW_UP
  CORPORATE
  WIN_BACK
  OTHER
}

enum OutreachResult {
  SENT
  REPLIED
  ORDERED
  NO_ANSWER
  REFUSED
}

/// MKT-RULE-009 — somebody who asked not to be contacted. Its own table so
/// Customer stays untouched: the preference is Marketing's, not Customer's.
model MarketingOptOut {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  reason     String?
  actorName  String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime? // restoring consent = soft delete, so the history stays
}

/// Singleton, "singleton" id pattern (DEC-OFR-004 shape, not PosSetting's slip).
model MarketingSetting {
  id String @id @default("singleton")

  /// MKT-D09 — default rate for a new affiliate. Basis points.
  defaultCommissionBp Int @default(1000)
  /// MKT-D10 — days after delivery before commission may be withdrawn
  holdDays            Int @default(7)
  /// nothing smaller than this may be withdrawn
  minWithdrawPaisa    Int @default(50000)
  /// MKT-RULE-017 — how long a ref code stays attached to a visitor
  refWindowDays       Int @default(30)

  /// MKT-D07 — how many days before an occasion the list surfaces it.
  /// Two nudges by default: a week out, then three days out.
  reminderLeadDays Int[] @default([7, 3])

  /// the message the WhatsApp button pre-fills. The owner's own words.
  /// {customer} {recipient} {occasion} {date} are replaced.
  whatsappTemplate String @default("Assalamu alaikum {customer}, Radian theke bolchi. {recipient}-er {occasion} ashche {date} tarikhe. Ei bar ki phool pathabo? — Radian Flower & Gift Shop")

  // ---- REFERRAL (MKT-D16) --------------------------------------------------
  referralEnabled Boolean @default(true)
  /// what one point is worth. 100 paisa = ৳1 — the owner's rule, and the only
  /// exchange rate a customer can hold in their head without arithmetic.
  pointValuePaisa Int @default(100)
  /// how many points the referrer earns per successful referral.
  /// Deliberately a setting: the owner asked to change it whenever he likes.
  referralPoints  Int @default(200)
  /// what the friend gets on their first order — basis points (1000 = 10 %)
  friendDiscountBp       Int @default(1000)
  /// and a ceiling, so a large first order does not give away the shop
  friendDiscountMaxPaisa Int @default(50000)
  /// the friend's order must be at least this much for the referral to count
  referralMinOrderPaisa  Int @default(0)

  // ---- LOYALTY (MKT-D21) ---------------------------------------------------
  /// OFF until the radianbd.com customers are migrated and their opening
  /// balances are seeded. Switching it on before that means the customer who
  /// has bought forty times starts level with a stranger — the worst possible
  /// first impression of a loyalty scheme, and it cannot be taken back.
  loyaltyEnabled Boolean @default(false)

  /// what a purchase earns, in basis points of (goods − discount).
  /// 100 bp = 1 %, the owner's decision (29 Jul). Deliberately low to start:
  /// a rate is easy to raise and impossible to lower — cutting it reads as a
  /// punishment, raising it reads as a gift.
  earnRateBp Int @default(100)

  /// festival switch. 10000 = ×1 (normal), 20000 = ×2, 30000 = ×3.
  /// Paired with an end date so a Valentine's week double does not quietly
  /// stay on until somebody notices in June.
  earnMultiplierBp Int       @default(10000)
  multiplierUntil  DateTime?

  /// MKT-D21 — the customer must pay at least 80 % from their own pocket, so
  /// points may settle at most this share of (goods − discount).
  /// 2000 bp = 20 %. Nobody ever buys with points alone (the owner's rule).
  redeemMaxBp Int @default(2000)

  /// smallest redemption worth processing — stops the ledger filling with ৳3
  /// entries. There is NO minimum order value: points work on any order.
  minRedeemPoints Int @default(50)

  updatedAt DateTime @updatedAt
}

// ============================================================
// SEO — everything the search engines see, controlled from the panel
//
// SEO-D01  the meta fields live ON the thing they describe (Product,
//          Category, Brand), not in a separate SEO table. One row, one page.
// SEO-D02  site-wide defaults are a singleton, so a blank product still gets
//          a sensible title instead of nothing.
// SEO-D03  a redirect table, because renaming a slug silently kills every
//          link Google already knows — and the move off radianbd.com will
//          change a great many of them at once.
// ============================================================

/// Singleton — the settings that apply to every page unless it says otherwise.
/// "singleton" id pattern (DEC-OFR-004 shape).
model SeoSetting {
  id String @id @default("singleton")

  /// how a page title is built. {page} is replaced.
  /// "{page} | Radian Flower & Gift Shop"
  titleTemplate String @default("{page} | Radian Flower & Gift Shop")
  siteName      String @default("Radian")

  /// used when a page has no description of its own
  defaultMetaDescription String?
  /// the picture that shows when a link is shared on Facebook or WhatsApp
  defaultOgImageUrl      String? @db.Text
  twitterHandle          String?

  /// the verification tags Google Search Console and Bing ask you to paste.
  /// They live here so nobody has to edit the storefront's code to add one.
  googleVerification String?
  bingVerification   String?

  /// extra lines appended to robots.txt — for a staging path, an admin folder
  robotsExtra String? @db.Text
  /// master switch: off puts "Disallow: /" in robots.txt. For a site that is
  /// not ready to be found yet.
  allowIndexing  Boolean @default(true)
  sitemapEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// SEO-D03 — an old address and where it should go now.
///
/// Renaming a product's slug breaks every link to it: Google's index, the
/// customer's bookmark, the WhatsApp message somebody forwarded last month.
/// This is also the only sane way to move off radianbd.com without losing the
/// search rankings that site has built up — every old address gets pointed at
/// its new home instead of showing a 404.
model SeoRedirect {
  id       String  @id @default(cuid())
  /// stored with a leading slash, lowercase, no query string
  fromPath String  @unique
  toPath   String
  /// 301 (permanent, passes the ranking on) vs 302 (temporary)
  permanent Boolean @default(true)
  note      String?

  /// so dead rules can be found and cleared out later
  hits      Int       @default(0)
  lastHitAt DateTime?

  isActive  Boolean   @default(true)
  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
}

/// MKT-D15 — every tracking code in one place, pasted once, never in the code.
///
/// Today these live nowhere: radianbd.com carries a GTM container that only
/// the old platform's admin can reach, and the new storefront carries nothing
/// at all. Putting the ids here means the storefront reads them at run time and
/// a new pixel is a paste, not a deploy.
///
/// HONEST LIMIT, recorded so nobody is surprised: a pixel is only as useful as
/// the events it sees, and the biggest event — Purchase — cannot fire until the
/// storefront actually creates an order. Until then PageView, ViewContent,
/// Search and AddToCart work and Purchase does not.
model TrackingSetting {
  id String @id @default("singleton")

  /// master switch — off means the storefront loads nothing at all
  enabled Boolean @default(true)

  /// Google Tag Manager container: "GTM-XXXXXXX".
  /// If this is set, everything else can be managed inside GTM instead — but
  /// the separate ids are still honoured, because one paste here is simpler
  /// than learning GTM for a single pixel.
  gtmId String?

  metaPixelId       String?
  ga4MeasurementId  String? // "G-XXXXXXXXXX"
  googleAdsId       String? // "AW-XXXXXXXXX"
  googleAdsConversionLabel String?
  tiktokPixelId     String?
  snapPixelId       String?
  pinterestTagId    String?
  clarityId         String? // Microsoft Clarity — free session recording

  /// Meta Conversions API — server-side, so ad blockers and iPhones cannot
  /// silently eat the event, and phone/walk-in/foodpanda orders can be sent
  /// too. Needs a dataset id and a token from Meta Business Manager.
  capiDatasetId    String?
  capiAccessToken  String? @db.Text
  capiEnabled      Boolean @default(false)

  /// send events but mark them as tests, so a trial run does not pollute the
  /// real numbers while somebody is checking the wiring
  testMode Boolean @default(false)

  /// MKT-D20 — reading the ad account, which is the opposite direction to
  /// CAPI above: that one SENDS events to Meta, this one READS what the ads
  /// cost. Different permission (ads_read), so a separate token.
  adAccountId     String? // act_XXXXXXXXXX
  adsAccessToken  String? @db.Text
  adsEnabled      Boolean @default(false)
  /// what the ad account bills in — USD for most Bangladeshi accounts.
  /// Stored because it decides whether a spend figure can be trusted as taka.
  adsCurrency     String? @default("USD")

  updatedAt DateTime @updatedAt
}


// ============================================================
// REFERRAL & POINTS — MKT-D16
//
// The owner's rule, 28 Jul 2026: "je bondhu anbe tar account a point joma
// hobe, ar jake anbe se discount pabe" — and the points arrive as soon as the
// friend's order is CONFIRMED, not when it is delivered.
//
// MKT-D16  ONE points ledger, shared with Loyalty when that arrives.
//          Two separate point systems would give a customer two balances that
//          never agree, and that mistake cannot be undone later.
// MKT-D17  points are a LIABILITY. A point is a promise to give away ৳1 of
//          future revenue, so awarding one is an expense the day it is given,
//          not the day it is spent (2130 / 5452).
// ============================================================

/// The one points ledger. APPEND-ONLY: a correction is another row with a
/// negative delta, never an edit or a delete — the same discipline as the
/// journal. A balance is the sum of the rows, never a stored number
/// (FIN-RULE-008 applied to points).
model LoyaltyPoint {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// + earned, − spent or taken back
  deltaPoints Int
  reason      PointReason

  /// what caused it — 'REFERRAL' + referral id, 'ORDER' + order id, and so on
  refType String?
  refId   String?
  note    String?

  /// the ledger entry that recorded the liability, if there was one
  journalEntryId String?

  actorName String?
  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([reason])
}

enum PointReason {
  REFERRAL // a friend was brought in and ordered
  REFERRAL_REVERSED // …and that order was cancelled
  PURCHASE // MKT-D21 — earned on a delivered order
  PURCHASE_REVERSED // …and that order was cancelled or wholly returned
  OPENING // seeded from the radianbd.com history at migration
  REDEEMED // spent against an order, inside the 20 % cap (MKT-D21)
  ADJUSTMENT // the owner corrected something, audited
  EXPIRED // if an expiry policy is ever set
}

/// One code per customer. Made on demand — most customers never ask for one,
/// so there is no point creating five thousand codes nobody will use.
model ReferralCode {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  /// uppercase, unique across the shop
  code       String   @unique
  uses       Int      @default(0)
  createdAt  DateTime @default(now())
}

/// One row per person actually brought in.
model Referral {
  id         String @id @default(cuid())
  referralNo String @unique // REF-000001

  referrerId String
  referrer   Customer @relation("ReferralsMade", fields: [referrerId], references: [id])

  /// a person can be referred once, by one person, ever
  friendId String   @unique
  friend   Customer @relation("ReferralReceived", fields: [friendId], references: [id])

  /// the friend's qualifying order
  orderId String?

  state         ReferralState @default(JOINED)
  pointsAwarded Int           @default(0)
  /// what the friend actually saved, for the report
  friendDiscountPaisa Int @default(0)

  rewardedAt   DateTime?
  reversedAt   DateTime?
  reversedNote String?

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([referrerId])
  @@index([state])
}

enum ReferralState {
  JOINED // the friend signed up with the code, nothing earned yet
  REWARDED // their order was confirmed and the points went in
  REVERSED // that order was cancelled, and the points came back out
}

// ============================================================
// CONTENT / CMS — CMS-D01
//
// The storefront's about, FAQ, journal and policy pages are hand-written
// TypeScript files today, each carrying a "⇄ SWAP HERE — CMS এলে fetch() হবে"
// note left by whoever built them. This is that swap.
//
// It is not decoration. **A shop cannot legally take money without privacy,
// terms, refund and shipping pages**, and SSLCommerz will not approve an
// account without them either. So this sits between here and the storefront
// going live, not after it.
//
// CMS-D01  the body is HTML, written in a toolbar editor. The people writing
//          these are shop staff, and asking them to learn markdown means the
//          pages never get written.
// CMS-D02  a legal page is never deleted, only unpublished. A privacy policy
//          that vanishes takes the record of what was promised with it.
// ============================================================

/// A prose page — privacy, terms, refund, shipping, about, contact.
model ContentPage {
  id    String          @id @default(cuid())
  slug  String          @unique
  title String
  kind  ContentPageKind @default(INFO)

  /// HTML from the editor
  bodyHtml String? @db.Text
  /// one line for a card or a link preview
  excerpt  String?

  isPublished  Boolean @default(false)
  showInFooter Boolean @default(true)
  sortOrder    Int     @default(0)

  // SEO-D01 — same six columns as everything else that has a page
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String? @db.Text
  noIndex         Boolean @default(false)

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([kind])
}

enum ContentPageKind {
  /// CMS-D02 — required before the shop can take money. Never deletable.
  LEGAL
  INFO
}

/// A journal article — the storefront's /journal.
model JournalPost {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  excerpt String?
  coverUrl String? @db.Text
  bodyHtml String? @db.Text
  author   String?

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  /// shown as "4 min read" — worked out from the body, overridable
  readMinutes Int?

  metaTitle       String?
  metaDescription String?
  ogImageUrl      String? @db.Text
  noIndex         Boolean @default(false)

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isPublished, publishedAt])
}

/// One question and its answer. Grouped by a plain name so a new group is
/// typing, not a migration.
model FaqEntry {
  id         String  @id @default(cuid())
  groupName  String  @default("General")
  question   String
  answerHtml String? @db.Text

  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([groupName])
}

// ============================================================
// WHATSAPP — templates and send lists. MKT-D18.
//
// The owner has WhatsApp Business API credentials, or believes he does — and
// "WhatsApp Business app" and "WhatsApp Business API" are routinely confused,
// so that is checked before a line of sending code is written.
//
// Meanwhile this is everything that does NOT need the API:
//   · the messages themselves, written once and reused
//   · a list of who to send to, built from real filters
//   · a queue that opens WhatsApp with the message already written, one
//     customer at a time, and remembers who has been done
//
// That is how a shop this size actually sends. When the API is verified, an
// "send them all" button joins the same screen and the rest is unchanged —
// the templates, the lists and the history are already here.
//
// MKT-D18  a send is still an Outreach row (MKT-D07), so opt-outs, the
//          one-per-occasion rule and the effect report all keep working. A
//          broadcast is a QUEUE over outreach, not a second way to message.
// ============================================================

model WhatsappTemplate {
  id      String  @id @default(cuid())
  name    String
  purpose String  @default("PROMO") // PROMO · OCCASION · FOLLOW_UP · CORPORATE · WIN_BACK · OTHER
  /// {customer} {shop} {last_order} {points} are replaced when it is sent
  body    String  @db.Text

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  /// how many times it has actually been sent, so dead wording is visible
  usageCount Int    @default(0)

  broadcasts Broadcast[]

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// A list of people to send one message to, and how far through it we are.
model Broadcast {
  id   String @id @default(cuid())
  no   String @unique // BC-000001
  name String

  templateId String?
  template   WhatsappTemplate? @relation(fields: [templateId], references: [id])
  /// the message as it was when the list was made — editing the template later
  /// must not rewrite what was already sent (FIN-RULE-003, same principle)
  bodySnapshot String @db.Text

  /// soft ref — a broadcast may belong to a campaign, for the ROI
  campaignId String?
  /// plain English description of who was picked, for the record
  audienceNote String?

  state BroadcastState @default(DRAFT)

  targets BroadcastTarget[]

  actorName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([state])
}

enum BroadcastState {
  DRAFT // the list is built, nothing sent
  SENDING // somebody is working through it
  DONE // everybody has been reached or skipped
}

model BroadcastTarget {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  state  TargetState @default(PENDING)
  sentAt DateTime?
  /// the Outreach row this created — so the effect report counts it
  outreachId String?
  note       String?

  @@unique([broadcastId, customerId])
  @@index([broadcastId, state])
}

enum TargetState {
  PENDING
  SENT
  SKIPPED // opted out, no number, or the staff member moved past them
}

// ============================================================
// EMAIL & SMS — MKT-D19
//
// Both are built the same way and for the same reason: every provider worth
// using speaks plain HTTP, so nothing new has to be installed into the API to
// talk to them. One `fetch`, an API key, done. That matters more than it
// sounds — adding an npm package here means rebuilding the container, and a
// rebuild is the kind of thing that gets postponed for a month.
//
// PROVIDER-AGNOSTIC ON PURPOSE. The owner does not have an account with any of
// these yet. Rather than guess which one he opens, the shape fits all of them:
// pick the provider, paste the key, press Test. If he later switches from one
// SMS gateway to another — which happens constantly in Bangladesh, on price —
// it is a dropdown, not a rewrite.
//
// MKT-D19  every send is logged with what the provider said back. Without that
//          "did the customer get it?" has no answer, and for SMS, where every
//          message costs money, no answer is not good enough.
// ============================================================

model MessagingSetting {
  id String @id @default("singleton")

  /* ---- email ---- */
  emailEnabled  Boolean @default(false)
  /// BREVO · RESEND · SENDGRID · MAILGUN — all HTTP, all one key
  emailProvider String  @default("BREVO")
  emailApiKey   String? @db.Text
  emailFromName String? @default("Radian")
  emailFromAddress String?
  emailReplyTo     String?
  /// Mailgun needs its domain; the others ignore this
  emailDomain      String?

  /* ---- SMS ---- */
  smsEnabled  Boolean @default(false)
  /// BULKSMSBD · MIMSMS · REVE · ALPHA · CUSTOM — Bangladeshi gateways are all
  /// a GET or POST with an api key, so CUSTOM covers whatever comes next
  smsProvider String  @default("BULKSMSBD")
  smsApiKey   String? @db.Text
  smsSenderId String?
  /// CUSTOM only — the whole endpoint, with {api_key} {sender} {to} {text}
  /// replaced at send time
  smsCustomUrl String? @db.Text

  /// where a test goes, so nobody has to type it every time
  testEmail String?
  testPhone String?

  updatedAt DateTime @updatedAt
}

/// MKT-D19 — one row per message actually handed to a provider, and what the
/// provider said. Append-only: this is evidence, not state.
model MessageLog {
  id      String         @id @default(cuid())
  channel MessageChannel
  /// email address or phone number
  toAddress String
  subject   String?
  body      String  @db.Text

  status   MessageStatus @default(SENT)
  /// the provider's own id for the message, for chasing it up later
  providerRef String?
  /// what came back when it failed — kept in full, because a truncated error
  /// is the reason support tickets take three days
  error       String? @db.Text
  provider    String?

  /// what this send belongs to, if anything
  outreachId  String?
  customerId  String?
  broadcastId String?
  isTest      Boolean @default(false)

  actorName String?
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  @@index([customerId])
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageStatus {
  SENT
  FAILED
}


/// MKT-D20 — one row per Meta campaign per day, kept locally.
///
/// Cached rather than fetched live, for two reasons: the screen stays fast,
/// and Meta rate-limits an ad account hard enough that a busy afternoon would
/// start returning errors instead of numbers.
///
/// ⚠️ THIS IS NOT THE MONEY. Meta reports what it billed in the ad account's
/// currency; the bank charges something else once conversion and fees land.
/// Both are true and they never match. Finance owns the taka (MKT-D05) — this
/// only offers to pre-fill an expense that a person then confirms.
model AdInsight {
  id String @id @default(cuid())

  platform String @default("META")
  /// the ad account this came from, so switching accounts does not mix figures
  accountId String

  externalCampaignId   String
  externalCampaignName String?

  /// the day these numbers are for — Meta's own day boundary, not ours
  onDate DateTime

  /// as reported, in the ad account's currency, in the smallest unit
  spendMinor  Int    @default(0)
  currency    String @default("USD")
  impressions Int    @default(0)
  clicks      Int    @default(0)
  reach       Int    @default(0)

  fetchedAt DateTime @default(now())

  @@unique([platform, accountId, externalCampaignId, onDate])
  @@index([onDate])
}

// ============================================================
// INTELLIGENCE — RADIAN_INTELLIGENCE_MODULE_ARCHITECTURE.md (29 Jul 2026)
//
// Intelligence owns EXACTLY these three tables and no business data at all.
// Every figure it shows is asked of the module that owns it (INT-R01).
//
//   DailySnapshot      a CACHE of closed days, so six months of history is not
//                      recomputed on every page load (DEC-INT-002). It is never
//                      a source: if a row disagrees with Finance, Finance wins
//                      and the row is rebuilt (INT-R02).
//   KpiTarget          a management goal, not a business transaction. Nothing
//                      downstream reads it (DEC-INT-007).
//   IntelligenceSetting  singleton — RAG bands and the demo→real threshold.
// ============================================================

/// One row per CLOSED day (INT-R07 — today is never snapshotted).
/// Every figure here was computed by its owning service for that day's range
/// and copied. Nothing in this table is calculated by Intelligence.
/// No deletedAt — a cache row is rebuilt, never soft-deleted (NO_SOFT_DELETE).
model DailySnapshot {
  id String @id @default(cuid())

  /// the day these figures are for, at 00:00 Asia/Dhaka
  onDate DateTime @unique

  // ---- money — all from FinanceReportsService.profitAndLoss(day, day) ----
  revenuePaisa     Int @default(0)
  cogsPaisa        Int @default(0)
  grossProfitPaisa Int @default(0)
  /// basis points — 4600 = 46 %
  grossMarginBp    Int @default(0)

  // ---- sales — counted from Order, which no other module summarises daily ----
  ordersCount        Int @default(0)
  avgOrderValuePaisa Int @default(0)
  newCustomers       Int @default(0)

  // ---- delivery (DEC-INT-003) ----
  deliveredCount Int @default(0)
  onTimeCount    Int @default(0)
  /// how many of deliveredCount could actually be judged — an order with no
  /// promisedBy is NOT counted as late, it is counted as unmeasurable (INT-R09)
  measurableDeliveries Int @default(0)

  // ---- position at day end ----
  inventoryValuePaisa Int @default(0)
  cashBalancePaisa    Int @default(0)

  computedAt DateTime @default(now())

  @@index([onDate])
}

/// What "good" is, for one month. OWNER only (DEC-INT-005).
/// A month with no row shows the figure with NO colour — never green (INT-R12).
model KpiTarget {
  id String @id @default(cuid())

  year  Int
  month Int // 1–12
  kpi   KpiName

  /// paisa for MONTHLY_SALES; basis points for GROSS_MARGIN and ON_TIME_DELIVERY
  targetValue Int
  note        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([year, month, kpi])
  @@index([year, month])
}

enum KpiName {
  MONTHLY_SALES
  GROSS_MARGIN
  ON_TIME_DELIVERY
}

/// Singleton. ⚠️ No deletedAt — MUST be listed in NO_SOFT_DELETE, or every
/// call 500s on a column that does not exist (kickoff §4-চ; caught five times).
model IntelligenceSetting {
  id String @id @default("singleton")

  /// at or above this share of target = green. 9000 = 90 %.
  amberAtBp Int @default(9000)
  /// below this = red. Between the two = amber.
  redBelowBp Int @default(7500)

  /// DEC-INT-006 condition 3 — the demo→real switch is automatic. When
  /// DailySnapshot holds this many days the forecast stops being demo and
  /// nobody has to remember to change anything. 365 = one full seasonal year,
  /// which for a flower shop is the only length that has seen every peak.
  forecastMinDays Int @default(365)

  /// how far back the nightly job will fill gaps it finds (INT-R05)
  snapshotBackfillDays Int @default(90)

  updatedAt DateTime @updatedAt
}

// ============================================================================
//  INBOX — RADIAN_INBOX_MODULE_ARCHITECTURE.md (draft 5 Aug 2026)
//
//  সব channel-এর গ্রাহক-কথোপকথন এক inbox-এ (DEC-INB-001…006)। Phase 1 =
//  WEB_CHAT শুধু; Messenger/Instagram/WhatsApp/SMS পরে একই টেবিলে নামবে —
//  connector যোগ হয়, schema বদলায় না।
//
//  One Data One Owner: Customer/Order এখানে কপি হয় না — FK আর read।
// ============================================================================

enum InboxChannel {
  WEB_CHAT
  MESSENGER
  INSTAGRAM
  WHATSAPP
  SMS
}

enum ConversationStatus {
  OPEN
  WAITING_CUSTOMER
  RESOLVED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageAuthor {
  CUSTOMER
  AI
  STAFF
  SYSTEM
}

enum EscalationReason {
  MONEY_TOPIC // DEC-INB-001 — টাকার প্রসঙ্গ AI কখনো নিজে সামলায় না
  LOW_CONFIDENCE
  CUSTOMER_ASKED_HUMAN
  ANGRY_CUSTOMER
  OFF_SCRIPT
  MANUAL
}

/// এক গ্রাহকের এক channel-এর এক thread (INB-RULE-006)।
model Conversation {
  id      String             @id @default(cuid())
  channel InboxChannel       @default(WEB_CHAT)
  status  ConversationStatus @default(OPEN)

  /// INB-RULE-007 — ফোন/ইমেইল মিললে FK বসে; গ্রাহকের তথ্য কপি হয় না।
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// DEC-INB-006 — guest পরিচয়। skip করলে দুটোই null, chat তবু চলে।
  guestName  String?
  guestPhone String?

  /// WEB_CHAT-এর ব্রাউজার-secret: এই key যার হাতে, thread টা তার।
  /// অন্য channel-এ external identity (PSID/ফোন) এই কাজটা করে।
  clientKey String @unique @default(cuid())

  /// অন্য channel-এর নিজের পরিচয় (Messenger PSID, WhatsApp নম্বর) — Phase 3.
  externalIdentity String?

  /// DEC-INB-004 — staff লিখলেই false; আবার চালু per-thread, হাতে।
  aiEnabled Boolean @default(true)

  assigneeId String?
  assignee   AppUser? @relation("ConversationAssignee", fields: [assigneeId], references: [id])

  lastMessageAt  DateTime  @default(now())
  escalatedAt    DateTime?
  /// staff-এর unread গোনা — badge। staff thread খুললে 0।
  unreadForStaff Int       @default(0)

  messages    Message[]
  escalations EscalationEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, lastMessageAt])
  @@index([customerId])
  @@index([guestPhone])
  @@index([channel, externalIdentity])
}

/// এক কথোপকথনের এক বার্তা — যেদিকেই যাক।
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  direction  MessageDirection
  authorType MessageAuthor
  /// authorType=STAFF হলে কে — audit-এর অর্ধেক এখানেই।
  authorUserId String?
  authorUser   AppUser? @relation("MessageAuthor", fields: [authorUserId], references: [id])

  body String

  /// channel-এর নিজের message id — webhook duplicate ঠেকায় (Phase 3)।
  externalMessageId String? @unique

  /// authorType=AI হলে: confidence, ব্যবহৃত tool, escalation কারণ (Phase 2)।
  aiMeta Json?

  readByStaffAt DateTime?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([conversationId, createdAt])
}

/// AI (বা নিয়ম) মানুষ ডেকেছে — এমন প্রতিটা মুহূর্তের স্থায়ী রেকর্ড।
/// Append-only log (AuditLog-এর মতো) — deletedAt নেই, ইচ্ছাকৃত: রিপোর্টের
/// "AI কোথায় আটকায়" প্রশ্নের উত্তর এই ইতিহাসেই।
model EscalationEvent {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  reason EscalationReason

  /// কাদের খবর দেওয়া হলো — AppUser id-র তালিকা (INB-RULE-005)।
  notifiedUserIds Json @default("[]")

  acknowledgedById String?
  acknowledgedBy   AppUser?  @relation("EscalationAck", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

/// Singleton। ⚠️ deletedAt নেই — IntelligenceSetting-এর মতোই; soft-delete
/// extension এখন DERIVED বলে আলাদা তালিকায় নাম লেখাতে হয় না।
model InboxSetting {
  id String @id @default("singleton")

  /// Phase 2-র kill-switch। Phase 1-এ AI নেই, তাই false-ই সত্যি।
  aiGloballyEnabled Boolean @default(false)
  /// DEC-INB-004 — নতুন thread-এ AI-র প্রাথমিক অবস্থা।
  aiDefaultForNew   Boolean @default(true)

  /// মালিকের রায় (৫ আগস্ট): দুই provider-এর জন্য বানানো, আপাতত Anthropic।
  /// "ANTHROPIC" | "OPENAI" — key env-এ (ANTHROPIC_API_KEY / OPENAI_API_KEY),
  /// DB-তে কখনো নয়।
  aiProvider String @default("ANTHROPIC")
  aiModel    String @default("claude-haiku-4-5-20251001")

  /// DEC-INB-003 — escalation কার কাছে যায়; খালি = সব OWNER (INB-RULE-005)।
  escalationAssigneeIds Json @default("[]")

  /// INB-RULE-008 — মিনিটে, মধ্যরাত থেকে। 540=9:00, 1320=22:00।
  supportOpenMin  Int    @default(540)
  supportCloseMin Int    @default(1320)
  offHoursMessage String @default("We are closed right now — we will reply in the morning, usually by 9 AM.")

  /// INB-RULE-006 — এত দিনের পুরনো RESOLVED thread নতুন করে খোলে না।
  reopenWindowDays Int @default(30)

  /// DEC-INB-008 rev (৫ আগস্ট) — উপস্থিতি-ভিত্তিক জানালা, সেকেন্ডে।
  /// Staff inbox-এ ACTIVE থাকলে AI এই ক'সেকেন্ড তাকে আগে সুযোগ দেয়;
  /// কেউ active না থাকলে AI সাথে সাথে উত্তর দেয় — গ্রাহক অপেক্ষা করে না।
  staffGraceSec Int @default(30)

  webChatEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}
