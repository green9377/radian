# ======================================================================
#  LIVE - the real shop. Real customers, real money, real books.
# ======================================================================
#
#  Lives at /root/apps/radian-live on the VPS, branch `production`.
#
#    cp .env.live.example .env.live
#    chmod 600 .env.live
#    docker compose -f docker-compose.stack.yml --env-file .env.live up -d --build
#
#  ⛔ .env.live never goes into git. This .example carries placeholders and
#     never a real value.
#
#  ⚠️ Nothing here is copied from development. Different database, different
#     secrets, different payment keys. A shared value between the two is how
#     a test order ends up in the real books.
# ======================================================================


# ----------------------------------------------------------------------
#  Which stack this is
# ----------------------------------------------------------------------
STACK=live
ENV_FILE=.env.live

# The database volume, named outright so a wrong name fails loudly instead
# of quietly starting an empty shop. Create it once:
#   docker volume create radian_live_pg
PG_VOLUME=radian_live_pg

# Cores this stack may use. The live shop gets all four; development is
# held at two so a rebuild or a load test there cannot starve a checkout.
CPU_LIMIT=4


# ----------------------------------------------------------------------
#  Database (compose creates the container)
# ----------------------------------------------------------------------
POSTGRES_USER=radian_live
POSTGRES_PASSWORD=<a NEW password, not development's>
POSTGRES_DB=radian_live

# The API reaches the database over the stack's private network. `postgres`
# is the service name; this address does not exist from the internet.
DATABASE_URL=postgresql://radian_live:<same password>@postgres:5432/radian_live
DIRECT_URL=postgresql://radian_live:<same password>@postgres:5432/radian_live


# ----------------------------------------------------------------------
#  API
# ----------------------------------------------------------------------
NODE_ENV=production
JWT_SECRET=<a NEW secret, not development's>
JWT_REFRESH_EXPIRY_DAYS=30
API_INTERNAL_URL=http://api:4000
ANTHROPIC_API_KEY=


# ----------------------------------------------------------------------
#  Domains
#
#  Every name needs its own A record at the VPS, DNS-only (grey cloud). An
#  orange/proxied record stops Let's Encrypt from issuing.
#
#  ⚠️ AT CUTOVER: radianbd.com is added to the Caddyfile's live web block
#  and PUBLIC_WEB_URL becomes https://radianbd.com. NEXT_PUBLIC_* is baked
#  in at build time, so web and admin must be REBUILT that day, not just
#  restarted.
# ----------------------------------------------------------------------
WEB_DOMAIN=live.radianbd.com
ADMIN_DOMAIN=admin.live.radianbd.com
API_DOMAIN=api.live.radianbd.com
MEDIA_DOMAIN=media.live.radianbd.com

PUBLIC_WEB_URL=https://live.radianbd.com
PUBLIC_ADMIN_URL=https://admin.live.radianbd.com
PUBLIC_API_URL=https://api.live.radianbd.com


# ----------------------------------------------------------------------
#  Images - written to this stack's own ./media folder, served by the edge
# ----------------------------------------------------------------------
MEDIA_DIR=/media
NEXT_PUBLIC_IMAGE_BASE=https://media.live.radianbd.com


# ----------------------------------------------------------------------
#  Payment - this is where the real money is
# ----------------------------------------------------------------------
#  ⚠️ Before SSLCOMMERZ_IS_LIVE=true, both values must belong to a real
#  merchant account. Left blank with true, the API refuses to start - on
#  purpose. An open shop that cannot take money is better than one quietly
#  taking money that never arrives.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false


# ----------------------------------------------------------------------
#  WhatsApp / Email
#  These have never been set anywhere. Until they are, order confirmations
#  and the messaging channels are silently off - no error, nothing sent.
# ----------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=

# Coexistence - one number on the phone AND on the API (DEC-WA-009). Only
# the "Connect phone" button in Integrations needs these; without them the
# button says so and nothing else breaks. The app secret is deliberately
# not here: it already lives on the Integrations screen, and one secret
# with two homes is how they drift apart.
META_APP_ID=
META_ES_CONFIG_ID=

# ----------------------------------------------------------------------
#  Outbound guard - LEAVE THESE EMPTY ON THE LIVE SHOP
#
#  Empty allowlist means no restriction and 0 means no hourly ceiling, so the
#  live shop behaves exactly as it did before the guard existed. They are
#  listed here only so that nobody wonders whether they were forgotten.
#
#  ⚠️ THIS DEPENDS ON `STACK=live` ABOVE. An empty allowlist means "everyone"
#  only on the live stack; anywhere else it means nobody. If STACK is lost the
#  shop goes quiet and somebody notices in minutes - which is the safe
#  direction for that mistake to fail in.
#
#  The kill switch is the one worth knowing about: it stops every outgoing
#  message at once, from the admin, without a deploy.
# ----------------------------------------------------------------------
OUTBOUND_DISABLED=false
OUTBOUND_ALLOWLIST=
OUTBOUND_MAX_PER_HOUR=0
OUTBOUND_REDIRECT_TO=

# Live orders keep RAD. Development uses DEV so the two can never be confused
# in an SSLCommerz settlement report.
ORDER_NO_PREFIX=RAD

# ⛔ Do not set PORT.
