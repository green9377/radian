# ======================================================================
#  DEMO environment — Neon (DB) + Render (API) + Vercel (admin, web)
# ======================================================================
#
#  এই ফাইলটা কোনো সার্ভারে "চলে" না — এটা একটা **চেকলিস্ট**।
#  নিচের মানগুলো আপনি Render আর Vercel-এর dashboard-এ হাতে বসাবেন।
#
#  ⛔ এই ফাইলে কখনো আসল পাসওয়ার্ড লিখবেন না — এটা GitHub-এ যায়।
#     আসল secret-গুলো আছে `.env.secrets.local` ফাইলে (সেটা git-এ যায় না)।
#
# ======================================================================


# ----------------------------------------------------------------------
#  ১. RENDER → radian-api-demo → Environment
# ----------------------------------------------------------------------

# Neon dashboard → Connection string। শেষে `?sslmode=require` থাকতেই হবে।
# "Pooled connection" নয়, সাধারণটাই নিন — Prisma migration pooler দিয়ে চলে না।
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/radian_demo?sslmode=require

# `.env.secrets.local` থেকে DEMO_JWT_SECRET কপি করুন।
# ⚠️ লোকাল .env-এর secret নয় — demo আলাদা, real আলাদা।
JWT_SECRET=<.env.secrets.local দেখুন>
JWT_REFRESH_EXPIRY_DAYS=30

NODE_ENV=production

# তিনটে ঠিকানা। Deploy-এর ক্রম অনুযায়ী প্রথমে API-রটা পাবেন, পরে দুটো।
# ⚠️ শেষে `/` দেবেন না। `https://` বাদ দেবেন না।
PUBLIC_API_URL=https://radian-api-demo.onrender.com
PUBLIC_WEB_URL=https://radian-demo.vercel.app
PUBLIC_ADMIN_URL=https://radian-admin-demo.vercel.app
#  ↑ PUBLIC_ADMIN_URL ভুল বা ফাঁকা থাকলে admin খুলবে কিন্তু সব ফাঁকা দেখাবে
#    (browser console-এ CORS error)। main.ts এই তিনটে থেকেই allowlist বানায়।

# ছবি
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGE_BASE=https://ik.imagekit.io/your_id

# পেমেন্ট — demo-তে সবসময় sandbox।
# দুটো ফাঁকা রাখলে SSLCommerz-এর public sandbox (testbox/qwerty) ব্যবহার হয়:
# আসল gateway, নকল টাকা। ডেমোর জন্য এটাই চাই।
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# WhatsApp / Resend — মালিক পরে বসাবেন। ফাঁকা থাকলে শুধু ওই ফিচারগুলো
# চুপ থাকবে, বাকি দোকান স্বাভাবিক চলবে।
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=

# ⛔ PORT এখানে **নেই এবং দেবেন না** — Render নিজে দেয়। হাতে দিলে
#    "Application failed to respond"।


# ----------------------------------------------------------------------
#  ২. VERCEL → radian-admin-demo → Settings → Environment Variables
# ----------------------------------------------------------------------
# একটাই লাগে:
#   NEXT_PUBLIC_API_URL = https://radian-api-demo.onrender.com


# ----------------------------------------------------------------------
#  ৩. VERCEL → radian-web-demo → Settings → Environment Variables
# ----------------------------------------------------------------------
#   NEXT_PUBLIC_API_URL    = https://radian-api-demo.onrender.com
#   NEXT_PUBLIC_SITE_URL   = https://radian-demo.vercel.app
#   NEXT_PUBLIC_IMAGE_BASE = https://ik.imagekit.io/your_id
#   API_INTERNAL_URL       = https://radian-api-demo.onrender.com
#
# ⚠️ `NEXT_PUBLIC_` দিয়ে শুরু হওয়া variable **build-এর সময়** কোডে ঢুকে যায়।
#    Deploy হয়ে যাওয়ার পরে বদলালে কিছুই হবে না — **Redeploy** করতে হবে।
